    m_Localized: "\u05E1\u05E4\u05D9\u05E0\u05EA \u05D4\u05DE\u05E2\u05E8\u05DB\u05D4 \u05E9\u05DC \u05D4\u05E9\u05D5\u05D3\u05D3\u05D9\u05DD \u05E9\u05D5\u05DE\u05E8\u05EA \u05E2\u05DC \u05DC\u05D1 \u05D4\u05E8\u05D9\u05E7. \u05E9\u05D9\u05DE\u05D5 \u05DC\u05D6\u05D4 \u05E1\u05D5\u05E3."
