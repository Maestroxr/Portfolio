    m_Localized: "\u05EA\u05D5\u05EA\u05D7 \u05D6\u05E7\u05D9\u05E3 - \u05D4\u05D5\u05D0 \u05D6\u05D5\u05D4\u05E8 \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05D5\u05D0 \u05D9\u05D5\u05E8\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010236
    m_Localized: "\u05DE\u05D8\u05D9\u05DC \u05DE\u05D5\u05E7\u05E9\u05D9\u05DD - \u05E2\u05E6\u05E8\u05D5 \u05D0\u05D5\u05EA\u05D5 \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D9\u05DE\u05E7\u05E9 \u05D0\u05EA \u05D4\u05D2\u05D6\u05E8\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010237
    m_Localized: "\u05E8\u05D5\u05D3\u05E3 \u05E4\u05D0\u05D6\u05D4 - \u05D9\u05E8\u05D5 \u05D1\u05D5 \u05DB\u05E9\u05D4\u05D5\u05D0 \u05E0\u05E8\u05D0\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010238
    m_Localized: "\u05E7\u05D5\u05E8\u05E1\u05E8\u05D9\u05DD - \u05D4\u05DD \u05D4\u05D5\u05DC\u05DB\u05D9\u05DD \u05E2\u05DC \u05D4\u05E9\u05D9\u05D9\u05E8\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010239
    m_Localized: "\u05E7\u05D5\u05E8\u05E1\u05E8\u05D9\u05DD \u05D1\u05D3\u05E8\u05DA"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010240
    m_Localized: "\u05D0\u05D5\u05E8 \u05D2\u05D5\u05D5\u05E2"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010241
    m_Localized: "\u05DC\u05D9\u05D1\u05EA \u05D4\u05E8\u05D9\u05E7 \u05DE\u05D0\u05D7\u05D5\u05E8\u05D9\u05DB\u05DD; \u05DC\u05E4\u05E0\u05D9\u05DB\u05DD \u05E2\u05E0\u05E7 \u05D0\u05D3\u05D5\u05DD \u05D2\u05D5\u05E1\u05E1. \u05D4\u05D4\u05EA\u05DC\u05E7\u05D7\u05D5\u05D9\u05D5\u05EA \u05E9\u05DC\u05D5 \u05E1\u05D5\u05D7\u05E4\u05D5\u05EA \u05D0\u05EA \u05E1\u05D7\u05E3 \u05D4\u05D2\u05D7\u05DC\u05D9\u05DD - \u05E4\u05E0\u05D5 \u05D0\u05EA \u05D4\u05E1\u05DC\u05E2\u05D9\u05DD \u05DE\u05E0\u05EA\u05D9\u05D1\u05D9 \u05D4\u05E9\u05D9\u05D9\u05E8\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010242
    m_Localized: "\u05D4\u05EA\u05DC\u05E7\u05D7\u05D5\u05D9\u05D5\u05EA \u05E1\u05D5\u05DC\u05D0\u05E8\u05D9\u05D5\u05EA \u05D7\u05D5\u05E6\u05D5\u05EA \u05D0\u05EA \u05D4\u05D2\u05D6\u05E8\u05D4. \u05D6\u05E0\u05E7\u05D5 \u05D3\u05E8\u05DA \u05D4\u05D0\u05E9."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010243
    m_Localized: "\u05E7\u05E6\u05D4 \u05D4\u05DE\u05E1\u05DA \u05D6\u05D5\u05D4\u05E8 \u05DC\u05E4\u05E0\u05D9 \u05D4\u05EA\u05DC\u05E7\u05D7\u05D5\u05EA. \u05D7\u05D5\u05DE\u05EA \u05D4\u05D0\u05E9 \u05E9\u05DC\u05D4 \u05D7\u05D5\u05E6\u05D4 \u05D0\u05EA \u05DB\u05DC \u05D4\u05D2\u05D6\u05E8\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010244
    m_Localized: "\u05D6\u05D9\u05E0\u05D5\u05E7 (SHIFT) \u05DE\u05E2\u05D1\u05D9\u05E8 \u05D0\u05EA\u05DB\u05DD \u05D3\u05E8\u05DA \u05D4\u05D0\u05E9 \u05D1\u05DC\u05D9 \u05E4\u05D2\u05E2 - \u05D5\u05D2\u05DD \u05DE\u05D2\u05DF \u05DE\u05DC\u05D0, \u05D1\u05DE\u05D7\u05D9\u05E8 \u05DE\u05E1\u05D5\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010245
    m_Localized: "\u05D6\u05D9\u05E0\u05D5\u05E7 \u05DE\u05E2\u05D1\u05D9\u05E8 \u05D0\u05EA\u05DB\u05DD \u05D3\u05E8\u05DA \u05D4\u05D0\u05E9 \u05D1\u05DC\u05D9 \u05E4\u05D2\u05E2 - \u05D5\u05D2\u05DD \u05DE\u05D2\u05DF \u05DE\u05DC\u05D0, \u05D1\u05DE\u05D7\u05D9\u05E8 \u05DE\u05E1\u05D5\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010246
    m_Localized: "\u05D2\u05E9\u05DD \u05D1\u05E8\u05D6\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010247
    m_Localized: "\u05D7\u05D5\u05DD \u05D4\u05DB\u05D5\u05DB\u05D1 \u05D4\u05E8\u05EA\u05D9\u05D7 \u05D0\u05EA \u05D4\u05E1\u05D7\u05E3 \u05E2\u05D3 \u05E9\u05E0\u05E9\u05D0\u05E8 \u05E8\u05E7 \u05D1\u05E8\u05D6\u05DC. \u05E1\u05DC\u05E2\u05D9\u05DD \u05DE\u05E9\u05D5\u05E8\u05D9\u05D9\u05E0\u05D9\u05DD \u05DE\u05EA\u05E2\u05DC\u05DE\u05D9\u05DD \u05DE\u05D4\u05D9\u05E8\u05D9\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD - \u05D0\u05D1\u05DC \u05DC\u05D0 \u05DE\u05E4\u05D9\u05E6\u05D5\u05E5 \u05D8\u05D5\u05D1."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010248
    m_Localized: "\u05E1\u05DC\u05E2\u05D9 \u05D1\u05E8\u05D6\u05DC \u05E1\u05D5\u05E4\u05D2\u05D9\u05DD \u05D7\u05E6\u05D9 \u05E0\u05D6\u05E7 \u05DE\u05D9\u05E8\u05D9\u05D5\u05EA \u05D5\u05E0\u05E9\u05D1\u05E8\u05D9\u05DD \u05D1\u05E4\u05D9\u05E6\u05D5\u05E6\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010249
    m_Localized: "\u05E1\u05DC\u05E2\u05D9 \u05D1\u05E8\u05D6\u05DC \u05DE\u05E6\u05DC\u05E6\u05DC\u05D9\u05DD \u05DB\u05E9\u05D4\u05D9\u05E8\u05D9\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD \u05E0\u05D9\u05EA\u05D6\u05D5\u05EA \u05DE\u05D4\u05DD - \u05D4\u05DD \u05E1\u05D5\u05E4\u05D2\u05D9\u05DD \u05D7\u05E6\u05D9 \u05E0\u05D6\u05E7."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010250
    m_Localized: "\u05E4\u05D9\u05E6\u05D5\u05E6\u05D9\u05DD \u05DE\u05D1\u05E7\u05D9\u05E2\u05D9\u05DD \u05D1\u05E8\u05D6\u05DC: \u05E4\u05D5\u05E6\u05E6\u05D5 \u05DE\u05D5\u05E7\u05E9\u05D9\u05DD \u05D5\u05E1\u05DC\u05E2\u05D9 \u05DE\u05D0\u05D2\u05DE\u05D4 \u05DC\u05D9\u05D3\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010251
    m_Localized: "\u05D8\u05D9\u05D8\u05D0\u05DF \u05E9\u05DC \u05D1\u05E8\u05D6\u05DC \u05DE\u05D5\u05EA\u05DA \u05DE\u05EA\u05D2\u05DC\u05D2\u05DC \u05DE\u05EA\u05D5\u05DA \u05D1\u05D5\u05D4\u05E7 \u05D4\u05DB\u05D5\u05DB\u05D1 \u05D5\u05DE\u05D8\u05D9\u05D7 \u05E1\u05D9\u05D2\u05D9\u05DD. \u05D4\u05D5\u05D0 \u05DC\u05D0 \u05E0\u05E2\u05E0\u05D4 \u05DC\u05E9\u05D5\u05DD \u05D3\u05D1\u05E8 \u05DE\u05DC\u05D1\u05D3 \u05D7\u05D5\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010252
    m_Localized: "\u05D1\u05D5\u05E1: \u05D8\u05D9\u05D8\u05D0\u05DF \u05D4\u05E1\u05D9\u05D2\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010253
    m_Localized: "\u05D8\u05D9\u05D8\u05D0\u05DF \u05D4\u05E1\u05D9\u05D2\u05D9\u05DD \u05D6\u05D5\u05E8\u05E7 \u05E1\u05DC\u05E2\u05D9 \u05D1\u05E8\u05D6\u05DC - \u05E4\u05D9\u05E6\u05D5\u05E6\u05D9\u05DD \u05E9\u05D5\u05D1\u05E8\u05D9\u05DD \u05D0\u05D5\u05EA\u05DD \u05D4\u05DB\u05D9 \u05DE\u05D4\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010254
    m_Localized: "\u05DB\u05E9\u05D4\u05D5\u05D0 \u05E0\u05DC\u05D7\u05E5 \u05DC\u05E4\u05D9\u05E0\u05D4, \u05D4\u05D5\u05D0 \u05DE\u05D5\u05E8\u05D9\u05D3 \u05E2\u05DC\u05D9\u05DB\u05DD \u05D0\u05EA \u05D4\u05EA\u05DC\u05E7\u05D7\u05D5\u05D9\u05D5\u05EA \u05D4\u05DB\u05D5\u05DB\u05D1."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010255
    m_Localized: "\u05DC\u05D4\u05D8"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010256
    m_Localized: "\u05E9\u05D9\u05D9\u05E8\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010257
    m_Localized: "\u05E1\u05E4\u05D9\u05E0\u05D5\u05EA \u05D4\u05DE\u05E9\u05D0 \u05D4\u05E8\u05D0\u05E9\u05D5\u05E0\u05D5\u05EA \u05E9\u05DC \u05D4\u05DE\u05EA\u05D9\u05D9\u05E9\u05D1\u05D9\u05DD \u05D9\u05D5\u05E6\u05D0\u05D5\u05EA \u05DC\u05D3\u05E8\u05DB\u05DF \u05D3\u05E8\u05DA \u05DE\u05E8\u05D7\u05D1 \u05D4\u05D9\u05D5\u05E0\u05D9\u05DD. \u05E7\u05D5\u05E8\u05E1\u05E8\u05D9\u05DD \u05E9\u05DC \u05D4\u05E9\u05D5\u05D3\u05D3\u05D9\u05DD \u05DE\u05D7\u05DB\u05D9\u05DD \u05DC\u05D4\u05DF. \u05D4\u05E2\u05D1\u05D9\u05E8\u05D5 \u05D0\u05D5\u05EA\u05DF \u05DC\u05E6\u05D3 \u05D4\u05E9\u05E0\u05D9."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010258
    m_Localized: "\u05DC\u05D5\u05D5 \u05D0\u05EA \u05E1\u05E4\u05D9\u05E0\u05D5\u05EA \u05D4\u05DE\u05E9\u05D0 \u05DC\u05E6\u05D3 \u05D4\u05E9\u05E0\u05D9. \u05D4\u05E7\u05D5\u05E8\u05E1\u05E8\u05D9\u05DD \u05D4\u05D5\u05DC\u05DB\u05D9\u05DD \u05E2\u05DC\u05D9\u05D4\u05DF \u05E7\u05D5\u05D3\u05DD. \u05E0\u05E9\u05E7 \u05D7\u05D3\u05E9: \u05DE\u05D8\u05D9\u05DC \u05D4\u05E7\u05E9\u05EA\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010259
    m_Localized: "\u05E1\u05E4\u05D9\u05E0\u05EA \u05D4\u05DE\u05E9\u05D0 \u05D7\u05D5\u05E6\u05D4 \u05D0\u05EA \u05D4\u05D2\u05D6\u05E8\u05D4 \u05DE\u05E6\u05D3 \u05DC\u05E6\u05D3. \u05D0\u05DD \u05D4\u05D9\u05D0 \u05DE\u05D5\u05E9\u05DE\u05D3\u05EA, \u05D4\u05DE\u05E9\u05D9\u05DE\u05D4 \u05E0\u05DB\u05E9\u05DC\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010260
    m_Localized: "\u05E7\u05D5\u05E8\u05E1\u05E8\u05D9\u05DD \u05E6\u05D5\u05DC\u05DC\u05D9\u05DD \u05D0\u05DC \u05E1\u05E4\u05D9\u05E0\u05EA \u05D4\u05DE\u05E9\u05D0 - \u05D4\u05E4\u05D9\u05DC\u05D5 \u05D0\u05D5\u05EA\u05DD \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05DD \u05DE\u05D2\u05D9\u05E2\u05D9\u05DD \u05D0\u05DC\u05D9\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010261
    m_Localized: "\u05E1\u05DC\u05E2\u05D9\u05DD \u05E9\u05E0\u05E1\u05D7\u05E4\u05D9\u05DD \u05D0\u05DC \u05E1\u05E4\u05D9\u05E0\u05EA \u05D4\u05DE\u05E9\u05D0 \u05E4\u05D5\u05D2\u05E2\u05D9\u05DD \u05D1\u05D4. \u05E4\u05E0\u05D5 \u05DC\u05D4 \u05D0\u05EA \u05D4\u05D3\u05E8\u05DA."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010262
    m_Localized: "\u05D7\u05E9\u05DE\u05DC \u05E1\u05D8\u05D8\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010263
    m_Localized: "\u05D7\u05D6\u05D9\u05EA \u05E9\u05DC \u05E1\u05E2\u05E8\u05EA \u05D9\u05D5\u05E0\u05D9\u05DD \u05DE\u05EA\u05D2\u05DC\u05D2\u05DC\u05EA \u05E2\u05DC \u05D4\u05DE\u05E8\u05D7\u05D1. \u05D4\u05D7\u05D6\u05D9\u05E7\u05D5 \u05DE\u05E2\u05DE\u05D3 \u05DE\u05D0\u05D4 \u05E9\u05E0\u05D9\u05D5\u05EA \u05D1\u05D6\u05DE\u05DF \u05E9\u05D4\u05D1\u05E8\u05E7\u05D9\u05DD \u05E6\u05D3\u05D9\u05DD \u05D0\u05EA\u05DB\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010264
    m_Localized: "\u05E1\u05E2\u05E8\u05D5\u05EA \u05D9\u05D5\u05E0\u05D9\u05DD \u05DE\u05D0\u05D8\u05D5\u05EA \u05D0\u05EA\u05DB\u05DD, \u05DE\u05E8\u05D5\u05E7\u05E0\u05D5\u05EA \u05D0\u05EA \u05D4\u05DE\u05D2\u05DF \u05D5\u05E7\u05D5\u05E8\u05D0\u05D5\u05EA \u05DC\u05D1\u05E8\u05E7\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010265
    m_Localized: "\u05D4\u05EA\u05E8\u05D7\u05E7\u05D5 \u05DE\u05E2\u05E0\u05E0\u05D9 \u05D4\u05D9\u05D5\u05E0\u05D9\u05DD: \u05D4\u05DD \u05DE\u05D0\u05D8\u05D9\u05DD \u05D0\u05EA\u05DB\u05DD \u05D5\u05DE\u05E8\u05D5\u05E7\u05E0\u05D9\u05DD \u05D0\u05EA \u05D4\u05DE\u05D2\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010266
    m_Localized: "\u05D8\u05D1\u05E2\u05EA \u05DE\u05E1\u05DE\u05E0\u05EA \u05D4\u05D9\u05DB\u05DF \u05D9\u05E4\u05D2\u05E2 \u05D1\u05E8\u05E7 - \u05E6\u05D0\u05D5 \u05DE\u05DE\u05E0\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010267
    m_Localized: "\u05DE\u05E9\u05D4\u05D5 \u05E8\u05D5\u05DB\u05D1 \u05E2\u05DC \u05D4\u05E1\u05E2\u05E8\u05D4: \u05D8\u05E8\u05D9\u05D2\u05D5\u05DF \u05D7\u05D9 \u05E9\u05DE\u05EA\u05E4\u05E6\u05E4\u05E5 \u05D1\u05D0\u05E9 \u05D9\u05D5\u05E0\u05D9\u05DD. \u05D4\u05E9\u05D5\u05D3\u05D3\u05D9\u05DD \u05E7\u05D5\u05E8\u05D0\u05D9\u05DD \u05DC\u05D5 \u05D4\u05DE\u05D1\u05E9\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010268
    m_Localized: "\u05D1\u05D5\u05E1: \u05DE\u05D1\u05E9\u05E8 \u05D4\u05E1\u05E2\u05E8\u05D4 \u05D7\u05D2 \u05E1\u05D1\u05D9\u05D1 \u05D4\u05D2\u05D6\u05E8\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010269
    m_Localized: "\u05D4\u05DE\u05D1\u05E9\u05E8 \u05D7\u05D2 \u05E1\u05D1\u05D9\u05D1 \u05D4\u05D2\u05D6\u05E8\u05D4 \u05D5\u05DE\u05D5\u05E8\u05D9\u05D3 \u05E2\u05DC\u05D9\u05DB\u05DD \u05D1\u05E8\u05E7\u05D9\u05DD - \u05D4\u05DE\u05E9\u05D9\u05DB\u05D5 \u05DC\u05D6\u05D5\u05D6."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010270
    m_Localized: "\u05DB\u05E9\u05D4\u05D5\u05D0 \u05E0\u05E4\u05D2\u05E2 \u05D4\u05D5\u05D0 \u05DE\u05D1\u05D9\u05D0 \u05E1\u05E2\u05E8\u05D5\u05EA \u05D5\u05E7\u05D5\u05E8\u05E1\u05E8\u05D9\u05DD. \u05E9\u05DE\u05E8\u05D5 \u05E4\u05E6\u05E6\u05EA \u05E0\u05D5\u05D1\u05D4 (B)."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010271
    m_Localized: "\u05DB\u05E9\u05D4\u05D5\u05D0 \u05E0\u05E4\u05D2\u05E2 \u05D4\u05D5\u05D0 \u05DE\u05D1\u05D9\u05D0 \u05E1\u05E2\u05E8\u05D5\u05EA \u05D5\u05E7\u05D5\u05E8\u05E1\u05E8\u05D9\u05DD. \u05E9\u05DE\u05E8\u05D5 \u05E4\u05E6\u05E6\u05EA \u05E0\u05D5\u05D1\u05D4 (\u05E0\u05D5\u05D1\u05D4)."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010272
    m_Localized: "\u05D7\u05D6\u05D9\u05EA \u05D4\u05E1\u05E2\u05E8\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010273
    m_Localized: "\u05E7\u05D5 \u05D4\u05EA\u05D5\u05EA\u05D7\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010274
    m_Localized: "\u05D4\u05E9\u05D5\u05D3\u05D3\u05D9\u05DD \u05E2\u05D9\u05D2\u05E0\u05D5 \u05EA\u05D5\u05EA\u05D7\u05D9 \u05D6\u05E7\u05D9\u05E3 \u05D1\u05D9\u05DF \u05E9\u05E8\u05D8\u05D5\u05E0\u05D9 \u05D4\u05D1\u05E8\u05D6\u05DC. \u05E9\u05D1\u05E8\u05D5 \u05D0\u05EA \u05D4\u05E7\u05D5 \u05DB\u05D3\u05D9 \u05E9\u05D4\u05E9\u05D9\u05D9\u05E8\u05D5\u05EA \u05D9\u05D5\u05DB\u05DC\u05D5 \u05DC\u05E2\u05D1\u05D5\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010275
    m_Localized: "\u05EA\u05D5\u05EA\u05D7\u05D9 \u05D6\u05E7\u05D9\u05E3 \u05D6\u05D5\u05D4\u05E8\u05D9\u05DD \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05DD \u05D9\u05D5\u05E8\u05D9\u05DD. \u05E0\u05E9\u05E7 \u05D7\u05D3\u05E9: \u05DE\u05D0\u05D9\u05E5 \u05D4\u05DE\u05E1\u05D9\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010276
    m_Localized: "\u05D4\u05DC\u05D5\u05E2 \u05E9\u05DC \u05EA\u05D5\u05EA\u05D7 \u05D6\u05E7\u05D9\u05E3 \u05D6\u05D5\u05D4\u05E8 \u05DC\u05E4\u05E0\u05D9 \u05E6\u05E8\u05D5\u05E8 - \u05E6\u05D0\u05D5 \u05DE\u05D4\u05E7\u05D5 \u05E9\u05DC\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010277
    m_Localized: "\u05DE\u05D0\u05D9\u05E5 \u05D4\u05DE\u05E1\u05D9\u05DC\u05D4 \u05D7\u05D5\u05D3\u05E8 \u05D3\u05E8\u05DA \u05D1\u05E8\u05D6\u05DC \u05D5\u05D3\u05E8\u05DA \u05E9\u05D5\u05E8\u05D5\u05EA \u05E9\u05DC \u05DE\u05D8\u05E8\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010278
    m_Localized: "\u05D4\u05D7\u05D6\u05E7\u05EA \u05D4\u05E2\u05DE\u05D3\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010279
    m_Localized: "\u05EA\u05D7\u05E0\u05EA \u05EA\u05D3\u05DC\u05D5\u05E7 \u05E0\u05D9\u05E6\u05D1\u05EA \u05D1\u05E9\u05E8\u05D8\u05D5\u05E0\u05D9\u05DD, \u05D4\u05EA\u05D7\u05E0\u05D4 \u05D4\u05D0\u05D7\u05E8\u05D5\u05E0\u05D4 \u05DC\u05E4\u05E0\u05D9 \u05D4\u05E7\u05D5\u05E8\u05D5\u05E0\u05D4. \u05DE\u05D8\u05D9\u05DC\u05D9 \u05DE\u05D5\u05E7\u05E9\u05D9\u05DD \u05DE\u05EA\u05E7\u05E8\u05D1\u05D9\u05DD. \u05E9\u05DE\u05E8\u05D5 \u05E9\u05EA\u05D9\u05E9\u05D0\u05E8 \u05E2\u05D5\u05DE\u05D3\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010280
    m_Localized: "\u05D4\u05D2\u05E0\u05D5 \u05E2\u05DC \u05D4\u05EA\u05D7\u05E0\u05D4. \u05DE\u05D8\u05D9\u05DC\u05D9 \u05DE\u05D5\u05E7\u05E9\u05D9\u05DD \u05D6\u05D5\u05E8\u05E2\u05D9\u05DD \u05DE\u05D5\u05E7\u05E9\u05D9\u05DD \u05D1\u05D3\u05E8\u05DB\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010281
    m_Localized: "\u05DE\u05D8\u05D9\u05DC\u05D9 \u05DE\u05D5\u05E7\u05E9\u05D9\u05DD \u05D7\u05D5\u05E6\u05D9\u05DD \u05D0\u05EA \u05D4\u05D2\u05D6\u05E8\u05D4 \u05D5\u05D6\u05D5\u05E8\u05E2\u05D9\u05DD \u05DE\u05D5\u05E7\u05E9\u05D9\u05DD - \u05E2\u05E6\u05E8\u05D5 \u05D0\u05D5\u05EA\u05DD \u05DE\u05D5\u05E7\u05D3\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010282
    m_Localized: "\u05E4\u05D9\u05E6\u05D5\u05E6\u05D9 \u05DE\u05D5\u05E7\u05E9\u05D9\u05DD \u05DC\u05D9\u05D3 \u05D4\u05EA\u05D7\u05E0\u05D4 \u05E4\u05D5\u05D2\u05E2\u05D9\u05DD \u05D1\u05D4. \u05E4\u05D5\u05E6\u05E6\u05D5 \u05DE\u05D5\u05E7\u05E9\u05D9\u05DD \u05DB\u05E9\u05D4\u05DD \u05E8\u05D7\u05D5\u05E7\u05D9\u05DD \u05DE\u05DE\u05E0\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010283
    m_Localized: "\u05D4\u05DE\u05D1\u05E6\u05E8 \u05E9\u05DC \u05E9\u05E8 \u05D4\u05DE\u05DC\u05D7\u05DE\u05D4 \u05E9\u05D5\u05DE\u05E8 \u05E2\u05DC \u05D4\u05D9\u05E6\u05D9\u05D0\u05D4 \u05DE\u05D4\u05E9\u05E8\u05D8\u05D5\u05E0\u05D9\u05DD: \u05D8\u05D1\u05E2\u05EA \u05E9\u05DC \u05EA\u05D5\u05EA\u05D7\u05D9\u05DD, \u05E8\u05DE\u05D7\u05D9\u05DD \u05D5\u05EA\u05D0\u05D9 \u05DE\u05D5\u05E7\u05E9\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010284
    m_Localized: "\u05D1\u05D5\u05E1: \u05D4\u05DE\u05E2\u05D5\u05D6 \u05D9\u05D5\u05E8\u05D4 \u05E8\u05DE\u05D7\u05D9\u05DD - \u05E7\u05D5 \u05D3\u05E7 \u05DE\u05D6\u05D4\u05D9\u05E8 \u05D4\u05D9\u05DB\u05DF \u05D4\u05E7\u05E8\u05DF \u05EA\u05E9\u05E8\u05D5\u05E3."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010285
    m_Localized: "\u05E7\u05D5 \u05D0\u05D3\u05D5\u05DD \u05D3\u05E7 \u05DE\u05D6\u05D4\u05D9\u05E8 \u05DE\u05E4\u05E0\u05D9 \u05E8\u05D5\u05DE\u05D7. \u05E6\u05D0\u05D5 \u05DE\u05D4\u05E7\u05D5 \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05D5\u05D0 \u05E9\u05D5\u05E8\u05E3."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010286
    m_Localized: "\u05D4\u05DE\u05E2\u05D5\u05D6 \u05E9\u05D5\u05DC\u05D7 \u05EA\u05D5\u05EA\u05D7\u05D9 \u05D6\u05E7\u05D9\u05E3 \u05D5\u05DE\u05D5\u05E7\u05E9\u05D9\u05DD - \u05D7\u05E1\u05DC\u05D5 \u05D0\u05D5\u05EA\u05DD \u05D1\u05D3\u05E8\u05DA."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010287
    m_Localized: "\u05D4\u05EA\u05D5\u05EA\u05D7\u05D9\u05DD \u05D4\u05D7\u05D9\u05E6\u05D5\u05E0\u05D9\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010288
    m_Localized: "\u05E6\u05D9\u05D3 \u05E8\u05D0\u05E9\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010289
    m_Localized: "\u05D4\u05D0\u05E1\u05D9\u05DD \u05E9\u05DC \u05E9\u05E8 \u05D4\u05DE\u05DC\u05D7\u05DE\u05D4 \u05D8\u05E1\u05D9\u05DD \u05D1\u05D1\u05D5\u05D4\u05E7 \u05D4\u05E7\u05D5\u05E8\u05D5\u05E0\u05D4, \u05D5\u05E9\u05D9\u05E9\u05D4 \u05DE\u05D4\u05DD \u05E0\u05D5\u05E9\u05D0\u05D9\u05DD \u05D0\u05EA \u05D4\u05E7\u05D5\u05D3\u05D9\u05DD \u05E9\u05DC\u05D5. \u05DE\u05E6\u05D0\u05D5 \u05D0\u05EA \u05D4\u05DE\u05E1\u05D5\u05DE\u05E0\u05D9\u05DD \u05D5\u05D4\u05E4\u05D9\u05DC\u05D5 \u05D0\u05D5\u05EA\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010290
    m_Localized: "\u05E6\u05D5\u05D3\u05D5 \u05D0\u05EA \u05D4\u05DE\u05D8\u05E8\u05D5\u05EA \u05D4\u05DE\u05E1\u05D5\u05DE\u05E0\u05D5\u05EA. \u05D0\u05D5\u05D9\u05D1\u05D9\u05DD \u05DE\u05E1\u05D5\u05DE\u05E0\u05D9\u05DD \u05E9\u05D5\u05D5\u05D9\u05DD \u05DB\u05E4\u05D5\u05DC."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010291
    m_Localized: "\u05DE\u05D8\u05E8\u05D5\u05EA \u05DE\u05E1\u05D5\u05DE\u05E0\u05D5\u05EA \u05E2\u05D5\u05E0\u05D3\u05D5\u05EA \u05DB\u05D5\u05D5\u05E0\u05EA \u05D6\u05D4\u05D1 \u05D5\u05E9\u05D5\u05D5\u05EA \u05DB\u05E4\u05D5\u05DC \u05E0\u05E7\u05D5\u05D3\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010292
    m_Localized: "\u05E8\u05E7 \u05D4\u05DE\u05E1\u05D5\u05DE\u05E0\u05D9\u05DD \u05E0\u05D7\u05E9\u05D1\u05D9\u05DD - \u05D0\u05D1\u05DC \u05D2\u05DD \u05D4\u05D0\u05D7\u05E8\u05D9\u05DD \u05D9\u05D5\u05E8\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010293
    m_Localized: "\u05D4\u05DE\u05E0\u05D5\u05E1\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010294
    m_Localized: "\u05D4\u05DB\u05D5\u05DB\u05D1 \u05E2\u05D5\u05DE\u05D3 \u05DC\u05D4\u05EA\u05E4\u05D5\u05E6\u05E5. \u05E9\u05DC\u05D5\u05E9 \u05E1\u05E4\u05D9\u05E0\u05D5\u05EA \u05D4\u05DE\u05E9\u05D0 \u05D4\u05D0\u05D7\u05E8\u05D5\u05E0\u05D5\u05EA \u05D3\u05D5\u05D4\u05E8\u05D5\u05EA \u05D3\u05E8\u05DA \u05D4\u05E7\u05D5\u05E8\u05D5\u05E0\u05D4 \u05E2\u05DD \u05DB\u05DC \u05DE\u05D4 \u05E9\u05E0\u05E9\u05D0\u05E8 \u05DC\u05E9\u05E8 \u05D4\u05DE\u05DC\u05D7\u05DE\u05D4 \u05E2\u05DC \u05D4\u05D6\u05E0\u05D1 \u05E9\u05DC\u05D4\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010295
    m_Localized: "\u05D4\u05DB\u05D5\u05DC \u05D1\u05D1\u05EA \u05D0\u05D7\u05EA - \u05D5\u05D4\u05E9\u05D9\u05D9\u05E8\u05D4 \u05D7\u05D9\u05D9\u05D1\u05EA \u05DC\u05E2\u05D1\u05D5\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010296
    m_Localized: "\u05D4\u05EA\u05DC\u05E7\u05D7\u05D5\u05D9\u05D5\u05EA \u05E9\u05D5\u05E8\u05E4\u05D5\u05EA \u05D2\u05DD \u05D0\u05EA \u05E1\u05E4\u05D9\u05E0\u05D5\u05EA \u05D4\u05DE\u05E9\u05D0. \u05E4\u05E0\u05D5 \u05DC\u05D4\u05DF \u05D0\u05EA \u05D4\u05D3\u05E8\u05DA \u05D5\u05D4\u05E8\u05D7\u05D9\u05E7\u05D5 \u05DE\u05D4\u05DF \u05D0\u05EA \u05D4\u05E7\u05D5\u05E8\u05E1\u05E8\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010297
    m_Localized: "\u05E1\u05E4\u05D9\u05E0\u05EA \u05DE\u05E9\u05D0 \u05E9\u05E2\u05D5\u05D1\u05E8\u05EA \u05DE\u05D6\u05DB\u05D4 \u05D1\u05D1\u05D5\u05E0\u05D5\u05E1 \u05DC\u05E4\u05D9 \u05D4\u05D2\u05D5\u05E3 \u05E9\u05E0\u05E9\u05D0\u05E8 \u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010298
    m_Localized: "\u05E9\u05E8 \u05D4\u05DE\u05DC\u05D7\u05DE\u05D4 \u05D1\u05E2\u05E6\u05DE\u05D5, \u05E2\u05DC \u05E1\u05D9\u05E4\u05D5\u05DF \u05E9\u05D5\u05D1\u05E8 \u05D4\u05E9\u05DE\u05E9: \u05E1\u05E4\u05D9\u05E0\u05EA \u05D3\u05D2\u05DC \u05E9\u05E0\u05D1\u05E0\u05EA\u05D4 \u05E1\u05D1\u05D9\u05D1 \u05EA\u05D5\u05EA\u05D7 \u05E9\u05E9\u05D5\u05EA\u05D4 \u05D0\u05D5\u05E8 \u05DB\u05D5\u05DB\u05D1\u05D9\u05DD. \u05E1\u05D9\u05D9\u05DE\u05D5 \u05D0\u05EA \u05D4\u05DE\u05DC\u05D7\u05DE\u05D4 \u05E9\u05DC\u05D5 \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05DB\u05D5\u05DB\u05D1 \u05D9\u05E1\u05D9\u05D9\u05DD \u05D4\u05DB\u05D5\u05DC."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010299
    m_Localized: "\u05D4\u05D1\u05D5\u05E1 \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF \u05E9\u05DC \u05D4\u05D2\u05D1\u05D5\u05DC: \u05E9\u05D5\u05D1\u05E8 \u05D4\u05E9\u05DE\u05E9."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010300
    m_Localized: "\u05EA\u05D5\u05EA\u05D7 \u05D4\u05E9\u05DE\u05E9 \u05E9\u05DC\u05D5 \u05E1\u05D5\u05D7\u05E3 \u05E7\u05E8\u05DF \u05DC\u05E8\u05D5\u05D7\u05D1 \u05D4\u05D2\u05D6\u05E8\u05D4 - \u05E9\u05D9\u05DE\u05D5 \u05DC\u05D1 \u05DC\u05E7\u05D5 \u05D4\u05D0\u05D6\u05D4\u05E8\u05D4 \u05D5\u05D4\u05D9\u05DB\u05E0\u05E1\u05D5 \u05DE\u05D0\u05D7\u05D5\u05E8\u05D9\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010301
    m_Localized: "\u05DB\u05D3\u05D5\u05E8\u05D9 \u05E0\u05D5\u05D1\u05D4 \u05DE\u05EA\u05E4\u05D5\u05E6\u05E6\u05D9\u05DD \u05DC\u05D8\u05D1\u05E2\u05D5\u05EA \u05E9\u05DC \u05D0\u05E9. \u05D9\u05E8\u05D5 \u05D1\u05D4\u05DD \u05DE\u05D5\u05E7\u05D3\u05DD \u05D0\u05D5 \u05EA\u05E0\u05D5 \u05DC\u05D4\u05DD \u05DE\u05E8\u05D7\u05D1."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010302
    m_Localized: "\u05DC\u05D9\u05D5\u05D5\u05D9 \u05E1\u05E4\u05D9\u05E0\u05EA \u05D4\u05D3\u05D2\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010303
    m_Localized: "\u05D1\u05D9\u05EA \u05D4\u05E7\u05D1\u05E8\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010304
    m_Localized: "\u05DE\u05E2\u05D1\u05E8 \u05DC\u05DB\u05D5\u05DB\u05D1 \u05D4\u05DE\u05EA \u05DE\u05E9\u05EA\u05E8\u05E2 \u05E9\u05D1\u05E8 \u05DE\u05DC\u05D0 \u05D1\u05D4\u05E8\u05D9\u05E1\u05D5\u05EA \u05DE\u05DE\u05DC\u05D7\u05DE\u05D4 \u05E9\u05D0\u05D9\u05E9 \u05DC\u05D0 \u05D6\u05D5\u05DB\u05E8. \u05DE\u05E9\u05D4\u05D5 \u05D1\u05EA\u05D5\u05DB\u05D5 \u05E7\u05D5\u05E8\u05D0. \u05E4\u05E0\u05D5 \u05D3\u05E8\u05DA \u05E4\u05E0\u05D9\u05DE\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010305
    m_Localized: "\u05D1\u05D4\u05E8\u05D9\u05E1\u05D5\u05EA \u05D9\u05E9 \u05E9\u05DC\u05DC, \u05D5\u05D7\u05DC\u05E7\u05D9\u05DD \u05E2\u05DD \u05DE\u05DB\u05DC \u05D6\u05D5\u05D4\u05E8 \u05DE\u05EA\u05E4\u05D5\u05E6\u05E6\u05D9\u05DD. \u05E0\u05E9\u05E7 \u05D7\u05D3\u05E9: \u05DE\u05E4\u05D5\u05E6\u05E5 \u05D4\u05E8\u05E1\u05D9\u05E1\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010306
    m_Localized: "\u05D4\u05E8\u05D9\u05E1\u05D5\u05EA \u05D2\u05D3\u05D5\u05DC\u05D5\u05EA \u05DE\u05E9\u05D0\u05D9\u05E8\u05D5\u05EA \u05D2\u05D1\u05D9\u05E9\u05D9 \u05E9\u05DC\u05DC \u05DB\u05E9\u05D4\u05DF \u05E0\u05E9\u05D1\u05E8\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010307
    m_Localized: "\u05D4\u05E8\u05D9\u05E1\u05D4 \u05E2\u05DD \u05DE\u05DB\u05DC \u05D0\u05D3\u05D5\u05DD \u05D6\u05D5\u05D4\u05E8 \u05DE\u05EA\u05E4\u05D5\u05E6\u05E6\u05EA - \u05E0\u05E6\u05DC\u05D5 \u05D0\u05D5\u05EA\u05D4 \u05E0\u05D2\u05D3 \u05D4\u05E1\u05DC\u05E2\u05D9\u05DD \u05E1\u05D1\u05D9\u05D1\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010308
    m_Localized: "\u05D6\u05DB\u05D5\u05EA \u05D4\u05E9\u05DC\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010309
    m_Localized: "\u05D0\u05D5\u05E1\u05E4\u05D9 \u05D2\u05E8\u05D5\u05D8\u05D0\u05D5\u05EA \u05D5\u05E9\u05D5\u05D3\u05D3\u05D9\u05DD \u05DE\u05E0\u05E7\u05E8\u05D9\u05DD \u05D1\u05D1\u05D9\u05EA \u05D4\u05E7\u05D1\u05E8\u05D5\u05EA. \u05E7\u05D7\u05D5 \u05D0\u05EA \u05D4\u05E9\u05DC\u05DC \u05DC\u05E4\u05E0\u05D9\u05D4\u05DD - \u05D5\u05DC\u05E4\u05E0\u05D9 \u05E9\u05DE\u05D8\u05D9\u05DC\u05D9 \u05D4\u05DE\u05D5\u05E7\u05E9\u05D9\u05DD \u05D9\u05D0\u05D8\u05DE\u05D5 \u05D0\u05EA \u05D4\u05E9\u05D3\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010310
    m_Localized: "\u05DE\u05D8\u05D9\u05DC\u05D9 \u05DE\u05D5\u05E7\u05E9\u05D9\u05DD \u05D5\u05E7\u05D5\u05E8\u05E1\u05E8\u05D9\u05DD \u05E0\u05DC\u05D7\u05DE\u05D9\u05DD \u05D1\u05DB\u05DD \u05E2\u05DC \u05D4\u05E9\u05DC\u05DC."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010311
    m_Localized: "\u05D4\u05E8\u05D9\u05E1\u05D5\u05EA \u05DE\u05E9\u05D0\u05D9\u05E8\u05D5\u05EA \u05D2\u05D1\u05D9\u05E9\u05D9 \u05E9\u05DC\u05DC - \u05D8\u05D5\u05E1\u05D5 \u05E7\u05E8\u05D5\u05D1 \u05DB\u05D3\u05D9 \u05DC\u05D0\u05E1\u05D5\u05E3 \u05D0\u05D5\u05EA\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010312
    m_Localized: "\u05DE\u05D8\u05D9\u05DC\u05D9 \u05DE\u05D5\u05E7\u05E9\u05D9\u05DD \u05D6\u05D5\u05E8\u05E2\u05D9\u05DD \u05DE\u05D5\u05E7\u05E9\u05D9\u05DD \u05DE\u05D0\u05D7\u05D5\u05E8\u05D9\u05D4\u05DD. \u05E2\u05E6\u05E8\u05D5 \u05D0\u05D5\u05EA\u05DD \u05DE\u05D5\u05E7\u05D3\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010313
    m_Localized: "\u05DC\u05D1\u05D9\u05EA \u05D4\u05E7\u05D1\u05E8\u05D5\u05EA \u05D9\u05E9 \u05E9\u05D5\u05DE\u05E8: \u05DC\u05D5\u05D5\u05D9\u05D9\u05EA\u05DF \u05E9\u05DC \u05D4\u05E8\u05D9\u05E1\u05D5\u05EA \u05DE\u05E8\u05D5\u05EA\u05DB\u05D5\u05EA, \u05E2\u05DD \u05DC\u05D5\u05E2 \u05E9\u05E9\u05D5\u05D0\u05D1 \u05E4\u05E0\u05D9\u05DE\u05D4 \u05E1\u05E4\u05D9\u05E0\u05D5\u05EA \u05E9\u05DC\u05DE\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010314
    m_Localized: "\u05D1\u05D5\u05E1: \u05DC\u05D5\u05D5\u05D9\u05D9\u05EA\u05DF \u05D4\u05D2\u05E8\u05D5\u05D8\u05D0\u05D5\u05EA. \u05D4\u05DC\u05D5\u05E2 \u05E9\u05DC\u05D5 \u05E9\u05D5\u05D0\u05D1 \u05DB\u05DE\u05D5 \u05D7\u05D5\u05E8 \u05E9\u05D7\u05D5\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010315
    m_Localized: "\u05DB\u05E9\u05D4\u05DC\u05D5\u05E2 \u05E9\u05DC\u05D5 \u05E0\u05E4\u05EA\u05D7, \u05D3\u05D7\u05E4\u05D5 \u05D4\u05E8\u05D7\u05E7 \u05DE\u05D4\u05DE\u05E9\u05D9\u05DB\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010316
    m_Localized: "\u05D4\u05D5\u05D0 \u05DE\u05D8\u05D9\u05D7 \u05D4\u05E8\u05D9\u05E1\u05D5\u05EA - \u05D4\u05D7\u05DC\u05E7\u05D9\u05DD \u05E2\u05DD \u05D4\u05DE\u05DB\u05DC\u05D9\u05DD \u05DE\u05EA\u05E4\u05D5\u05E6\u05E6\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010317
    m_Localized: "\u05E9\u05D3\u05D4 \u05E4\u05E1\u05D5\u05DC\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010318
    m_Localized: "\u05D0\u05D5\u05EA \u05E8\u05E4\u05D0\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010319
    m_Localized: "\u05D4\u05D0\u05D5\u05EA \u05E9\u05DC \u05D4\u05E9\u05E2\u05E8 \u05DE\u05EA\u05D7\u05D6\u05E7, \u05D5\u05D3\u05D1\u05E8\u05D9\u05DD \u05E2\u05D5\u05E0\u05D9\u05DD \u05DC\u05D5 - \u05E1\u05E4\u05D9\u05E0\u05D5\u05EA \u05E9\u05DE\u05D5\u05E4\u05D9\u05E2\u05D5\u05EA \u05D5\u05E0\u05E2\u05DC\u05DE\u05D5\u05EA \u05D1\u05D7\u05D5\u05E9\u05DA."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010320
    m_Localized: "\u05E8\u05D5\u05D3\u05E4\u05D9 \u05E4\u05D0\u05D6\u05D4 \u05DE\u05D4\u05D1\u05D4\u05D1\u05D9\u05DD \u05E7\u05E8\u05D5\u05D1 \u05D0\u05DC\u05D9\u05DB\u05DD. \u05D9\u05E8\u05D5 \u05D1\u05D4\u05DD \u05DB\u05E9\u05D4\u05DD \u05E0\u05E8\u05D0\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010321
    m_Localized: "\u05D8\u05D1\u05E2\u05EA \u05E9\u05DC \u05D0\u05D5\u05E8 \u05DE\u05E8\u05D0\u05D4 \u05D4\u05D9\u05DB\u05DF \u05D9\u05D5\u05E4\u05D9\u05E2 \u05E8\u05D5\u05D3\u05E3."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010322
    m_Localized: "\u05DB\u05E9\u05D4\u05D5\u05D0 \u05DE\u05D7\u05D5\u05E5 \u05DC\u05E4\u05D0\u05D6\u05D4 \u05D0\u05D9 \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E4\u05D2\u05D5\u05E2 \u05D1\u05E8\u05D5\u05D3\u05E3. \u05D9\u05E8\u05D5 \u05DB\u05E9\u05D4\u05D5\u05D0 \u05DE\u05D5\u05E4\u05D9\u05E2."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010323
    m_Localized: "\u05E6\u05D9\u05D3 \u05E8\u05E4\u05D0\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010324
    m_Localized: "\u05D7\u05DC\u05E7 \u05DE\u05D4\u05E8\u05D5\u05D3\u05E4\u05D9\u05DD \u05E0\u05D5\u05E9\u05D0\u05D9\u05DD \u05D0\u05EA \u05E7\u05D5\u05D3\u05D9 \u05D4\u05DE\u05E4\u05EA\u05D7 \u05E9\u05DC \u05D4\u05E9\u05E2\u05E8 - \u05E9\u05DE\u05D5\u05E0\u05D4 \u05DE\u05D4\u05DD. \u05E6\u05D5\u05D3\u05D5 \u05D0\u05EA \u05D4\u05DE\u05E1\u05D5\u05DE\u05E0\u05D9\u05DD \u05D3\u05E8\u05DA \u05D4\u05E1\u05E2\u05E8\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010325
    m_Localized: "\u05E6\u05D5\u05D3\u05D5 \u05D0\u05EA \u05D4\u05E8\u05D5\u05D3\u05E4\u05D9\u05DD \u05D4\u05DE\u05E1\u05D5\u05DE\u05E0\u05D9\u05DD - \u05D3\u05E8\u05DA \u05E1\u05E2\u05E8\u05D5\u05EA \u05D9\u05D5\u05E0\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010326
    m_Localized: "\u05E8\u05D5\u05D3\u05E4\u05D9\u05DD \u05DE\u05E1\u05D5\u05DE\u05E0\u05D9\u05DD \u05E2\u05D5\u05E0\u05D3\u05D9\u05DD \u05DB\u05D5\u05D5\u05E0\u05EA \u05D6\u05D4\u05D1. \u05E8\u05E7 \u05D4\u05DD \u05E0\u05D7\u05E9\u05D1\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010327
    m_Localized: "\u05E1\u05E2\u05E8\u05D5\u05EA \u05D9\u05D5\u05E0\u05D9\u05DD \u05DE\u05E8\u05D5\u05E7\u05E0\u05D5\u05EA \u05D0\u05EA \u05D4\u05DE\u05D2\u05DF - \u05D4\u05D9\u05DC\u05D7\u05DE\u05D5 \u05D1\u05E9\u05D5\u05DC\u05D9\u05D4\u05DF, \u05DC\u05D0 \u05D1\u05EA\u05D5\u05DB\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010328
    m_Localized: "\u05DC\u05E8\u05D5\u05D3\u05E4\u05D9\u05DD \u05D9\u05E9 \u05D0\u05DD. \u05D4\u05D9\u05D0 \u05DE\u05D4\u05D1\u05D4\u05D1\u05EA \u05DC\u05E8\u05D5\u05D7\u05D1 \u05D4\u05DE\u05E8\u05D7\u05D1 \u05DE\u05D4\u05E8 \u05D9\u05D5\u05EA\u05E8 \u05DE\u05DB\u05DC \u05E6\u05D0\u05E6\u05D0\u05D9\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010329
    m_Localized: "\u05D1\u05D5\u05E1: \u05D0\u05DD \u05D4\u05E8\u05E4\u05D0\u05D9\u05DD \u05DE\u05D4\u05D1\u05D4\u05D1\u05EA \u05DE\u05DE\u05E7\u05D5\u05DD \u05DC\u05DE\u05E7\u05D5\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010330
    m_Localized: "\u05D0\u05D9 \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E4\u05D2\u05D5\u05E2 \u05D1\u05D4 \u05DB\u05E9\u05D4\u05D9\u05D0 \u05DE\u05D4\u05D1\u05D4\u05D1\u05EA - \u05D8\u05D1\u05E2\u05EA \u05DE\u05E8\u05D0\u05D4 \u05D4\u05D9\u05DB\u05DF \u05D4\u05D9\u05D0 \u05EA\u05D5\u05E4\u05D9\u05E2."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010331
    m_Localized: "\u05DB\u05E9\u05D4\u05D9\u05D0 \u05E4\u05E6\u05D5\u05E2\u05D4, \u05D4\u05D9\u05D0 \u05E7\u05D5\u05E8\u05D0\u05EA \u05DC\u05E8\u05D5\u05D3\u05E4\u05D9\u05DD \u05E9\u05DC\u05D4 \u05D1\u05E0\u05D7\u05D9\u05DC\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010332
    m_Localized: "\u05E6\u05DC\u05DC\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010333
    m_Localized: "\u05E6\u05DE\u05D9\u05D7\u05EA \u05E4\u05E8\u05D0"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010334
    m_Localized: "\u05D4\u05E2\u05E8\u05E4\u05D9\u05DC\u05D9\u05EA \u05E9\u05DE\u05E2\u05D1\u05E8 \u05DC\u05DE\u05E8\u05D7\u05D1 \u05D7\u05D9\u05D4. \u05D4\u05E1\u05DC\u05E2\u05D9\u05DD \u05E9\u05DC\u05D4 \u05E6\u05D5\u05DE\u05D7\u05D9\u05DD, \u05DE\u05EA\u05E4\u05E6\u05DC\u05D9\u05DD \u05D5\u05E6\u05D5\u05DE\u05D7\u05D9\u05DD \u05E9\u05D5\u05D1. \u05E4\u05DC\u05E1\u05D5 \u05D3\u05E8\u05DA \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05D9\u05D0 \u05EA\u05D7\u05E0\u05D5\u05E7 \u05D0\u05EA \u05D4\u05E9\u05D1\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010335
    m_Localized: "\u05E1\u05DC\u05E2\u05D9 \u05D4\u05D9\u05D3\u05E8\u05D4 \u05DE\u05EA\u05E4\u05E6\u05DC\u05D9\u05DD \u05DC\u05E9\u05DC\u05D5\u05E9\u05D4, \u05D5\u05D4\u05D7\u05DC\u05E7\u05D9\u05DD \u05D4\u05E7\u05D8\u05E0\u05D9\u05DD \u05E9\u05DC\u05D4\u05DD \u05E6\u05D5\u05DE\u05D7\u05D9\u05DD \u05D1\u05D7\u05D6\u05E8\u05D4 \u05D0\u05DD \u05DE\u05E9\u05D0\u05D9\u05E8\u05D9\u05DD \u05D0\u05D5\u05EA\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010336
    m_Localized: "\u05D2\u05DE\u05E8\u05D5 \u05DE\u05D4\u05E8 \u05D0\u05EA \u05D7\u05DC\u05E7\u05D9 \u05D4\u05D4\u05D9\u05D3\u05E8\u05D4 \u05D4\u05E7\u05D8\u05E0\u05D9\u05DD - \u05D7\u05DC\u05E7 \u05E9\u05DE\u05EA\u05E0\u05E4\u05D7 \u05E2\u05D5\u05DE\u05D3 \u05DC\u05E6\u05DE\u05D5\u05D7 \u05D1\u05D7\u05D6\u05E8\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010337
    m_Localized: "\u05E1\u05DC\u05E2 \u05D4\u05D9\u05D3\u05E8\u05D4 \u05E0\u05E2\u05DC\u05DD \u05E8\u05E7 \u05DB\u05E9\u05DB\u05DC \u05D4\u05D7\u05DC\u05E7\u05D9\u05DD \u05E9\u05DC\u05D5 \u05E0\u05E2\u05DC\u05DE\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010338
    m_Localized: "\u05D7\u05D1\u05DC \u05D4\u05E6\u05DC\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010339
    m_Localized: "\u05E1\u05E4\u05D9\u05E0\u05EA \u05DE\u05E9\u05D0 \u05E9\u05DC \u05E1\u05E7\u05E8 \u05DE\u05D9\u05E4\u05EA\u05D4 \u05D0\u05EA \u05D4\u05D3\u05E8\u05DA \u05D0\u05DC \u05D4\u05E9\u05E2\u05E8. \u05D4\u05E2\u05D1\u05D9\u05E8\u05D5 \u05D0\u05D5\u05EA\u05D4 \u05D5\u05D0\u05EA \u05D4\u05EA\u05D0\u05D5\u05DE\u05D4 \u05E9\u05DC\u05D4 \u05D3\u05E8\u05DA \u05D4\u05E2\u05E8\u05E4\u05D9\u05DC\u05D9\u05EA \u05D1\u05D7\u05D9\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010340
    m_Localized: "\u05DC\u05D9\u05D5\u05D5\u05D9 \u05D3\u05E8\u05DA \u05E9\u05D3\u05D5\u05EA \u05D4\u05D4\u05D9\u05D3\u05E8\u05D4, \u05E2\u05DD \u05E8\u05D5\u05D3\u05E4\u05D9\u05DD \u05E9\u05DE\u05E9\u05D5\u05D8\u05D8\u05D9\u05DD \u05D1\u05E1\u05D1\u05D9\u05D1\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010341
    m_Localized: "\u05E1\u05DC\u05E2\u05D9 \u05D4\u05D9\u05D3\u05E8\u05D4 \u05DE\u05EA\u05E7\u05D4\u05DC\u05D9\u05DD \u05E1\u05D1\u05D9\u05D1 \u05E1\u05E4\u05D9\u05E0\u05EA \u05D4\u05DE\u05E9\u05D0 - \u05E9\u05DE\u05E8\u05D5 \u05E2\u05DC \u05D4\u05D3\u05E8\u05DA \u05E9\u05DC\u05D4 \u05E4\u05E0\u05D5\u05D9\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010342
    m_Localized: "\u05E8\u05D5\u05D3\u05E4\u05D9\u05DD \u05DE\u05D5\u05E4\u05D9\u05E2\u05D9\u05DD \u05DC\u05D9\u05D3\u05DB\u05DD, \u05DC\u05D0 \u05DC\u05D9\u05D3 \u05E1\u05E4\u05D9\u05E0\u05EA \u05D4\u05DE\u05E9\u05D0. \u05D0\u05DC \u05EA\u05EA\u05E0\u05D5 \u05DC\u05D4\u05DD \u05DC\u05DE\u05E9\u05D5\u05DA \u05D0\u05EA\u05DB\u05DD \u05D4\u05E8\u05D7\u05E7 \u05DC\u05D6\u05DE\u05DF \u05E8\u05D1."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010343
    m_Localized: "\u05D1\u05DC\u05D1 \u05D4\u05E2\u05E8\u05E4\u05D9\u05DC\u05D9\u05EA \u05DE\u05D7\u05DB\u05D4 \u05D0\u05DD \u05E1\u05DC\u05E2\u05D9 \u05D4\u05D4\u05D9\u05D3\u05E8\u05D4, \u05D1\u05E2\u05DC\u05EA \u05E9\u05DC\u05D5\u05E9\u05D4 \u05E8\u05D0\u05E9\u05D9\u05DD \u05D5\u05D9\u05D5\u05E8\u05E7\u05EA \u05D7\u05D5\u05DE\u05E6\u05D4. \u05D4\u05E4\u05E6\u05E2\u05D9\u05DD \u05E9\u05DC\u05D4 \u05E0\u05E1\u05D2\u05E8\u05D9\u05DD \u05DE\u05D5\u05DC \u05E2\u05D9\u05E0\u05D9\u05DB\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010344
    m_Localized: "\u05D1\u05D5\u05E1: \u05D4\u05D4\u05D9\u05D3\u05E8\u05D4 \u05DE\u05D7\u05DC\u05D9\u05DE\u05D4 \u05DB\u05E9\u05D0\u05EA\u05DD \u05DE\u05E8\u05E4\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010345
    m_Localized: "\u05D0\u05D7\u05E8\u05D9 \u05E9\u05E0\u05E4\u05E6\u05E2\u05D4, \u05D4\u05D4\u05D9\u05D3\u05E8\u05D4 \u05DE\u05D7\u05DC\u05D9\u05DE\u05D4 \u05D1\u05DB\u05DC \u05E4\u05E2\u05DD \u05E9\u05D0\u05EA\u05DD \u05DE\u05E4\u05E1\u05D9\u05E7\u05D9\u05DD \u05DC\u05E4\u05D2\u05D5\u05E2 \u05D1\u05D4. \u05D4\u05DE\u05E9\u05D9\u05DB\u05D5 \u05DC\u05D9\u05E8\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010346
    m_Localized: "\u05D4\u05D9\u05D0 \u05D6\u05D5\u05E8\u05E2\u05EA \u05E1\u05DC\u05E2\u05D9 \u05D4\u05D9\u05D3\u05E8\u05D4 - \u05D7\u05E1\u05DC\u05D5 \u05D0\u05D5\u05EA\u05DD \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05DD \u05E6\u05D5\u05DE\u05D7\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010347
    m_Localized: "\u05D4\u05E6\u05D0\u05E6\u05D0\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010348
    m_Localized: "\u05D4\u05E1\u05E3"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010349
    m_Localized: "\u05DE\u05D4\u05E0\u05D3\u05E1\u05D9\u05DD \u05D4\u05D2\u05D9\u05E2\u05D5 \u05D0\u05DC \u05D4\u05E9\u05E2\u05E8 \u05E2\u05DD \u05EA\u05D7\u05E0\u05D4 \u05E9\u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D0\u05D8\u05D5\u05DD \u05D0\u05D5\u05EA\u05D5. \u05D4\u05DD \u05E6\u05E8\u05D9\u05DB\u05D9\u05DD \u05D6\u05DE\u05DF - \u05D5\u05DB\u05DC \u05DE\u05D4 \u05E9\u05D9\u05E9 \u05D1\u05E9\u05D1\u05E8 \u05D1\u05D0 \u05D0\u05DC\u05D9\u05D4\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010350
    m_Localized: "\u05D4\u05D2\u05E0\u05D5 \u05E2\u05DC \u05EA\u05D7\u05E0\u05EA \u05D4\u05D0\u05D9\u05D8\u05D5\u05DD \u05E9\u05DC\u05D9\u05D3 \u05D4\u05E9\u05E2\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010351
    m_Localized: "\u05D4\u05E7\u05D5\u05E8\u05E1\u05E8\u05D9\u05DD \u05D4\u05D5\u05DC\u05DB\u05D9\u05DD \u05E7\u05D5\u05D3\u05DD \u05E2\u05DC \u05D4\u05EA\u05D7\u05E0\u05D4. \u05D4\u05D9\u05E9\u05D0\u05E8\u05D5 \u05E7\u05E8\u05D5\u05D1 \u05D0\u05DC\u05D9\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010352
    m_Localized: "\u05D1\u05E8\u05E7\u05D9\u05DD \u05D5\u05D4\u05EA\u05DC\u05E7\u05D7\u05D5\u05D9\u05D5\u05EA \u05E9\u05D5\u05E8\u05E4\u05D9\u05DD \u05D2\u05DD \u05D0\u05EA \u05D4\u05EA\u05D7\u05E0\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010353
    m_Localized: "\u05D4\u05E2\u05DE\u05D9\u05D3\u05D4 \u05D4\u05D0\u05D7\u05E8\u05D5\u05E0\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010354
    m_Localized: "\u05D4\u05D0\u05D9\u05D8\u05D5\u05DD \u05E7\u05D5\u05E8\u05E1. \u05D4\u05D7\u05D6\u05D9\u05E7\u05D5 \u05D0\u05EA \u05D4\u05E9\u05E2\u05E8 \u05E9\u05EA\u05D9 \u05D3\u05E7\u05D5\u05EA \u05D5\u05D7\u05E6\u05D9 \u05D1\u05D6\u05DE\u05DF \u05E9\u05DB\u05DC \u05DE\u05D4 \u05E9\u05D4\u05E9\u05D1\u05E8 \u05D0\u05D9 \u05E4\u05E2\u05DD \u05D1\u05DC\u05E2 \u05E2\u05D5\u05D1\u05E8 \u05D3\u05E8\u05DB\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010355
    m_Localized: "\u05DB\u05DC \u05DE\u05D4 \u05E9\u05D9\u05E9 \u05DC\u05E9\u05D1\u05E8 - \u05D1\u05D1\u05EA \u05D0\u05D7\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010356
    m_Localized: "\u05E8\u05D7\u05E4\u05E0\u05D9 \u05DC\u05D9\u05D5\u05D5\u05D9 \u05D5\u05E9\u05D3\u05D4 \u05D4\u05D6\u05DE\u05DF \u05E2\u05D5\u05D6\u05E8\u05D9\u05DD \u05DB\u05E9\u05D0\u05EA\u05DD \u05DE\u05D5\u05E6\u05E4\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010357
    m_Localized: "\u05D4\u05DE\u05E9\u05D9\u05DB\u05D5 \u05DC\u05D6\u05D5\u05D6, \u05D5\u05E9\u05DE\u05E8\u05D5 \u05E4\u05E6\u05E6\u05EA \u05E0\u05D5\u05D1\u05D4 \u05DC\u05E8\u05D2\u05E2 \u05D4\u05E7\u05E9\u05D4 \u05D1\u05D9\u05D5\u05EA\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010358
    m_Localized: "\u05D4\u05E9\u05E2\u05E8 \u05E4\u05D5\u05E7\u05D7 \u05D0\u05EA \u05E2\u05D9\u05E0\u05D5. \u05DE\u05D9 \u05E9\u05D1\u05E0\u05D4 \u05D0\u05D5\u05EA\u05D5 \u05D4\u05E9\u05D0\u05D9\u05E8 \u05D0\u05D7\u05E8\u05D9\u05D5 \u05E9\u05D5\u05DE\u05E8 - \u05D5\u05D4\u05D5\u05D0 \u05DE\u05D7\u05DB\u05D4 \u05DB\u05D1\u05E8 \u05D6\u05DE\u05DF \u05E8\u05D1 \u05DE\u05D0\u05D5\u05D3."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010359
    m_Localized: "\u05D4\u05D1\u05D5\u05E1 \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF: \u05E9\u05D5\u05DE\u05E8 \u05D4\u05E9\u05E2\u05E8, \u05D1\u05D0\u05E8\u05D1\u05E2\u05D4 \u05E9\u05DC\u05D1\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010360
    m_Localized: "\u05E9\u05D5\u05DE\u05E8 \u05D4\u05E9\u05E2\u05E8 \u05DE\u05D7\u05D6\u05D9\u05E7 \u05D1\u05DE\u05E8\u05DB\u05D6 \u05D4\u05D2\u05D6\u05E8\u05D4 - \u05D0\u05DC \u05EA\u05D8\u05D5\u05E1\u05D5 \u05DC\u05EA\u05D5\u05DB\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010361
    m_Localized: "\u05DB\u05DC \u05E9\u05DC\u05D1 \u05DE\u05D1\u05D9\u05D0 \u05DE\u05E9\u05D4\u05D5 \u05D7\u05D3\u05E9. \u05E9\u05D9\u05DE\u05D5 \u05DC\u05D1 \u05DC\u05E7\u05D5\u05D5\u05D9 \u05D0\u05D6\u05D4\u05E8\u05D4 \u05D5\u05DC\u05D8\u05D1\u05E2\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6247904089010362
