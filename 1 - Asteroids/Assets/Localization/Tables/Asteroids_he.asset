  - m_Id: 839971063
    m_Localized: "\u05D4\u05D7\u05DC\u05DC \u05D4\u05E2\u05DE\u05D5\u05E7"
    m_Metadata:
      m_Items: []
  - m_Id: 839971064
    m_Localized: "\u05D2\u05DC\u05D9\u05DD \u05D0\u05D9\u05E0\u05E1\u05D5\u05E4\u05D9\u05D9\u05DD \u05D3\u05E8\u05DA \u05DB\u05DC \u05D4\u05D2\u05D6\u05E8\u05D5\u05EA, \u05E2\u05DD \u05D1\u05D5\u05E1 \u05D1\u05DB\u05DC \u05E2\u05E9\u05E8\u05D4 \u05D2\u05DC\u05D9\u05DD. \u05E2\u05D3 \u05DC\u05D0\u05DF \u05EA\u05D2\u05D9\u05E2\u05D5?"
    m_Metadata:
      m_Items: []
  - m_Id: 839971065
    m_Localized: "\u05D4\u05D9\u05E9\u05E8\u05D3\u05D5\u05EA \u05D0\u05D9\u05E0\u05E1\u05D5\u05E4\u05D9\u05EA. \u05D4\u05E0\u05D9\u05E7\u05D5\u05D3 \u05D5\u05D4\u05D2\u05DC \u05D4\u05D8\u05D5\u05D1\u05D9\u05DD \u05D1\u05D9\u05D5\u05EA\u05E8 \u05E9\u05DC\u05DB\u05DD \u05E0\u05E9\u05DE\u05E8\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971066
    m_Localized: "\u05D4\u05D2\u05DC\u05D9\u05DD \u05DE\u05DE\u05E9\u05D9\u05DB\u05D9\u05DD \u05DC\u05D4\u05D2\u05D9\u05E2 \u05D5\u05DC\u05D2\u05D3\u05D5\u05DC. \u05D1\u05D5\u05E1\u05D9\u05DD \u05DE\u05D2\u05D9\u05E2\u05D9\u05DD \u05D1\u05DB\u05DC \u05E2\u05E9\u05E8\u05D4 \u05D2\u05DC\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971067
    m_Localized: "\u05D0\u05D5\u05E8 \u05E8\u05D0\u05E9\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 839971068
    m_Localized: "\u05D4\u05E1\u05D9\u05D5\u05E8 \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF \u05E9\u05DC\u05DB\u05DD \u05D1\u05D7\u05D2\u05D5\u05E8\u05EA \u05E7\u05E4\u05DC\u05E8. \u05E0\u05E4\u05E6\u05D5 \u05D0\u05EA \u05D4\u05E1\u05DC\u05E2\u05D9\u05DD \u05D4\u05E0\u05E1\u05D7\u05E4\u05D9\u05DD \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05DD \u05D9\u05E0\u05E4\u05E6\u05D5 \u05D0\u05EA\u05DB\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971069
    m_Localized: "\u05E1\u05DC\u05E2\u05D9\u05DD \u05D2\u05D3\u05D5\u05DC\u05D9\u05DD \u05DE\u05EA\u05E4\u05E6\u05DC\u05D9\u05DD \u05DC\u05E7\u05D8\u05E0\u05D9\u05DD \u05D5\u05DE\u05D4\u05D9\u05E8\u05D9\u05DD \u05D9\u05D5\u05EA\u05E8. \u05D9\u05E8\u05D5 \u05D1\u05EA\u05E8\u05DE\u05D9\u05DC\u05D9 \u05D0\u05E1\u05E4\u05E7\u05D4 \u05DC\u05E9\u05D3\u05E8\u05D5\u05D2\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971070
    m_Localized: "W / \u05DC\u05DE\u05E2\u05DC\u05D4 \u05DC\u05D3\u05D7\u05E3, A D / \u05E9\u05DE\u05D0\u05DC\u05D4 \u05D9\u05DE\u05D9\u05E0\u05D4 \u05DC\u05E4\u05E0\u05D9\u05D9\u05D4, \u05E8\u05D5\u05D5\u05D7 \u05DC\u05D9\u05E8\u05D9."
    m_Metadata:
      m_Items: []
  - m_Id: 839971071
    m_Localized: "\u05E1\u05DC\u05E2\u05D9\u05DD \u05D2\u05D3\u05D5\u05DC\u05D9\u05DD \u05DE\u05EA\u05E4\u05E6\u05DC\u05D9\u05DD \u05DC\u05E9\u05E0\u05D9\u05D9\u05DD - \u05D4\u05E7\u05D8\u05E0\u05D9\u05DD \u05E9\u05D5\u05D5\u05D9\u05DD \u05D4\u05DB\u05D9 \u05D4\u05E8\u05D1\u05D4 \u05E0\u05E7\u05D5\u05D3\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 839971072
    m_Localized: "\u05D9\u05E8\u05D5 \u05D1\u05EA\u05E8\u05DE\u05D9\u05DC\u05D9 \u05D4\u05D0\u05E1\u05E4\u05E7\u05D4 \u05D4\u05D9\u05E8\u05D5\u05E7\u05D9\u05DD \u05DC\u05E9\u05D3\u05E8\u05D5\u05D2\u05D9 \u05E0\u05E9\u05E7 \u05D5\u05DE\u05D2\u05E0\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971073
    m_Localized: "SHIFT \u05DE\u05D6\u05E0\u05E7 \u05D3\u05E8\u05DA \u05D4\u05E1\u05DB\u05E0\u05D4. \u05D4\u05E9\u05DE\u05D3\u05D5\u05EA \u05D1\u05E8\u05E6\u05E3 \u05D1\u05D5\u05E0\u05D5\u05EA \u05E7\u05D5\u05DE\u05D1\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 839971074
    m_Localized: "\u05D4\u05D0\u05D2\u05D5\u05D3\u05DC \u05D4\u05E9\u05DE\u05D0\u05DC\u05D9 \u05DE\u05E0\u05D5\u05D5\u05D8 \u05D5\u05D3\u05D5\u05D7\u05E3 \u05DC\u05DB\u05D9\u05D5\u05D5\u05DF \u05E9\u05D0\u05DC\u05D9\u05D5 \u05D4\u05D5\u05D0 \u05DE\u05E6\u05D1\u05D9\u05E2. \u05D4\u05D7\u05D6\u05D9\u05E7\u05D5 \u05D9\u05E8\u05D9 \u05DB\u05D3\u05D9 \u05DC\u05D9\u05E8\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 839971075
    m_Localized: "\u05D6\u05D9\u05E0\u05D5\u05E7 \u05E4\u05D5\u05E8\u05E5 \u05D3\u05E8\u05DA \u05D4\u05E1\u05DB\u05E0\u05D4. \u05D4\u05E9\u05DE\u05D3\u05D5\u05EA \u05D1\u05E8\u05E6\u05E3 \u05D1\u05D5\u05E0\u05D5\u05EA \u05E7\u05D5\u05DE\u05D1\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 839971076
    m_Localized: "\u05D1\u05D4\u05DC\u05EA \u05D4\u05E2\u05E4\u05E8\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 839971077
    m_Localized: "\u05E1\u05DC\u05E2\u05D9 \u05E2\u05E4\u05E8\u05D4 \u05E2\u05DD \u05E2\u05D5\u05E8\u05E7\u05D9 \u05D6\u05D4\u05D1 \u05E0\u05E1\u05D7\u05E4\u05D9\u05DD \u05D1\u05D7\u05D2\u05D5\u05E8\u05D4. \u05E4\u05E6\u05D7\u05D5 \u05D0\u05D5\u05EA\u05DD \u05D5\u05D0\u05E1\u05E4\u05D5 \u05D0\u05EA \u05D4\u05D2\u05D1\u05D9\u05E9\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971078
    m_Localized: "\u05E1\u05DC\u05E2\u05D9 \u05E2\u05E4\u05E8\u05D4: \u05E7\u05E9\u05D5\u05D7\u05D9\u05DD \u05D9\u05D5\u05EA\u05E8 \u05D5\u05DE\u05DC\u05D0\u05D9\u05DD \u05D1\u05D2\u05D1\u05D9\u05E9\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971079
    m_Localized: "\u05E1\u05DC\u05E2\u05D9 \u05E2\u05E4\u05E8\u05D4 \u05E1\u05D5\u05E4\u05D2\u05D9\u05DD \u05D9\u05D5\u05EA\u05E8 \u05E4\u05D2\u05D9\u05E2\u05D5\u05EA \u05D0\u05D1\u05DC \u05DE\u05E9\u05D0\u05D9\u05E8\u05D9\u05DD \u05D2\u05D1\u05D9\u05E9\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971080
    m_Localized: "\u05D2\u05D1\u05D9\u05E9\u05D9\u05DD \u05E0\u05DE\u05E9\u05DB\u05D9\u05DD \u05D0\u05DC\u05D9\u05DB\u05DD \u05DB\u05E9\u05D0\u05EA\u05DD \u05D8\u05E1\u05D9\u05DD \u05E7\u05E8\u05D5\u05D1."
    m_Metadata:
      m_Items: []
  - m_Id: 839971081
    m_Localized: "\u05D8\u05D9\u05D8\u05D0\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 839971082
    m_Localized: "\u05DE\u05E9\u05D4\u05D5 \u05E2\u05E6\u05D5\u05DD \u05E0\u05E2 \u05D1\u05D7\u05D2\u05D5\u05E8\u05D4 \u05D5\u05DE\u05E9\u05D9\u05E8 \u05E1\u05DC\u05E2\u05D9\u05DD \u05D1\u05D3\u05E8\u05DB\u05D5. \u05D4\u05E9\u05DE\u05D9\u05D3\u05D5 \u05D0\u05D5\u05EA\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 839971083
    m_Localized: "\u05D4\u05D1\u05D5\u05E1 \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF \u05E9\u05DC\u05DB\u05DD: \u05D8\u05D9\u05D8\u05D0\u05DF \u05D4\u05E1\u05DC\u05E2."
    m_Metadata:
      m_Items: []
  - m_Id: 839971084
    m_Localized: "\u05D1\u05D5\u05E1\u05D9\u05DD \u05E1\u05D5\u05E4\u05D2\u05D9\u05DD \u05E4\u05D2\u05D9\u05E2\u05D5\u05EA \u05E8\u05D1\u05D5\u05EA \u05D5\u05E0\u05E2\u05E9\u05D9\u05DD \u05D6\u05D5\u05E2\u05DE\u05D9\u05DD \u05D9\u05D5\u05EA\u05E8 \u05DB\u05DB\u05DC \u05E9\u05D4\u05DD \u05E0\u05D7\u05DC\u05E9\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971085
    m_Localized: "\u05D4\u05DE\u05E9\u05D9\u05DB\u05D5 \u05DC\u05D6\u05D5\u05D6 - \u05D4\u05D8\u05D9\u05D8\u05D0\u05DF \u05D6\u05D5\u05E8\u05E7 \u05E1\u05DC\u05E2\u05D9\u05DD \u05D5\u05E8\u05E1\u05D9\u05E1\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971086
    m_Localized: "\u05D7\u05D9\u05DE\u05D5\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 839971087
    m_Localized: "\u05E9\u05D3\u05D4 \u05DE\u05D5\u05E7\u05E9\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 839971088
    m_Localized: "\u05E9\u05D5\u05D3\u05D3\u05D9\u05DD \u05D6\u05E8\u05E2\u05D5 \u05DE\u05D5\u05E7\u05E9\u05D9 \u05E7\u05E8\u05D1\u05D4 \u05D1\u05DE\u05E8\u05D7\u05D1 \u05D4\u05D0\u05E8\u05D2\u05DE\u05E0\u05D9. \u05E4\u05E0\u05D5 \u05D0\u05EA \u05D4\u05E1\u05DC\u05E2\u05D9\u05DD \u05D1\u05DC\u05D9 \u05DC\u05D4\u05E4\u05E2\u05D9\u05DC \u05D0\u05D5\u05EA\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971089
    m_Localized: "\u05DE\u05D5\u05E7\u05E9\u05D9 \u05E7\u05E8\u05D1\u05D4 \u05E0\u05D3\u05E8\u05DB\u05D9\u05DD \u05DB\u05E9\u05DE\u05EA\u05E7\u05E8\u05D1\u05D9\u05DD \u05D0\u05DC\u05D9\u05D4\u05DD. \u05D4\u05E4\u05D9\u05E6\u05D5\u05E5 \u05E9\u05DC\u05D4\u05DD \u05E9\u05D5\u05D1\u05E8 \u05D2\u05DD \u05E1\u05DC\u05E2\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971090
    m_Localized: "\u05DE\u05D5\u05E7\u05E9\u05D9\u05DD \u05E0\u05D3\u05E8\u05DB\u05D9\u05DD \u05DB\u05E9\u05DE\u05EA\u05E7\u05E8\u05D1\u05D9\u05DD - \u05D4\u05EA\u05E8\u05D7\u05E7\u05D5 \u05D0\u05D5 \u05D9\u05E8\u05D5 \u05D1\u05D4\u05DD \u05DE\u05E8\u05D7\u05D5\u05E7."
    m_Metadata:
      m_Items: []
  - m_Id: 839971091
    m_Localized: "\u05E4\u05D9\u05E6\u05D5\u05E5 \u05E9\u05DC \u05DE\u05D5\u05E7\u05E9 \u05DE\u05E9\u05DE\u05D9\u05D3 \u05E1\u05DC\u05E2\u05D9\u05DD \u05E1\u05DE\u05D5\u05DB\u05D9\u05DD: \u05E0\u05E6\u05DC\u05D5 \u05D0\u05EA \u05D6\u05D4!"
    m_Metadata:
      m_Items: []
  - m_Id: 839971092
    m_Localized: "\u05DE\u05E8\u05D5\u05E5 \u05D4\u05DE\u05D0\u05D2\u05DE\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 839971093
    m_Localized: "\u05E1\u05DC\u05E2\u05D9\u05DD \u05DE\u05D5\u05EA\u05DB\u05D9\u05DD \u05DE\u05E2\u05D5\u05DC\u05DD \u05DE\u05E0\u05D5\u05E4\u05E5. \u05D4\u05DD \u05DE\u05EA\u05E4\u05D5\u05E6\u05E6\u05D9\u05DD \u05DB\u05E9\u05DE\u05E9\u05DE\u05D9\u05D3\u05D9\u05DD \u05D0\u05D5\u05EA\u05DD, \u05D5\u05E9\u05D1\u05D9\u05D8\u05D9\u05DD \u05D7\u05D5\u05E6\u05D9\u05DD \u05D0\u05EA \u05D4\u05D2\u05D6\u05E8\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 839971094
    m_Localized: "\u05E1\u05DC\u05E2\u05D9 \u05DE\u05D0\u05D2\u05DE\u05D4 \u05DE\u05EA\u05E4\u05D5\u05E6\u05E6\u05D9\u05DD. \u05E9\u05D1\u05D9\u05D8\u05D9\u05DD \u05D7\u05D5\u05E6\u05D9\u05DD \u05D0\u05EA \u05D4\u05D2\u05D6\u05E8\u05D4 \u05D0\u05D7\u05E8\u05D9 \u05D0\u05D6\u05D4\u05E8\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 839971095
    m_Localized: "\u05E1\u05DC\u05E2\u05D9 \u05DE\u05D0\u05D2\u05DE\u05D4 \u05DE\u05EA\u05E4\u05D5\u05E6\u05E6\u05D9\u05DD - \u05E9\u05DE\u05E8\u05D5 \u05DE\u05E8\u05D7\u05E7 \u05DB\u05E9\u05D0\u05EA\u05DD \u05DE\u05E4\u05D5\u05E6\u05E6\u05D9\u05DD \u05D0\u05D5\u05EA\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971096
    m_Localized: "\u05E0\u05EA\u05D9\u05D1 \u05D0\u05D3\u05D5\u05DD \u05DE\u05D6\u05D4\u05D9\u05E8 \u05DE\u05E4\u05E0\u05D9 \u05E9\u05D1\u05D9\u05D8 \u05DE\u05EA\u05E7\u05E8\u05D1. \u05D6\u05D5\u05D6\u05D5 \u05DE\u05D3\u05E8\u05DB\u05D5!"
    m_Metadata:
      m_Items: []
  - m_Id: 839971097
    m_Localized: "\u05E1\u05E4\u05D9\u05E0\u05EA \u05D4\u05D0\u05DD \u05E9\u05DC \u05D4\u05E9\u05D5\u05D3\u05D3\u05D9\u05DD"
    m_Metadata:
