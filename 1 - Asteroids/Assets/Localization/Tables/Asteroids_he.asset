  - m_Id: 839970847
    m_Localized: "\u05D4\u05D0\u05E8\u05E0\u05E7 \u05E9\u05DC\u05DA \u05DE\u05DC\u05D0, \u05D8\u05D9\u05D9\u05E1. \u05EA\u05D1\u05D6\u05D1\u05D6 \u05E7\u05D5\u05D3\u05DD \u05DE\u05E9\u05D4\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 839970848
    m_Localized: "\u05E0\u05DE\u05DB\u05E8 \u05EA\u05DE\u05D5\u05E8\u05EA ${0:N0}. \u05EA\u05E2\u05E0\u05D5\u05D2 \u05DC\u05E2\u05E9\u05D5\u05EA \u05D0\u05D9\u05EA\u05DA \u05E2\u05E1\u05E7\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839970849
    m_Localized: "\u05D0\u05E0\u05D9 \u05E7\u05D5\u05E0\u05D4 \u05E8\u05E7 \u05DE\u05D2\u05E0\u05D9\u05DD \u05E9\u05DC\u05DE\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839970850
    m_Localized: "\u05D0\u05EA \u05D6\u05D4 \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC \u05DC\u05E7\u05E0\u05D5\u05EA \u05DE\u05DE\u05DA."
    m_Metadata:
      m_Items: []
  - m_Id: 839970851
    m_Localized: "\u05D7\u05E1\u05E8 \u05DC\u05DA \u05DB\u05E1\u05E3? \u05E6\u05D0 \u05DC\u05DE\u05E9\u05D9\u05DE\u05D4 \u05D5\u05EA\u05D7\u05D6\u05D5\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 839970852
    m_Localized: "\u05D1\u05E8\u05D5\u05DA \u05E9\u05D5\u05D1\u05DA. \u05DC\u05EA\u05E7\u05DF \u05DC\u05DA \u05D0\u05EA \u05D4\u05D2\u05D5\u05E3?"
    m_Metadata:
      m_Items: []
  - m_Id: 839970853
    m_Localized: "\u05D1\u05E8\u05D5\u05DA \u05E9\u05D5\u05D1\u05DA, \u05D8\u05D9\u05D9\u05E1. \u05DE\u05D4 \u05D9\u05D4\u05D9\u05D4?"
    m_Metadata:
      m_Items: []
  - m_Id: 839970854
    m_Localized: "\u05DE\u05E7\u05DC\u05E2 MG21 \u05E8\u05D9\u05D1\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 839970855
    m_Localized: "\u05D6\u05D5\u05D2 \u05DE\u05E7\u05DC\u05E2\u05D9 \u05DB\u05E0\u05E3. \u05DB\u05DC \u05D8\u05D9\u05D9\u05E1 \u05D8\u05E1 \u05D0\u05D9\u05EA\u05DD \u05D5\u05D0\u05E3 \u05E4\u05E2\u05DD \u05DC\u05D0 \u05DE\u05D0\u05D1\u05D3 \u05D0\u05D5\u05EA\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839970856
    m_Localized: "\u05EA\u05D5\u05EA\u05D7 \u05E4\u05DC\u05D6\u05DE\u05D4 \u05E4\u05D9\u05D9\u05E8\u05E1\u05D8\u05D5\u05E8\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 839970857
    m_Localized: "\u05E7\u05DC\u05D9\u05E2 \u05DE\u05E8\u05DB\u05D6\u05D9 \u05DB\u05D1\u05D3 \u05E9\u05D7\u05D5\u05E8\u05DA \u05DB\u05DC\u05D9 \u05D8\u05D9\u05E1. \u05E4\u05D5\u05E2\u05DC \u05EA\u05DE\u05D9\u05D3. \u05D0\u05D5\u05D5\u05D9\u05E8 \u05D1\u05DC\u05D1\u05D3."
    m_Metadata:
      m_Items: []
  - m_Id: 839970858
    m_Localized: "\u05DE\u05E9\u05D2\u05E8 \u05DE\u05D9\u05E7\u05E8\u05D5-\u05D8\u05D9\u05DC\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 839970859
    m_Localized: "\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DC \u05D8\u05D9\u05DC\u05D9\u05DD \u05E7\u05D8\u05E0\u05D9\u05DD \u05D5\u05DE\u05D4\u05D9\u05E8\u05D9\u05DD \u05D0\u05DC \u05DE\u05D8\u05E8\u05D5\u05EA \u05D0\u05D5\u05D5\u05D9\u05E8 \u05D5\u05E7\u05E8\u05E7\u05E2. \u05E4\u05D5\u05E2\u05DC \u05EA\u05DE\u05D9\u05D3."
    m_Metadata:
      m_Items: []
  - m_Id: 839970860
    m_Localized: "\u05E8\u05E7\u05D8\u05D5\u05EA DM1R \u05E4\u05E1\u05D9\u05D9\u05DB\u05D5"
    m_Metadata:
      m_Items: []
  - m_Id: 839970861
    m_Localized: "\u05D4\u05D8\u05D9\u05DC\u05D9\u05DD \u05E0\u05D5\u05E9\u05E8\u05D9\u05DD \u05DC\u05E6\u05D3\u05D3\u05D9\u05DD, \u05E0\u05D9\u05E6\u05EA\u05D9\u05DD \u05D5\u05E0\u05D5\u05E8\u05D9\u05DD \u05E7\u05D3\u05D9\u05DE\u05D4. \u05D0\u05D5\u05D5\u05D9\u05E8 \u05D5\u05E7\u05E8\u05E7\u05E2."
    m_Metadata:
      m_Items: []
  - m_Id: 839970862
    m_Localized: "\u05DE\u05D9\u05E0\u05D9-\u05D2\u05D0\u05DF \u05E2\u05D5\u05E7\u05D1 TH19 \u05EA'\u05D5\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 839970863
    m_Localized: "\u05DE\u05E7\u05DC\u05E2 \u05DE\u05E1\u05EA\u05D5\u05D1\u05D1 \u05E9\u05E2\u05D5\u05E7\u05D1 \u05D0\u05D7\u05E8 \u05DE\u05D8\u05E8\u05D4 \u05D0\u05E7\u05E8\u05D0\u05D9\u05EA \u05D1\u05D0\u05D5\u05D5\u05D9\u05E8 \u05D0\u05D5 \u05D1\u05E7\u05E8\u05E7\u05E2."
    m_Metadata:
      m_Items: []
  - m_Id: 839970864
    m_Localized: "\u05E6\u05E8\u05D9\u05D7 \u05DC\u05D9\u05D9\u05D6\u05E8 OD55 \u05D0\u05D5\u05D3\u05D9\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 839970865
    m_Localized: "\u05E4\u05D5\u05D2\u05E2 \u05D1\u05DB\u05DC\u05D9 \u05D8\u05D9\u05E1 \u05D0\u05E7\u05E8\u05D0\u05D9 \u05E2\u05DC \u05D4\u05DE\u05E1\u05DA. \u05DC\u05D0 \u05DE\u05D7\u05D8\u05D9\u05D0 \u05DC\u05E2\u05D5\u05DC\u05DD. \u05D0\u05D5\u05D5\u05D9\u05E8 \u05D1\u05DC\u05D1\u05D3."
    m_Metadata:
      m_Items: []
  - m_Id: 839970866
    m_Localized: "\u05EA\u05E8\u05DE\u05D9\u05DC\u05D9 \u05D8\u05D9\u05DC\u05D9\u05DD AARL-1201"
    m_Metadata:
      m_Items: []
  - m_Id: 839970867
    m_Localized: "\u05D6\u05D5\u05D2\u05D5\u05EA \u05D8\u05D9\u05DC\u05D9\u05DD \u05DE\u05D4\u05D9\u05E8\u05D9\u05DD \u05DE\u05D0\u05D5\u05D3 \u05E9\u05E7\u05D5\u05E8\u05E2\u05D9\u05DD \u05DB\u05DC\u05D9 \u05D8\u05D9\u05E1. \u05D0\u05D5\u05D5\u05D9\u05E8 \u05D1\u05DC\u05D1\u05D3."
