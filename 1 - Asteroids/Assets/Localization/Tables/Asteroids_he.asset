    m_Localized: "\u05E6\u05E8\u05E2\u05D5\u05EA \u05E8\u05D5\u05D3\u05E4\u05D5\u05EA \u05D0\u05D7\u05E8\u05D9\u05DB\u05DD - \u05D9\u05E8\u05D5 \u05D1\u05D4\u05DF \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05DF \u05DE\u05D2\u05D9\u05E2\u05D5\u05EA."
