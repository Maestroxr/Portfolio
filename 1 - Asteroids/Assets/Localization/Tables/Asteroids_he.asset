  - m_Id: 6219435162529822
    m_Localized: "\u05E1\u05E4\u05D9\u05E0\u05EA \u05D4\u05D3\u05D2\u05D9\u05E8\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529823
    m_Localized: "\u05D0\u05DD \u05D4\u05DB\u05D5\u05D5\u05E8\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529824
    m_Localized: "\u05E4\u05EA\u05D9\u05D7\u05D4 \u05E7\u05E4\u05D5\u05D0\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529825
    m_Localized: "\u05D4\u05E6\u05DC \u05D0\u05D9\u05E0\u05E0\u05D5, \u05D5\u05E6\u05D9 \u05D4\u05DE\u05DC\u05D7\u05DE\u05D4 \u05E9\u05DC \u05EA\u05D0\u05D2\u05D9\u05D3 \u05E7\u05E8\u05D0\u05E0\u05DE\u05D0\u05E8\u05E7 \u05D1\u05D0 \u05DC\u05E7\u05D7\u05EA \u05D0\u05EA \u05DE\u05D4 \u05E9\u05D4\u05E9\u05D0\u05D9\u05E8. \u05D4\u05E9\u05D9\u05D9\u05E8\u05D5\u05EA \u05E9\u05DC\u05D5 \u05DE\u05E4\u05E9\u05D9\u05D8\u05D5\u05EA \u05D0\u05EA \u05D4\u05E7\u05E8\u05D7 \u05E9\u05DC \u05D1\u05D5\u05E8\u05D9\u05D0\u05E1: \u05E2\u05E6\u05E8\u05D5 \u05D0\u05EA \u05DE\u05D5\u05D1\u05D9\u05DC \u05D4\u05E7\u05E8\u05D7\u05D5\u05E0\u05D9\u05DD \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D9\u05D2\u05D9\u05E2 \u05DC\u05D7\u05D5\u05E3."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529826
    m_Localized: "\u05D2\u05D0\u05D5\u05EA \u05D4\u05D1\u05E8\u05D6\u05DC: \u05E0\u05D7\u05D9\u05DC\u05D9\u05DD \u05E9\u05DC \u05E8\u05D7\u05E4\u05E0\u05D9 \u05EA\u05E7\u05D9\u05E4\u05D4, \u05D5\u05D0\u05EA\u05E8\u05D9 \u05D8\u05D9\u05DC\u05D9 \u05E7\u05E8\u05E7\u05E2-\u05D0\u05D5\u05D5\u05D9\u05E8 \u05E9\u05D4\u05E8\u05E7\u05D8\u05D5\u05EA \u05E9\u05DC\u05D4\u05DD \u05DE\u05E1\u05EA\u05D5\u05D1\u05D1\u05D5\u05EA \u05D0\u05D7\u05E8\u05D9\u05DB\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529827
    m_Localized: "\u05E0\u05D7\u05D9\u05DC \u05E8\u05D7\u05E4\u05E0\u05D9\u05DD \u05D8\u05E1 \u05DC\u05D5\u05DC\u05D0\u05D4 \u05D0\u05D7\u05E8\u05D9 \u05DC\u05D5\u05DC\u05D0\u05D4: \u05D8\u05D0\u05D8\u05D0\u05D5 \u05D0\u05D5\u05EA\u05D5 \u05D1\u05DE\u05E7\u05DC\u05E2."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529828
    m_Localized: "\u05E8\u05E7\u05D8\u05D5\u05EA \u05DE\u05D1\u05D9\u05D9\u05EA\u05D5\u05EA \u05DE\u05E1\u05EA\u05D5\u05D1\u05D1\u05D5\u05EA \u05D0\u05D7\u05E8\u05D9\u05DB\u05DD \u05E8\u05E7 \u05DC\u05E8\u05D2\u05E2: \u05DE\u05E9\u05DB\u05D5 \u05D0\u05D5\u05EA\u05DF \u05D4\u05E6\u05D9\u05D3\u05D4, \u05D5\u05D0\u05D6 \u05D4\u05EA\u05D7\u05DE\u05E7\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529829
    m_Localized: "\u05D4\u05DB\u05D5\u05E8 \u05E9\u05DC \u05D4\u05DE\u05D5\u05D1\u05D9\u05DC \u05DE\u05E9\u05D5\u05E8\u05D9\u05D9\u05DF \u05E2\u05D3 \u05E9\u05D4\u05E6\u05E8\u05D9\u05D7\u05D9\u05DD \u05D5\u05D4\u05DE\u05E9\u05D2\u05E8\u05D9\u05DD \u05E9\u05DC\u05D5 \u05E0\u05D5\u05E4\u05DC\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529830
    m_Localized: "\u05E1\u05D5\u05E4\u05EA \u05DC\u05D5\u05D1\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529831
    m_Localized: "\u05D1\u05D7\u05D2\u05D5\u05E8\u05EA \u05D4\u05E1\u05D5\u05E4\u05D5\u05EA \u05D4\u05EA\u05D0\u05D2\u05D9\u05D3 \u05D4\u05EA\u05D1\u05E6\u05E8 \u05E2\u05DD \u05D4\u05EA\u05D5\u05EA\u05D7\u05D9\u05DD \u05E9\u05DC\u05D5. \u05D0\u05E8\u05D8\u05D9\u05DC\u05E8\u05D9\u05D4 \u05DE\u05E4\u05D2\u05D9\u05D6\u05D4 \u05D0\u05EA \u05D4\u05E9\u05DE\u05D9\u05D9\u05DD \u05DE\u05E2\u05DC \u05E9\u05D3\u05D5\u05EA \u05D4\u05E7\u05E8\u05D7, \u05D5\u05D4\u05D5\u05DC\u05DB\u05E0\u05D9\u05DD \u05DE\u05E1\u05D9\u05D9\u05E8\u05D9\u05DD \u05D1\u05D3\u05E8\u05DB\u05D9\u05DD \u05D0\u05DC \u05E1\u05D5\u05DC\u05DC\u05EA \u05D4\u05DB\u05E4\u05D5\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529832
    m_Localized: "\u05E4\u05D2\u05D6\u05D9 \u05D0\u05E8\u05D8\u05D9\u05DC\u05E8\u05D9\u05D4 \u05DE\u05EA\u05E4\u05D5\u05E6\u05E6\u05D9\u05DD \u05D0\u05D9\u05E4\u05D4 \u05E9\u05D4\u05D9\u05D9\u05EA\u05DD: \u05D8\u05D1\u05E2\u05EA \u05D0\u05D3\u05D5\u05DE\u05D4 \u05DE\u05E1\u05DE\u05E0\u05EA \u05D0\u05EA \u05D4\u05DE\u05E7\u05D5\u05DD. \u05D4\u05D5\u05DC\u05DB\u05E0\u05D9\u05DD \u05E6\u05D5\u05E2\u05D3\u05D9\u05DD \u05DC\u05D0\u05D5\u05E8\u05DA \u05D4\u05D3\u05E8\u05DB\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529833
    m_Localized: "\u05DB\u05E9\u05E0\u05E4\u05EA\u05D7\u05EA \u05DE\u05EA\u05D7\u05EA\u05D9\u05DB\u05DD \u05D8\u05D1\u05E2\u05EA \u05D0\u05D3\u05D5\u05DE\u05D4, \u05D6\u05D5\u05D6\u05D5: \u05D4\u05E4\u05D2\u05D6 \u05E0\u05D5\u05D7\u05EA \u05DB\u05E9\u05D4\u05D9\u05D0 \u05E0\u05E1\u05D2\u05E8\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529834
    m_Localized: "\u05D8\u05D9\u05DC\u05D9 \u05E7\u05E8\u05E7\u05E2 \u05D5\u05E4\u05E6\u05E6\u05D5\u05EA \u05DE\u05D7\u05E1\u05DC\u05D9\u05DD \u05D0\u05E8\u05D8\u05D9\u05DC\u05E8\u05D9\u05D4 \u05D1\u05DE\u05D4\u05D9\u05E8\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529835
    m_Localized: "\u05DB\u05D9\u05E4\u05EA \u05D4\u05DE\u05DB\"\u05DD \u05E9\u05DC \u05D4\u05E1\u05D5\u05DC\u05DC\u05D4 \u05DE\u05E9\u05D5\u05E8\u05D9\u05D9\u05E0\u05EA \u05E2\u05D3 \u05E9\u05D4\u05D4\u05D5\u05D1\u05D9\u05E6\u05E8\u05D9\u05DD \u05D5\u05D4\u05DE\u05E9\u05D2\u05E8\u05D9\u05DD \u05E9\u05DC\u05D4 \u05E0\u05D5\u05E4\u05DC\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529836
    m_Localized: "\u05E7\u05E8\u05D7 \u05E1\u05D7\u05E3"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529837
    m_Localized: "\u05E9\u05D5\u05D1\u05E8\u05EA \u05D4\u05E7\u05E8\u05D7 \u05E9\u05DC \u05D4\u05E6\u05D9 \u05D7\u05D5\u05E6\u05D1\u05EA \u05EA\u05E2\u05DC\u05D4 \u05D0\u05DC \u05D4\u05D9\u05DD \u05D4\u05E4\u05EA\u05D5\u05D7. \u05DE\u05E9\u05D7\u05EA\u05D5\u05EA \u05E9\u05D5\u05DC\u05D8\u05D5\u05EA \u05D1\u05DE\u05E2\u05D1\u05E8\u05D9\u05DD \u05E9\u05D1\u05D9\u05DF \u05D2\u05D5\u05E9\u05D9 \u05D4\u05E7\u05E8\u05D7 \u05D5\u05E1\u05D9\u05D9\u05E8\u05D5\u05EA \u05D8\u05D9\u05DC\u05D9\u05DD \u05D7\u05D2\u05D5\u05EA \u05DE\u05E2\u05DC\u05D9\u05D4\u05DF. \u05D4\u05D8\u05D1\u05D9\u05E2\u05D5 \u05D0\u05EA \u05E9\u05D5\u05D1\u05E8\u05EA \u05D4\u05E7\u05E8\u05D7."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529838
    m_Localized: "\u05E7\u05E8\u05D7 \u05E1\u05D7\u05E3: \u05DE\u05E9\u05D7\u05EA\u05D5\u05EA \u05E9\u05D8\u05D5\u05EA \u05D1\u05DE\u05E2\u05D1\u05E8\u05D9\u05DD, \u05D5\u05EA\u05D5\u05EA\u05D7\u05D9\u05DD \u05E2\u05D5\u05DE\u05D3\u05D9\u05DD \u05E2\u05DC \u05D2\u05D5\u05E9\u05D9 \u05D4\u05E7\u05E8\u05D7. \u05E1\u05D9\u05D9\u05E8\u05D5\u05EA \u05D8\u05D9\u05DC\u05D9\u05DD \u05D9\u05D5\u05E8\u05D5\u05EA \u05E8\u05E7\u05D8\u05D5\u05EA \u05DE\u05D1\u05D9\u05D9\u05EA\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529839
    m_Localized: "\u05DE\u05E9\u05D7\u05EA\u05D5\u05EA \u05E7\u05E9\u05D5\u05D7\u05D5\u05EA: \u05E4\u05D2\u05E2\u05D5 \u05D1\u05D4\u05DF \u05D1\u05DB\u05DC \u05DE\u05D4 \u05E9\u05DE\u05D2\u05D9\u05E2 \u05DC\u05E7\u05E8\u05E7\u05E2."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529840
    m_Localized: "\u05E1\u05D9\u05D9\u05E8\u05EA \u05DE\u05E8\u05D7\u05E4\u05EA \u05D6\u05DE\u05DF \u05DE\u05D4 \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05D9\u05D0 \u05E2\u05D5\u05D6\u05D1\u05EA: \u05D4\u05E4\u05D9\u05DC\u05D5 \u05D0\u05D5\u05EA\u05D4 \u05D1\u05E9\u05D1\u05D9\u05DC \u05D4\u05D5\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529841
    m_Localized: "\u05D7\u05D5\u05E3 \u05D4\u05D0\u05DC\u05DE\u05D5\u05D2\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529842
    m_Localized: "\u05D4\u05D0\u05D9\u05D9\u05DD \u05E9\u05DC \u05EA\u05DC\u05E1\u05D4 \u05D4\u05DD \u05D4\u05E0\u05DE\u05DC \u05E9\u05DC \u05D4\u05EA\u05D0\u05D2\u05D9\u05D3 \u05D1\u05D3\u05E8\u05D5\u05DD. \u05D4\u05E1\u05D5\u05DC\u05DC\u05D5\u05EA \u05E9\u05DC\u05D5 \u05DE\u05E1\u05EA\u05EA\u05E8\u05D5\u05EA \u05EA\u05D7\u05EA \u05DB\u05D9\u05E4\u05D5\u05EA \u05DE\u05D2\u05DF, \u05D5\u05E0\u05D5\u05E9\u05D0\u05EA \u05D4\u05E1\u05E2\u05E8\u05D4 \u05DE\u05E9\u05D2\u05E8\u05EA \u05E0\u05D7\u05D9\u05DC\u05D9 \u05E8\u05D7\u05E4\u05E0\u05D9\u05DD \u05DE\u05EA\u05D5\u05DA \u05D4\u05E2\u05E0\u05E0\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529843
    m_Localized: "\u05DE\u05D7\u05D5\u05DC\u05DC\u05D9 \u05DE\u05D2\u05DF: \u05E9\u05D5\u05DD \u05D3\u05D1\u05E8 \u05DE\u05EA\u05D7\u05EA \u05DC\u05DB\u05D9\u05E4\u05D4 \u05E9\u05DC\u05D4\u05DD \u05DC\u05D0 \u05E0\u05E4\u05D2\u05E2 \u05DB\u05DC \u05E2\u05D5\u05D3 \u05D4\u05DD \u05E2\u05D5\u05DE\u05D3\u05D9\u05DD. \u05D9\u05E8\u05D5 \u05E7\u05D5\u05D3\u05DD \u05D1\u05DE\u05D7\u05D5\u05DC\u05DC."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529844
    m_Localized: "\u05D9\u05E8\u05D9\u05D5\u05EA \u05E8\u05E7 \u05DE\u05EA\u05D9\u05D6\u05D5\u05EA \u05E0\u05D9\u05E6\u05D5\u05E6\u05D5\u05EA \u05E2\u05DC \u05DE\u05D4 \u05E9\u05DB\u05D9\u05E4\u05D4 \u05DE\u05DB\u05E1\u05D4: \u05DE\u05E6\u05D0\u05D5 \u05D0\u05EA \u05D4\u05DE\u05D7\u05D5\u05DC\u05DC \u05E9\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529845
    m_Localized: "\u05D4\u05D4\u05D0\u05E0\u05D2\u05E8\u05D9\u05DD \u05E9\u05DC \u05D4\u05E0\u05D5\u05E9\u05D0\u05EA \u05DE\u05E9\u05D2\u05E8\u05D9\u05DD \u05E0\u05D7\u05D9\u05DC\u05D9\u05DD \u05E2\u05D3 \u05E9\u05D4\u05DD \u05DE\u05D5\u05E9\u05DE\u05D3\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529846
    m_Localized: "\u05DE\u05E8\u05D5\u05E5 \u05D4\u05DC\u05D2\u05D5\u05E0\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529847
    m_Localized: "\u05E9\u05D9\u05D9\u05E8\u05D5\u05EA \u05D7\u05D5\u05E6\u05D5\u05EA \u05D0\u05EA \u05D4\u05DC\u05D2\u05D5\u05E0\u05D4 \u05D1\u05D9\u05DF \u05D4\u05E9\u05D5\u05E0\u05D9\u05D5\u05EA, \u05DE\u05E9\u05D7\u05EA\u05D5\u05EA \u05DE\u05DC\u05D5\u05D5\u05EA \u05DE\u05D8\u05D5\u05E1\u05D9 \u05EA\u05D5\u05D1\u05DC\u05D4 \u05E2\u05DE\u05D5\u05E1\u05D9\u05DD. \u05E7\u05D7\u05D5 \u05D0\u05EA \u05D4\u05DE\u05D8\u05E2\u05DF \u05E9\u05DC\u05D4\u05DD \u05D5\u05D4\u05E1\u05EA\u05E2\u05E8\u05D5 \u05E2\u05DC \u05DE\u05D1\u05E6\u05E8 \u05D4\u05E9\u05D5\u05E0\u05D9\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529848
    m_Localized: "\u05E9\u05D9\u05D9\u05E8\u05D5\u05EA: \u05DE\u05D8\u05D5\u05E1\u05D9 \u05EA\u05D5\u05D1\u05DC\u05D4 \u05D1\u05DC\u05D9\u05D5\u05D5\u05D9 \u05DE\u05E9\u05D7\u05EA\u05D5\u05EA. \u05D4\u05DE\u05D2\u05D3\u05DC\u05D9\u05DD \u05E9\u05DC \u05DE\u05D1\u05E6\u05E8 \u05D4\u05E9\u05D5\u05E0\u05D9\u05EA \u05DE\u05E4\u05D2\u05D9\u05D6\u05D9\u05DD \u05D0\u05EA \u05DB\u05DC \u05D4\u05DC\u05D2\u05D5\u05E0\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529849
    m_Localized: "\u05D4\u05DE\u05E6\u05D5\u05D3\u05D4 \u05E9\u05DC \u05D4\u05DE\u05D1\u05E6\u05E8 \u05E0\u05E4\u05EA\u05D7\u05EA \u05DB\u05E9\u05D4\u05DE\u05D2\u05D3\u05DC\u05D9\u05DD \u05D5\u05D4\u05EA\u05D5\u05EA\u05D7\u05D9\u05DD \u05E9\u05DC\u05D5 \u05E0\u05E2\u05DC\u05DE\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529850
    m_Localized: "\u05E9\u05D5\u05D1\u05DC\u05D9\u05DD \u05EA\u05D0\u05D5\u05DE\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529851
    m_Localized: "\u05E9\u05EA\u05D9 \u05E1\u05D9\u05E8\u05D5\u05EA \u05E6\u05D9\u05D9\u05D3, \u05D6\u05D0\u05D1\u05D9 \u05D4\u05D9\u05DD, \u05D4\u05D8\u05D1\u05D9\u05E2\u05D5 \u05DB\u05DC \u05E1\u05E4\u05D9\u05E0\u05D4 \u05E9\u05D1\u05D0\u05D4 \u05DC\u05E2\u05D6\u05E8\u05EA \u05EA\u05DC\u05E1\u05D4. \u05D8\u05D5\u05E1\u05D5 \u05D0\u05DC \u05D4\u05D9\u05DD \u05D4\u05E4\u05EA\u05D5\u05D7 \u05D5\u05E9\u05DC\u05D7\u05D5 \u05D0\u05D5\u05EA\u05DF \u05DC\u05E7\u05E8\u05E7\u05E2\u05D9\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529852
    m_Localized: "\u05D6\u05D0\u05D1\u05D9 \u05D4\u05D9\u05DD: \u05DC\u05D4\u05E7\u05D4 \u05E9\u05DC \u05E9\u05EA\u05D9 \u05E1\u05D9\u05E8\u05D5\u05EA \u05D1\u05DC\u05D9 \u05DC\u05D9\u05D1\u05D4. \u05D4\u05D8\u05D1\u05D9\u05E2\u05D5 \u05D0\u05EA \u05E9\u05EA\u05D9\u05D4\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529853
    m_Localized: "\u05D4\u05DC\u05D4\u05E7\u05D4 \u05E9\u05D5\u05E7\u05E2\u05EA \u05E2\u05DD \u05D4\u05EA\u05D5\u05EA\u05D7 \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF \u05E9\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529854
    m_Localized: "\u05DE\u05D9\u05D9\u05E8\u05D8\u05D9\u05DD \u05DE\u05D8\u05E4\u05E1\u05D9\u05DD \u05DE\u05D0\u05D7\u05D5\u05E8 \u05D2\u05DD \u05DE\u05E2\u05DC \u05D4\u05DE\u05D9\u05DD \u05D4\u05E4\u05EA\u05D5\u05D7\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529855
    m_Localized: "\u05D0\u05D5\u05E8\u05D5\u05EA \u05D4\u05E0\u05DE\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529856
    m_Localized: "\u05DC\u05D9\u05DC\u05D4 \u05DE\u05E2\u05DC \u05E0\u05DE\u05DC \u05E7\u05E8\u05D0\u05E0\u05DE\u05D0\u05E8\u05E7, \u05E9\u05D1\u05D5 \u05D2\u05D0\u05D5\u05EA \u05D4\u05D1\u05E8\u05D6\u05DC \u05DE\u05EA\u05D7\u05DE\u05E9\u05EA \u05DE\u05D7\u05D3\u05E9. \u05DB\u05D9\u05E4\u05D5\u05EA \u05DE\u05D2\u05DF \u05E9\u05D5\u05DE\u05E8\u05D5\u05EA \u05E2\u05DC \u05D4\u05E1\u05D5\u05DC\u05DC\u05D5\u05EA \u05DC\u05D0\u05D5\u05E8\u05DA \u05D4\u05E8\u05E6\u05D9\u05E4\u05D9\u05DD, \u05D5\u05E1\u05E4\u05D9\u05E0\u05EA \u05D4\u05DE\u05DC\u05D7\u05DE\u05D4 \u05D4\u05D7\u05D3\u05E9\u05D4 \u05E9\u05DC \u05D4\u05E6\u05D9 \u05DE\u05DE\u05EA\u05D9\u05E0\u05D4 \u05D1\u05DE\u05D1\u05D3\u05D5\u05E7."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529857
    m_Localized: "\u05E4\u05E9\u05D9\u05D8\u05EA \u05DC\u05D9\u05DC\u05D4 \u05E2\u05DC \u05D4\u05E0\u05DE\u05DC \u05E9\u05DC \u05D4\u05EA\u05D0\u05D2\u05D9\u05D3: \u05DE\u05D7\u05D5\u05DC\u05DC\u05D9 \u05DE\u05D2\u05DF \u05D1\u05E8\u05D7\u05D5\u05D1\u05D5\u05EA, \u05D4\u05D5\u05DC\u05DB\u05E0\u05D9\u05DD \u05D5\u05E7\u05E0\u05D9 \u05D8\u05D9\u05DC\u05D9 \u05E7\u05E8\u05E7\u05E2-\u05D0\u05D5\u05D5\u05D9\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529858
    m_Localized: "\u05D4\u05D5\u05DC\u05DB\u05E0\u05D9\u05DD \u05E6\u05D5\u05E2\u05D3\u05D9\u05DD \u05DC\u05D0\u05D5\u05E8\u05DA \u05D4\u05E8\u05D7\u05D5\u05D1\u05D5\u05EA: \u05D9\u05E8\u05D5 \u05DC\u05D0\u05D5\u05E8\u05DA \u05E0\u05EA\u05D9\u05D1\u05D9 \u05D4\u05E8\u05D7\u05D5\u05D1."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529859
    m_Localized: "\u05D7\u05E1\u05DC\u05D5 \u05D0\u05EA \u05D4\u05DE\u05D7\u05D5\u05DC\u05DC \u05E9\u05DC \u05DB\u05D9\u05E4\u05D4 \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D0\u05EA\u05DD \u05DE\u05D1\u05D6\u05D1\u05D6\u05D9\u05DD \u05D0\u05E9 \u05E2\u05DC \u05DE\u05D4 \u05E9\u05D4\u05D9\u05D0 \u05DE\u05DB\u05E1\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529860
    m_Localized: "\u05D0\u05E8\u05DE\u05D3\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529861
    m_Localized: "\u05D2\u05D0\u05D5\u05EA \u05D4\u05D1\u05E8\u05D6\u05DC \u05E1\u05D5\u05E3 \u05E1\u05D5\u05E3 \u05DE\u05E4\u05DC\u05D9\u05D2\u05D4: \u05E9\u05D5\u05E8\u05D4 \u05D0\u05D7\u05E8\u05D9 \u05E9\u05D5\u05E8\u05D4 \u05E9\u05DC \u05DE\u05E9\u05D7\u05EA\u05D5\u05EA, \u05E1\u05D9\u05D9\u05E8\u05D5\u05EA \u05DE\u05E2\u05DC\u05D9\u05D4\u05DF, \u05D5\u05D1\u05DC\u05D9\u05D1\u05D4 \u05E1\u05E4\u05D9\u05E0\u05EA \u05D4\u05DE\u05E2\u05E8\u05DB\u05D4. \u05E9\u05D1\u05E8\u05D5 \u05D0\u05EA \u05D4\u05D0\u05E8\u05DE\u05D3\u05D4 \u05DC\u05E4\u05E0\u05D9 \u05E9\u05EA\u05D2\u05D9\u05E2 \u05DC\u05E2\u05D5\u05DC\u05DE\u05D5\u05EA \u05D4\u05D7\u05D5\u05E4\u05E9\u05D9\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529862
    m_Localized: "\u05E9\u05D5\u05E8\u05D5\u05EA \u05DE\u05E9\u05D7\u05EA\u05D5\u05EA \u05D5\u05E1\u05E4\u05D9\u05E0\u05EA \u05D4\u05DE\u05E2\u05E8\u05DB\u05D4: \u05E9\u05DC\u05D5\u05E9 \u05D8\u05D1\u05E2\u05D5\u05EA \u05E9\u05DC \u05EA\u05D5\u05EA\u05D7\u05D9\u05DD, \u05E9\u05DC\u05D5\u05E9\u05D4 \u05E9\u05DC\u05D1\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529863
    m_Localized: "\u05D4\u05E6\u05E8\u05D9\u05D7\u05D9\u05DD \u05D4\u05E8\u05D0\u05E9\u05D9\u05D9\u05DD \u05E9\u05DC \u05E1\u05E4\u05D9\u05E0\u05EA \u05D4\u05DE\u05E2\u05E8\u05DB\u05D4 \u05DE\u05E4\u05D2\u05D9\u05D6\u05D9\u05DD \u05D0\u05EA \u05D4\u05E9\u05DE\u05D9\u05D9\u05DD: \u05D4\u05DE\u05E9\u05D9\u05DB\u05D5 \u05DC\u05D6\u05D5\u05D6."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529864
    m_Localized: "\u05E9\u05DE\u05E8\u05D5 \u05DE\u05D2\u05D4-\u05E4\u05E6\u05E6\u05D5\u05EA \u05DC\u05E9\u05DC\u05D1 \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF \u05E9\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529865
    m_Localized: "\u05E1\u05E4\u05D9\u05E0\u05EA \u05D4\u05D3\u05D2\u05DC \u05E9\u05DC \u05D4\u05EA\u05D0\u05D2\u05D9\u05D3 \u05E2\u05D5\u05DC\u05D4 \u05DE\u05E2\u05DC \u05D4\u05D0\u05D5\u05E7\u05D9\u05D9\u05E0\u05D5\u05E1 \u05D4\u05E2\u05DE\u05D5\u05E7 \u05E9\u05DC \u05EA\u05DC\u05E1\u05D4: \u05D4\u05DC\u05D5\u05D5\u05D9\u05EA\u05DF, \u05DE\u05D1\u05E6\u05E8 \u05DE\u05E2\u05D5\u05E4\u05E3 \u05E2\u05DD \u05E6\u05D9 \u05E9\u05DC\u05DD \u05D1\u05D4\u05D0\u05E0\u05D2\u05E8\u05D9\u05DD \u05E9\u05DC\u05D5. \u05E9\u05D9\u05DE\u05D5 \u05E7\u05E5 \u05DC\u05D2\u05D0\u05D5\u05EA \u05D4\u05D1\u05E8\u05D6\u05DC."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529866
    m_Localized: "\u05D4\u05E7\u05E8\u05D1 \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF \u05E9\u05DC \u05D2\u05D0\u05D5\u05EA \u05D4\u05D1\u05E8\u05D6\u05DC: \u05D4\u05DB\u05E0\u05E4\u05D9\u05D9\u05DD, \u05D4\u05D4\u05D0\u05E0\u05D2\u05E8\u05D9\u05DD \u05D5\u05DB\u05EA\u05E8 \u05D4\u05DB\u05D5\u05E8 \u05E9\u05DC \u05D4\u05DC\u05D5\u05D5\u05D9\u05EA\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529867
    m_Localized: "\u05D4\u05D4\u05D0\u05E0\u05D2\u05E8\u05D9\u05DD \u05E9\u05DC\u05D5 \u05DE\u05E9\u05D2\u05E8\u05D9\u05DD \u05E8\u05D7\u05E4\u05E0\u05D9\u05DD \u05E2\u05D3 \u05E9\u05D4\u05DD \u05E0\u05D5\u05E4\u05DC\u05D9\u05DD: \u05D7\u05E1\u05DC\u05D5 \u05D0\u05D5\u05EA\u05DD \u05DE\u05D5\u05E7\u05D3\u05DD \u05D1\u05E9\u05DC\u05D1 \u05D4\u05E9\u05E0\u05D9."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529868
    m_Localized: "\u05DB\u05EA\u05E8 \u05D4\u05DB\u05D5\u05E8 \u05E0\u05E4\u05EA\u05D7 \u05D0\u05D7\u05E8\u05D5\u05DF: \u05E9\u05DE\u05E8\u05D5 \u05DE\u05D2\u05DF \u05D1\u05E9\u05D1\u05D9\u05DC\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529869
    m_Localized: "\u05DE\u05D2\u05E2 \u05E8\u05D0\u05E9\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529870
    m_Localized: "\u05DE\u05E9\u05D4\u05D5 \u05D0\u05DB\u05DC \u05D0\u05EA \u05D4\u05DE\u05D5\u05E9\u05D1\u05D4 \u05DE\u05D9\u05E8\u05EA \u05DE\u05D4\u05E7\u05E8\u05E7\u05E2 \u05D5\u05DE\u05E2\u05DC\u05D4. \u05D8\u05D5\u05E1\u05D5 \u05DE\u05E2\u05DC \u05D0\u05D3\u05DE\u05D5\u05EA \u05D4\u05D3\u05D2\u05D9\u05E8\u05D4, \u05E9\u05E8\u05E4\u05D5 \u05D0\u05EA \u05DE\u05D4 \u05E9\u05D6\u05D5\u05D7\u05DC \u05D5\u05E2\u05E3, \u05D5\u05D4\u05E8\u05D2\u05D5 \u05D0\u05EA \u05EA\u05DC \u05D4\u05D3\u05D2\u05D9\u05E8\u05D4 \u05E9\u05DE\u05D6\u05D9\u05DF \u05D0\u05D5\u05EA\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529871
    m_Localized: "\u05D4\u05DB\u05D5\u05D5\u05E8\u05EA: \u05E2\u05D5\u05E7\u05E6\u05D9\u05DD \u05D9\u05D5\u05E8\u05E7\u05D9\u05DD \u05E0\u05D1\u05D2\u05D9\u05DD \u05E9\u05E0\u05E1\u05D7\u05E4\u05D9\u05DD \u05D0\u05D7\u05E8\u05D9\u05DB\u05DD, \u05D5\u05D9\u05D5\u05E8\u05E7\u05D9\u05DD \u05D9\u05D5\u05E8\u05D9\u05DD \u05D0\u05D5\u05EA\u05DD \u05D1\u05E6\u05E8\u05D5\u05E8\u05D5\u05EA \u05DE\u05D4\u05E7\u05E8\u05E7\u05E2."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529872
    m_Localized: "\u05E0\u05D1\u05D2\u05D9\u05DD \u05D0\u05D9\u05D8\u05D9\u05D9\u05DD \u05D0\u05D1\u05DC \u05E2\u05D5\u05E7\u05D1\u05D9\u05DD \u05D0\u05D7\u05E8\u05D9\u05DB\u05DD \u05D6\u05DE\u05DF \u05DE\u05D4: \u05D4\u05DE\u05E9\u05D9\u05DB\u05D5 \u05DC\u05D6\u05D5\u05D6 \u05D5\u05D4\u05DD \u05D9\u05D9\u05E9\u05D0\u05E8\u05D5 \u05DE\u05D0\u05D7\u05D5\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529873
    m_Localized: "\u05D4\u05DC\u05D1 \u05E9\u05DC \u05D4\u05EA\u05DC \u05DE\u05E9\u05D5\u05E8\u05D9\u05D9\u05DF \u05E2\u05D3 \u05E9\u05D4\u05DC\u05D5\u05E2\u05D5\u05EA \u05D5\u05D4\u05E9\u05E7 \u05E9\u05DC\u05D5 \u05E0\u05E2\u05DC\u05DE\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529874
    m_Localized: "\u05D4\u05DE\u05D3\u05D2\u05E8\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529875
    m_Localized: "\u05D4\u05DB\u05D5\u05D5\u05E8\u05EA \u05DE\u05EA\u05E8\u05D1\u05D4 \u05D1\u05D1\u05D5\u05E8\u05D5\u05EA \u05E9\u05DC \u05D7\u05D5\u05DE\u05E6\u05D4. \u05D4\u05DE\u05D5\u05DC\u05D9\u05D3\u05D9\u05DD \u05E9\u05DC\u05D4 \u05DE\u05E9\u05D2\u05E8\u05D9\u05DD \u05E2\u05D5\u05E7\u05E6\u05D9\u05DD \u05DB\u05DC \u05E2\u05D5\u05D3 \u05D4\u05DD \u05D7\u05D9\u05D9\u05DD: \u05E4\u05D2\u05E2\u05D5 \u05D1\u05D4\u05DD \u05E7\u05D5\u05D3\u05DD, \u05D5\u05D0\u05D6 \u05D1\u05DE\u05D2\u05D3\u05DC\u05D9 \u05D4\u05E0\u05D1\u05D2\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529876
    m_Localized: "\u05DE\u05D5\u05DC\u05D9\u05D3\u05D9 \u05D4\u05DB\u05D5\u05D5\u05E8\u05EA \u05DE\u05E9\u05D2\u05E8\u05D9\u05DD \u05E2\u05D5\u05E7\u05E6\u05D9\u05DD \u05DB\u05DE\u05D4 \u05E4\u05E2\u05DE\u05D9\u05DD: \u05D4\u05E9\u05DE\u05D9\u05D3\u05D5 \u05D0\u05D5\u05EA\u05DD \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05DD \u05DE\u05EA\u05E8\u05D5\u05E7\u05E0\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529877
    m_Localized: "\u05DE\u05D5\u05DC\u05D9\u05D3 \u05DE\u05E9\u05EA\u05EA\u05E7 \u05DB\u05E9\u05D4\u05D5\u05D0 \u05DE\u05D5\u05E9\u05DE\u05D3, \u05D0\u05D5 \u05DB\u05E9\u05D4\u05D5\u05D0 \u05DE\u05EA\u05E8\u05D5\u05E7\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529878
    m_Localized: "\u05DC\u05DE\u05D2\u05D3\u05DC\u05D9 \u05D4\u05E0\u05D1\u05D2\u05D9\u05DD \u05D0\u05D9\u05DF \u05DC\u05D9\u05D1\u05D4: \u05D4\u05E4\u05D9\u05DC\u05D5 \u05D0\u05EA \u05E9\u05E0\u05D9\u05D4\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529879
    m_Localized: "\u05D4\u05DE\u05D7\u05D9\u05DC\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529880
    m_Localized: "\u05D4\u05E7\u05E0\u05D9\u05DD \u05D9\u05D5\u05E8\u05D3\u05D9\u05DD \u05E2\u05DE\u05D5\u05E7. \u05E7\u05E8\u05D3\u05D9\u05D5\u05EA \u05E0\u05D5\u05D7\u05DC\u05D5\u05EA \u05DE\u05DB\u05DC \u05DE\u05D7\u05D9\u05DC\u05D4, \u05D5\u05EA\u05D5\u05DC\u05E2\u05EA \u05D4\u05DE\u05D7\u05D9\u05DC\u05D5\u05EA \u05E2\u05D5\u05DC\u05D4 \u05DC\u05E7\u05E8\u05D0\u05EA\u05DB\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529881
    m_Localized: "\u05E0\u05D7\u05D9\u05DC\u05D9 \u05E7\u05E8\u05D3\u05D9\u05D5\u05EA \u05E6\u05D5\u05DC\u05DC\u05D9\u05DD \u05D0\u05DC\u05D9\u05DB\u05DD. \u05EA\u05D5\u05DC\u05E2\u05EA \u05D4\u05DE\u05D7\u05D9\u05DC\u05D5\u05EA: \u05D6\u05E0\u05D1, \u05E6\u05D5\u05D5\u05D0\u05E8 \u05D5\u05E8\u05D0\u05E9, \u05E9\u05DC\u05D5\u05E9\u05D4 \u05E9\u05DC\u05D1\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529882
    m_Localized: "\u05DC\u05E7\u05E8\u05D3\u05D9\u05D5\u05EA \u05D0\u05D9\u05DF \u05E0\u05E9\u05E7, \u05D0\u05D1\u05DC \u05D4\u05DF \u05DE\u05EA\u05E0\u05D2\u05E9\u05D5\u05EA: \u05D8\u05D0\u05D8\u05D0\u05D5 \u05D0\u05D5\u05EA\u05DF \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05DF \u05E6\u05D5\u05DC\u05DC\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529883
    m_Localized: "\u05D4\u05E8\u05D0\u05E9 \u05E9\u05DC \u05D4\u05EA\u05D5\u05DC\u05E2\u05EA \u05DE\u05E9\u05D5\u05E8\u05D9\u05D9\u05DF \u05E2\u05D3 \u05E9\u05D4\u05D7\u05D5\u05DC\u05D9\u05D5\u05EA \u05E9\u05DC\u05D4 \u05E0\u05D5\u05E4\u05DC\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529884
    m_Localized: "\u05DE\u05D3\u05D1\u05E8 \u05D4\u05D6\u05DB\u05D5\u05DB\u05D9\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529885
    m_Localized: "\u05DE\u05E2\u05D1\u05E8 \u05DC\u05D0\u05D3\u05DE\u05D5\u05EA \u05D4\u05D3\u05D2\u05D9\u05E8\u05D4 \u05D4\u05DB\u05D5\u05D5\u05E8\u05EA \u05DE\u05D2\u05D3\u05DC\u05EA \u05D2\u05D1\u05D9\u05E9\u05D9\u05DD. \u05E2\u05DE\u05D5\u05D3\u05D9 \u05DE\u05E0\u05E1\u05E8\u05D5\u05EA \u05E9\u05E8\u05D9\u05DD \u05D8\u05D1\u05E2\u05D5\u05EA \u05E9\u05DC \u05DE\u05D7\u05D8\u05D9\u05DD \u05E2\u05DC \u05E4\u05E0\u05D9 \u05D4\u05E9\u05DE\u05DE\u05D4, \u05D5\u05DE\u05E9\u05D4\u05D5 \u05E2\u05E0\u05E7 \u05D9\u05E9\u05DF \u05D1\u05D9\u05E0\u05D9\u05D4\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529886
    m_Localized: "\u05E2\u05DE\u05D5\u05D3\u05D9 \u05DE\u05E0\u05E1\u05E8\u05D5\u05EA \u05D6\u05D5\u05D4\u05E8\u05D9\u05DD, \u05D5\u05D0\u05D6 \u05D9\u05D5\u05E8\u05D9\u05DD \u05D8\u05D1\u05E2\u05EA \u05E9\u05DC \u05DE\u05D7\u05D8\u05D9 \u05D2\u05D1\u05D9\u05E9."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529887
    m_Localized: "\u05DB\u05E9\u05DE\u05E0\u05E1\u05E8\u05D4 \u05D6\u05D5\u05D4\u05E8\u05EA, \u05D4\u05EA\u05E8\u05D7\u05E7\u05D5: \u05D4\u05D8\u05D1\u05E2\u05EA \u05E9\u05DC\u05D4 \u05DE\u05EA\u05E4\u05E9\u05D8\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529888
    m_Localized: "\u05D4\u05D6\u05E8\u05D5\u05E2\u05D5\u05EA \u05E9\u05DC \u05E2\u05E0\u05E7 \u05D4\u05E8\u05E1\u05D9\u05E1\u05D9\u05DD \u05D9\u05D5\u05E8\u05D5\u05EA \u05DC\u05D9\u05D9\u05D6\u05E8\u05D9\u05DD \u05DC\u05D0\u05D5\u05E8\u05DA \u05D4\u05D8\u05D5\u05E8\u05D9\u05DD \u05E9\u05DC\u05D4\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529889
    m_Localized: "\u05E0\u05EA\u05D9\u05D1\u05D9 \u05D4\u05DE\u05E0\u05E1\u05E8\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529890
    m_Localized: "\u05D9\u05E2\u05E8\u05D5\u05EA \u05D2\u05D1\u05D9\u05E9 \u05DE\u05E9\u05D0\u05D9\u05E8\u05D9\u05DD \u05E8\u05E7 \u05E0\u05EA\u05D9\u05D1\u05D9\u05DD \u05E6\u05E8\u05D9\u05DD \u05DC\u05D8\u05D5\u05E1 \u05DC\u05D0\u05D5\u05E8\u05DB\u05DD. \u05D1\u05E7\u05E6\u05D4 \u05E9\u05DC\u05D4\u05DD \u05D4\u05DB\u05D5\u05D5\u05E8\u05EA \u05D2\u05D9\u05D3\u05DC\u05D4 \u05DE\u05E2\u05E8\u05DA \u05DE\u05E0\u05E1\u05E8\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529891
    m_Localized: "\u05E9\u05D3\u05D5\u05EA \u05D2\u05D1\u05D9\u05E9: \u05D4\u05D9\u05D7\u05D9\u05D3\u05D5\u05EA \u05DE\u05D7\u05D6\u05D9\u05E7\u05D5\u05EA \u05D1\u05E0\u05EA\u05D9\u05D1\u05D9\u05DD. \u05DC\u05DE\u05E2\u05E8\u05DA \u05D4\u05DE\u05E0\u05E1\u05E8\u05D5\u05EA \u05D0\u05D9\u05DF \u05DC\u05D9\u05D1\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529892
    m_Localized: "\u05D4\u05EA\u05D9\u05D9\u05E9\u05E8\u05D5 \u05E2\u05DC \u05E0\u05EA\u05D9\u05D1 \u05DB\u05D3\u05D9 \u05DC\u05E4\u05D2\u05D5\u05E2 \u05D1\u05DB\u05DC \u05DE\u05D4 \u05E9\u05E2\u05DC\u05D9\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529893
    m_Localized: "\u05E2\u05DE\u05D3\u05D5 \u05D1\u05D9\u05DF \u05D4\u05E7\u05E8\u05E0\u05D9\u05D9\u05DD \u05E9\u05DC \u05D4\u05DE\u05E2\u05E8\u05DA \u05DB\u05E9\u05D4\u05DF \u05D9\u05D5\u05E8\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529894
    m_Localized: "\u05D4\u05E6\u05E8\u05D9\u05D7\u05D9\u05DD \u05D4\u05E9\u05E8\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529895
    m_Localized: "\u05D4\u05E9\u05D9\u05E8\u05D4 \u05E9\u05DC \u05D4\u05D2\u05D1\u05D9\u05E9\u05D9\u05DD \u05DE\u05EA\u05D7\u05D6\u05E7\u05EA: \u05D4\u05DE\u05D4\u05D3\u05D4\u05D3 \u05D1\u05DC\u05D1 \u05D4\u05E9\u05DE\u05DE\u05D4 \u05DE\u05E1\u05D5\u05D1\u05D1 \u05D8\u05D1\u05E2\u05EA \u05E9\u05DC \u05E4\u05D5\u05DC\u05D8\u05D9\u05DD \u05E1\u05D1\u05D9\u05D1 \u05D4\u05DC\u05D9\u05D1\u05D4 \u05E9\u05DC\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529896
    m_Localized: "\u05D4\u05DE\u05D4\u05D3\u05D4\u05D3: \u05D8\u05D1\u05E2\u05EA \u05DE\u05E1\u05EA\u05D5\u05D1\u05D1\u05EA \u05E9\u05DC \u05E4\u05D5\u05DC\u05D8\u05D9 \u05D2\u05D1\u05D9\u05E9."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529897
    m_Localized: "\u05D4\u05E4\u05D5\u05DC\u05D8\u05D9\u05DD \u05DE\u05E1\u05EA\u05D5\u05D1\u05D1\u05D9\u05DD \u05E2\u05DD \u05D4\u05D8\u05D1\u05E2\u05EA: \u05D9\u05E8\u05D5 \u05D1\u05D0\u05DC\u05D4 \u05E9\u05E0\u05DB\u05E0\u05E1\u05D9\u05DD \u05DC\u05E7\u05D5 \u05E9\u05DC\u05DB\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529898
    m_Localized: "\u05D4\u05DC\u05D9\u05D1\u05D4 \u05D9\u05D5\u05E8\u05D4 \u05E7\u05E8\u05DF \u05D1\u05E8\u05D2\u05E2 \u05E9\u05D4\u05D8\u05D1\u05E2\u05EA \u05E0\u05E2\u05DC\u05DE\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529899
    m_Localized: "\u05E4\u05E8\u05D9\u05E6\u05D4 \u05DC\u05D8\u05D1\u05E2\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529900
    m_Localized: "\u05D4\u05DB\u05D5\u05D5\u05E8\u05EA \u05D8\u05D9\u05E4\u05E1\u05D4 \u05D0\u05DC \u05D4\u05DE\u05E1\u05DC\u05D5\u05DC: \u05D4\u05D4\u05D9\u05DC\u05D4, \u05EA\u05D7\u05E0\u05EA \u05D4\u05D8\u05D1\u05E2\u05EA \u05D4\u05D2\u05D3\u05D5\u05DC\u05D4 \u05E9\u05DC \u05D4\u05DE\u05D5\u05E9\u05D1\u05D5\u05EA, \u05E9\u05D5\u05E8\u05E6\u05EA \u05D1\u05D4. \u05E4\u05E8\u05E6\u05D5 \u05D0\u05DC \u05D4\u05D8\u05D1\u05E2\u05EA \u05D5\u05D4\u05D7\u05D6\u05D9\u05E8\u05D5 \u05DC\u05E2\u05E6\u05DE\u05DB\u05DD \u05D0\u05EA \u05D4\u05E9\u05E2\u05E8 \u05E9\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529901
    m_Localized: "\u05D4\u05D4\u05D9\u05DC\u05D4: \u05D4\u05DB\u05D5\u05D5\u05E8\u05EA \u05E6\u05D5\u05DE\u05D7\u05EA \u05E2\u05DC \u05D4\u05E1\u05D9\u05E4\u05D5\u05DF, \u05D5\u05E4\u05E8\u05E6\u05D5\u05EA \u05E0\u05E4\u05EA\u05D7\u05D5\u05EA \u05D0\u05DC \u05D4\u05D7\u05DC\u05DC."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529902
    m_Localized: "\u05D4\u05E9\u05E7\u05D9\u05DD \u05E9\u05DC \u05D4\u05E9\u05E2\u05E8 \u05DE\u05E9\u05D2\u05E8\u05D9\u05DD \u05E2\u05D5\u05E7\u05E6\u05D9\u05DD \u05D1\u05D6\u05DE\u05DF \u05E9\u05D4\u05D8\u05D1\u05E2\u05EA \u05E9\u05DC\u05D5 \u05DE\u05E1\u05EA\u05D5\u05D1\u05D1\u05EA: \u05D4\u05E8\u05D2\u05D5 \u05D0\u05D5\u05EA\u05DD \u05E7\u05D5\u05D3\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529903
    m_Localized: "\u05DE\u05D5\u05DC\u05D9\u05D3\u05D9\u05DD \u05E2\u05DC \u05D4\u05E1\u05D9\u05E4\u05D5\u05DF \u05DE\u05E9\u05D2\u05E8\u05D9\u05DD \u05E2\u05D5\u05E7\u05E6\u05D9\u05DD: \u05D7\u05E1\u05DC\u05D5 \u05D0\u05D5\u05EA\u05DD \u05D1\u05D3\u05E8\u05DA."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529904
    m_Localized: "\u05E1\u05E4\u05D9\u05E0\u05D4 \u05D7\u05D9\u05D4 \u05E2\u05D2\u05E0\u05D4 \u05D1\u05D4\u05D9\u05DC\u05D4, \u05D5\u05E0\u05D5\u05E9\u05D0\u05EA \u05D0\u05EA \u05D4\u05D3\u05D2\u05D9\u05E8\u05D4 \u05D4\u05D1\u05D0\u05D4 \u05D0\u05DC \u05D4\u05E2\u05D5\u05DC\u05DE\u05D5\u05EA \u05D4\u05D7\u05D5\u05E4\u05E9\u05D9\u05D9\u05DD. \u05D4\u05E8\u05D2\u05D5 \u05D0\u05D5\u05EA\u05D4 \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05D9\u05D0 \u05DE\u05E4\u05DC\u05D9\u05D2\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529905
    m_Localized: "\u05E1\u05E4\u05D9\u05E0\u05EA \u05D4\u05D3\u05D2\u05D9\u05E8\u05D4: \u05DC\u05D5\u05E2\u05D5\u05EA, \u05E9\u05E7\u05D9 \u05E2\u05D5\u05E7\u05E6\u05D9\u05DD \u05D5\u05E7\u05D5\u05E6\u05D9\u05DD \u05DE\u05D8\u05D0\u05D8\u05D0\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529906
    m_Localized: "\u05D4\u05E7\u05D5\u05E6\u05D9\u05DD \u05DE\u05D8\u05D0\u05D8\u05D0\u05D9\u05DD \u05E0\u05D1\u05D2\u05D9\u05DD \u05DE\u05E6\u05D3 \u05DC\u05E6\u05D3: \u05D7\u05DB\u05D5 \u05DC\u05E4\u05E8\u05E6\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529907
    m_Localized: "\u05DE\u05D2\u05D4-\u05E4\u05E6\u05E6\u05D4 \u05DE\u05E0\u05E7\u05D4 \u05D0\u05EA \u05D4\u05E0\u05D1\u05D2\u05D9\u05DD \u05DE\u05E9\u05DE\u05D9\u05D9\u05DD \u05E6\u05E4\u05D5\u05E4\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529908
    m_Localized: "\u05DC\u05D1 \u05D4\u05DB\u05D5\u05D5\u05E8\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529909
    m_Localized: "\u05DB\u05E9\u05D4\u05D4\u05D9\u05DC\u05D4 \u05D7\u05D5\u05E4\u05E9\u05D9\u05EA, \u05D4\u05D3\u05E8\u05DA \u05D0\u05DC \u05DC\u05D1 \u05D4\u05DB\u05D5\u05D5\u05E8\u05EA \u05E4\u05EA\u05D5\u05D7\u05D4. \u05E8\u05D3\u05D5 \u05D0\u05DC \u05D4\u05E7\u05DF \u05D4\u05E2\u05EA\u05D9\u05E7 \u05D1\u05D9\u05D5\u05EA\u05E8 \u05E9\u05DC \u05D0\u05D3\u05DE\u05D5\u05EA \u05D4\u05D3\u05D2\u05D9\u05E8\u05D4 \u05D5\u05D4\u05E8\u05D2\u05D5 \u05D0\u05EA \u05D0\u05DD \u05D4\u05DB\u05D5\u05D5\u05E8\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529910
    m_Localized: "\u05D4\u05E7\u05E8\u05D1 \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF: \u05D0\u05DD \u05D4\u05DB\u05D5\u05D5\u05E8\u05EA \u05D5\u05E9\u05EA\u05D9 \u05D4\u05D8\u05D1\u05E2\u05D5\u05EA \u05D4\u05DE\u05E1\u05EA\u05D5\u05D1\u05D1\u05D5\u05EA \u05E9\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529911
    m_Localized: "\u05D8\u05D1\u05E2\u05EA \u05D4\u05E9\u05E7\u05D9\u05DD \u05D4\u05D7\u05D9\u05E6\u05D5\u05E0\u05D9\u05EA \u05E9\u05DC\u05D4 \u05DE\u05D2\u05D9\u05E0\u05D4 \u05E2\u05DC \u05D4\u05D8\u05D1\u05E2\u05EA \u05D4\u05E4\u05E0\u05D9\u05DE\u05D9\u05EA, \u05D5\u05D4\u05E4\u05E0\u05D9\u05DE\u05D9\u05EA \u05E2\u05DC \u05D4\u05DC\u05D1 \u05E9\u05DC\u05D4."
