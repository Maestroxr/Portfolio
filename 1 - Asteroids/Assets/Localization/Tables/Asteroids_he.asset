    m_Localized: "\u05DE\u05E8\u05D5\u05E6\u05E0\u05D9\u05EA \u05DE\u05D4\u05D9\u05E8\u05D4 \u05D5\u05D6\u05E8\u05D9\u05D6\u05D4 \u05E2\u05DD \u05D2\u05D5\u05E3 \u05E7\u05DC. \u05DE\u05D6\u05E0\u05E7\u05EA \u05DC\u05E2\u05D9\u05EA\u05D9\u05DD \u05E7\u05E8\u05D5\u05D1\u05D5\u05EA."
