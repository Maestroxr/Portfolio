      m_Items: []
  - m_Id: 839971169
    m_Localized: "\u05D1\u05E2\u05D5\u05DC\u05DD \u05D2\u05E2\u05E9\u05D9 \u05D4\u05E6\u05DC \u05DE\u05D7\u05E9\u05DC \u05D0\u05EA \u05DE\u05DB\u05D5\u05E0\u05D5\u05EA \u05D4\u05DE\u05DC\u05D7\u05DE\u05D4 \u05E9\u05DC\u05D5 \u05DE\u05E2\u05DC \u05E0\u05D4\u05E8\u05D5\u05EA \u05DC\u05D1\u05D4. \u05D4\u05E8\u05E1\u05D5 \u05D0\u05EA \u05D1\u05EA\u05D9 \u05D4\u05D9\u05E6\u05D9\u05E7\u05D4 \u05D5\u05E6\u05D5\u05D3\u05D5 \u05D0\u05EA \u05D6\u05D7\u05DC\u05DF \u05D4\u05D9\u05E6\u05D9\u05E7\u05D4 \u05D1\u05EA\u05D5\u05DA \u05D4\u05E2\u05E9\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 839971170
    m_Localized: "\u05E9\u05E8\u05D9\u05D5\u05DF \u05DB\u05D1\u05D3 \u05D5\u05D0\u05D2\u05DE\u05D9 \u05DC\u05D1\u05D4. \u05E4\u05EA\u05D7\u05D9 \u05D4\u05D0\u05D5\u05D5\u05E8\u05D5\u05E8 \u05E9\u05DC \u05D6\u05D7\u05DC\u05DF \u05D4\u05D9\u05E6\u05D9\u05E7\u05D4 \u05D9\u05D5\u05E8\u05D9\u05DD \u05D7\u05D5\u05DE\u05D5\u05EA \u05E9\u05DC \u05E7\u05DC\u05D9\u05E2\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971171
    m_Localized: "\u05D1\u05D5\u05E0\u05E7\u05E8\u05D9\u05DD \u05D5\u05DE\u05D2\u05D3\u05DC\u05D9 \u05DC\u05D9\u05D9\u05D6\u05E8 \u05E9\u05D5\u05D5\u05D9\u05DD \u05D4\u05D5\u05DF: \u05D4\u05D1\u05D9\u05D0\u05D5 \u05E0\u05E9\u05E7 \u05E0\u05D2\u05D3 \u05E7\u05E8\u05E7\u05E2."
    m_Metadata:
      m_Items: []
  - m_Id: 839971172
    m_Localized: "\u05D4\u05EA\u05D5\u05EA\u05D7 \u05E9\u05DC \u05D4\u05D6\u05D7\u05DC\u05DF \u05E0\u05E4\u05EA\u05D7 \u05DB\u05E9\u05D4\u05E6\u05E8\u05D9\u05D7\u05D9\u05DD \u05D5\u05E4\u05EA\u05D7\u05D9 \u05D4\u05D0\u05D5\u05D5\u05E8\u05D5\u05E8 \u05E9\u05DC\u05D5 \u05E0\u05E2\u05DC\u05DE\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971173
    m_Localized: "\u05EA\u05D7\u05E0\u05EA \u05D4\u05E6\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 839971174
    m_Localized: "\u05D4\u05E6\u05DC \u05E2\u05E6\u05DE\u05D5: \u05EA\u05D7\u05E0\u05EA \u05DE\u05D1\u05E6\u05E8 \u05D1\u05E7\u05E6\u05D4 \u05D4\u05DE\u05D5\u05E9\u05D1\u05D5\u05EA. \u05DB\u05DC \u05DE\u05D4 \u05E9\u05D9\u05E9 \u05DC\u05D5 \u05E2\u05D5\u05DE\u05D3 \u05D1\u05D9\u05E0\u05DB\u05DD \u05DC\u05D1\u05D9\u05DF \u05D4\u05DC\u05D9\u05D1\u05D4 \u05E9\u05DC\u05D5. \u05E9\u05D1\u05E8\u05D5 \u05D0\u05EA \u05D4\u05D8\u05D1\u05E2\u05D5\u05EA \u05E9\u05DC\u05D5, \u05D5\u05D0\u05D6 \u05E9\u05D1\u05E8\u05D5 \u05D0\u05EA \u05DC\u05D9\u05D1\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 839971175
    m_Localized: "\u05D4\u05E7\u05E8\u05D1 \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF: \u05E9\u05DC\u05D5\u05E9 \u05D8\u05D1\u05E2\u05D5\u05EA \u05D4\u05D2\u05E0\u05D4, \u05E9\u05DC\u05D5\u05E9\u05D4 \u05E9\u05DC\u05D1\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971176
    m_Localized: "\u05D4\u05D8\u05D1\u05E2\u05EA \u05D4\u05D7\u05D9\u05E6\u05D5\u05E0\u05D9\u05EA \u05DE\u05D2\u05D9\u05E0\u05D4 \u05E2\u05DC \u05D4\u05E4\u05E0\u05D9\u05DE\u05D9\u05EA, \u05D5\u05D4\u05E4\u05E0\u05D9\u05DE\u05D9\u05EA \u05DE\u05D2\u05D9\u05E0\u05D4 \u05E2\u05DC \u05D4\u05DC\u05D9\u05D1\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 839971177
    m_Localized: "\u05E9\u05DE\u05E8\u05D5 \u05DE\u05D2\u05D4-\u05E4\u05E6\u05E6\u05D5\u05EA \u05DC\u05E9\u05DC\u05D1 \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF."
