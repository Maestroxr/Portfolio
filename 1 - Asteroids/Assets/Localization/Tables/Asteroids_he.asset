  - m_Id: 360901225017363
    m_Localized: "\u05D0\u05D9 \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E9\u05DE\u05D5\u05E8 \u05DE\u05E9\u05D9\u05DE\u05D4 \u05E9\u05D9\u05EA\u05D5\u05E4\u05D9\u05EA \u05DE\u05E7\u05D5\u05DE\u05D9\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 360901225017364
    m_Localized: "\u05D1\u05DE\u05E9\u05D9\u05DE\u05D4 \u05E9\u05DE\u05D5\u05E8\u05D4 \u05DE\u05DE\u05E9\u05D9\u05DB\u05D9\u05DD \u05DC\u05D1\u05D3, \u05DE\u05DE\u05E1\u05DA \u05D1\u05D7\u05D9\u05E8\u05EA \u05D4\u05DE\u05E9\u05D9\u05DE\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6149596439965696
    m_Localized: "\u05E9\u05DC\u05D5\u05E9 \u05DE\u05E2\u05E8\u05DB\u05D5\u05EA \u05D1\u05E9\u05D3\u05D5\u05EA \u05D4\u05D0\u05E1\u05D8\u05E8\u05D5\u05D0\u05D9\u05D3\u05D9\u05DD: \u05E4\u05E6\u05DC\u05D5 \u05D0\u05E1\u05D8\u05E8\u05D5\u05D0\u05D9\u05D3\u05D9\u05DD, \u05D4\u05EA\u05D7\u05DE\u05E7\u05D5 \u05DE\u05DE\u05D5\u05E7\u05E9\u05D9\u05DD, \u05E9\u05D1\u05D9\u05D8\u05D9\u05DD \u05D5\u05D7\u05D5\u05E8\u05D9\u05DD \u05E9\u05D7\u05D5\u05E8\u05D9\u05DD, \u05D4\u05D9\u05DC\u05D7\u05DE\u05D5 \u05D1\u05E6\u05DC\u05D7\u05D5\u05EA \u05DE\u05E2\u05D5\u05E4\u05E4\u05D5\u05EA, \u05D1\u05E6\u05E8\u05E2\u05D5\u05EA \u05D5\u05D1\u05D1\u05D5\u05E1\u05D9\u05DD, \u05E9\u05D3\u05E8\u05D2\u05D5 \u05D0\u05EA \u05D4\u05EA\u05D5\u05EA\u05D7\u05D9\u05DD \u05D5\u05D1\u05D3\u05E7\u05D5 \u05DB\u05DE\u05D4 \u05D6\u05DE\u05DF \u05EA\u05D7\u05D6\u05D9\u05E7\u05D5 \u05DE\u05E2\u05DE\u05D3 \u05D1\u05D7\u05DC\u05DC \u05D4\u05E2\u05DE\u05D5\u05E7 \u05D4\u05D0\u05D9\u05E0\u05E1\u05D5\u05E4\u05D9. \u05D0\u05D7\u05E8 \u05DB\u05DA \u05E7\u05D7\u05D5 \u05D0\u05EA \u05D4\u05DE\u05DC\u05D7\u05DE\u05D4 \u05D0\u05DC \u05DB\u05D5\u05DB\u05D1\u05D9 \u05D4\u05DC\u05DB\u05EA \u05D1\u05E9\u05DC\u05D5\u05E9 \u05DE\u05E2\u05E8\u05DB\u05D5\u05EA \u05E9\u05DC \u05EA\u05E7\u05D9\u05E4\u05D4 \u05E4\u05DC\u05E0\u05D8\u05E8\u05D9\u05EA: \u05E7\u05E8\u05D1\u05D5\u05EA \u05D0\u05D5\u05D5\u05D9\u05E8 \u05D5\u05E7\u05E8\u05E7\u05E2 \u05D1\u05D2\u05DC\u05D9\u05DC\u05D4 \u05D0\u05E0\u05DB\u05D9\u05EA, \u05D7\u05D3\u05E8 \u05D0\u05E1\u05E4\u05E7\u05D4 \u05DC\u05D1\u05D6\u05D1\u05D6 \u05D1\u05D5 \u05D0\u05EA \u05D4\u05E8\u05D5\u05D5\u05D7\u05D9\u05DD \u05D5\u05D1\u05D5\u05E1 \u05D1\u05E1\u05D5\u05E3 \u05DB\u05DC \u05DE\u05E9\u05D9\u05DE\u05D4. \u05DE\u05E9\u05D7\u05E7 \u05E9\u05D9\u05EA\u05D5\u05E4\u05D9 \u05DC\u05E2\u05D3 \u05D0\u05E8\u05D1\u05E2\u05D4 \u05D8\u05D9\u05D9\u05E1\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 6149596507074560
    m_Localized: "\u05DE\u05DC\u05D7\u05DE\u05EA \u05D4\u05E9\u05D5\u05D3\u05D3\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 6149596507074561
    m_Localized: "\u05D0\u05E8\u05D1\u05E2 \u05D2\u05D6\u05E8\u05D5\u05EA, \u05E9\u05EA\u05D9\u05DD \u05E2\u05E9\u05E8\u05D4 \u05DE\u05E9\u05D9\u05DE\u05D5\u05EA: \u05E9\u05D1\u05E8\u05D5 \u05D0\u05EA \u05D0\u05D7\u05D9\u05D6\u05EA \u05D4\u05E9\u05D5\u05D3\u05D3\u05D9\u05DD \u05D1\u05D7\u05D2\u05D5\u05E8\u05EA \u05E7\u05E4\u05DC\u05E8 \u05D5\u05E8\u05D3\u05E4\u05D5 \u05D0\u05D7\u05E8\u05D9 \u05D4\u05D3\u05E8\u05D3\u05E0\u05D5\u05D8 \u05E9\u05DC\u05D4\u05DD \u05E2\u05D3 \u05DC\u05D9\u05D1\u05EA \u05D4\u05E8\u05D9\u05E7."
    m_Metadata:
      m_Items: []
  - m_Id: 6149596507074562
    m_Localized: "\u05DE\u05DB\u05EA \u05D4\u05E6\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 6149596507074563
    m_Localized: "\u05EA\u05E9\u05E2 \u05DE\u05E9\u05D9\u05DE\u05D5\u05EA \u05DE\u05E2\u05DC \u05E9\u05DC\u05D5\u05E9\u05D4 \u05E2\u05D5\u05DC\u05DE\u05D5\u05EA: \u05D4\u05D5\u05E8\u05D9\u05D3\u05D5 \u05D0\u05EA \u05D4\u05DE\u05DC\u05D7\u05DE\u05D4 \u05D0\u05DC \u05DB\u05D5\u05DB\u05D1\u05D9 \u05D4\u05DC\u05DB\u05EA \u05E9\u05DC \u05D4\u05E6\u05DC \u05D5\u05E1\u05D9\u05D9\u05DE\u05D5 \u05D0\u05D5\u05EA\u05D4 \u05D1\u05EA\u05D7\u05E0\u05EA \u05D4\u05E6\u05DC."
