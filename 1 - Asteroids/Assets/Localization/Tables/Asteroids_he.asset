    m_Localized: "\u05E8\u05D7\u05E4\u05E0\u05D9 \u05DC\u05D9\u05D5\u05D5\u05D9 \u05E0\u05DC\u05D7\u05DE\u05D9\u05DD \u05DC\u05E6\u05D3\u05DB\u05DD \u05DC\u05D6\u05DE\u05DF \u05DE\u05D4."
