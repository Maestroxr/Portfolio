  - m_Id: 6219435082838016
    m_Localized: "\u05D2\u05D0\u05D5\u05EA \u05D4\u05D1\u05E8\u05D6\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529792
    m_Localized: "\u05EA\u05E9\u05E2 \u05DE\u05E9\u05D9\u05DE\u05D5\u05EA \u05DE\u05E2\u05DC \u05E2\u05D5\u05DC\u05DD \u05E9\u05DC \u05E7\u05E8\u05D7 \u05D5\u05D0\u05D5\u05E7\u05D9\u05D9\u05E0\u05D5\u05E1 \u05E9\u05DC \u05D0\u05D9\u05D9\u05DD: \u05EA\u05D0\u05D2\u05D9\u05D3 \u05E7\u05E8\u05D0\u05E0\u05DE\u05D0\u05E8\u05E7 \u05E9\u05D5\u05DC\u05D7 \u05D0\u05EA \u05E6\u05D9 \u05D4\u05DE\u05DC\u05D7\u05DE\u05D4 \u05E9\u05DC\u05D5, \u05D2\u05D0\u05D5\u05EA \u05D4\u05D1\u05E8\u05D6\u05DC, \u05DC\u05E7\u05D7\u05EA \u05DC\u05E2\u05E6\u05DE\u05D5 \u05D0\u05EA \u05D4\u05E2\u05D5\u05DC\u05DE\u05D5\u05EA \u05D4\u05D7\u05D5\u05E4\u05E9\u05D9\u05D9\u05DD. \u05D4\u05E4\u05DB\u05D5 \u05D0\u05EA \u05D4\u05D2\u05D0\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529793
    m_Localized: "\u05E0\u05E4\u05D9\u05DC\u05EA \u05D4\u05DB\u05D5\u05D5\u05E8\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 6219435162529794
    m_Localized: "\u05EA\u05E9\u05E2 \u05DE\u05E9\u05D9\u05DE\u05D5\u05EA \u05D0\u05DC \u05EA\u05D5\u05DA \u05D4\u05DB\u05D5\u05D5\u05E8\u05EA: \u05E9\u05E8\u05E4\u05D5 \u05D0\u05EA \u05D4\u05D3\u05D2\u05D9\u05E8\u05D4 \u05E9\u05DC\u05D4 \u05E2\u05DC \u05D4\u05E2\u05D5\u05DC\u05DD \u05D4\u05D7\u05D9 \u05E9\u05DC\u05D4, \u05D7\u05E6\u05D5 \u05D0\u05EA \u05E9\u05DE\u05DE\u05D5\u05EA \u05D4\u05D2\u05D1\u05D9\u05E9 \u05E9\u05D1\u05D4\u05DF \u05D4\u05D9\u05D0 \u05DE\u05D2\u05D3\u05DC\u05EA \u05D0\u05EA \u05E0\u05E9\u05E7\u05D9\u05D4, \u05D4\u05D7\u05D6\u05D9\u05E8\u05D5 \u05DC\u05E2\u05E6\u05DE\u05DB\u05DD \u05D0\u05EA \u05D4\u05D4\u05D9\u05DC\u05D4 \u05E9\u05D1\u05DE\u05E1\u05DC\u05D5\u05DC \u05D5\u05D4\u05E8\u05D2\u05D5 \u05D0\u05EA \u05D0\u05DD \u05D4\u05DB\u05D5\u05D5\u05E8\u05EA."
    m_Metadata:
      m_Items: []
