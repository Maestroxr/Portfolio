  - m_Id: 835776528
    m_Localized: "\u05D9\u05E6\u05D9\u05D0\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 835776529
    m_Localized: "W A S D / \u05D7\u05D9\u05E6\u05D9\u05DD  \u05D8\u05D9\u05E1\u05D4    \u05E8\u05D5\u05D5\u05D7  \u05D9\u05E8\u05D9    SHIFT  \u05D6\u05D9\u05E0\u05D5\u05E7    B  \u05E4\u05E6\u05E6\u05EA \u05E0\u05D5\u05D1\u05D4    ESC  \u05D4\u05E9\u05D4\u05D9\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 835776530
    m_Localized: "\u05D0\u05D2\u05D5\u05D3\u05DC \u05E9\u05DE\u05D0\u05DC  \u05D4\u05D9\u05D2\u05D5\u05D9 \u05D5\u05D3\u05D7\u05E3    \u05D4\u05D7\u05D6\u05D9\u05E7\u05D5 \u05D9\u05E8\u05D9  \u05DC\u05D9\u05E8\u05D5\u05EA    \u05D6\u05D9\u05E0\u05D5\u05E7    \u05E0\u05D5\u05D1\u05D4  \u05E4\u05E6\u05E6\u05D4    \u05D7\u05D6\u05E8\u05D4  \u05D4\u05E9\u05D4\u05D9\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 835776531
    m_Localized: "W A S D / \u05D7\u05D9\u05E6\u05D9\u05DD  \u05D8\u05D9\u05E1\u05D4    \u05E8\u05D5\u05D5\u05D7  \u05D9\u05E8\u05D9    SHIFT  \u05E0\u05E9\u05E7    B  \u05DE\u05D2\u05D4-\u05E4\u05E6\u05E6\u05D4    ESC  \u05D4\u05E9\u05D4\u05D9\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 835776532
    m_Localized: "\u05D0\u05D2\u05D5\u05D3\u05DC \u05E9\u05DE\u05D0\u05DC  \u05D8\u05D9\u05E1\u05D4    \u05D4\u05D7\u05D6\u05D9\u05E7\u05D5 \u05D9\u05E8\u05D9  \u05DC\u05D9\u05E8\u05D5\u05EA    \u05E0\u05E9\u05E7  \u05D4\u05D7\u05DC\u05E4\u05D4    \u05DE\u05D2\u05D4  \u05E4\u05E6\u05E6\u05D4    \u05D7\u05D6\u05E8\u05D4  \u05D4\u05E9\u05D4\u05D9\u05D4"
