    m_Localized: "\u05DE\u05D9\u05D9\u05E8\u05D8 \u05DE\u05D0\u05D5\u05D6\u05DF. \u05E7\u05DC \u05DC\u05D4\u05D8\u05E1\u05D4 \u05D5\u05D8\u05D5\u05D1 \u05D1\u05D4\u05DB\u05D5\u05DC."
