    m_Metadata:
      m_Items: []
  - m_Id: 839971181
    m_Localized: "\u05E1\u05E4\u05D9\u05E0\u05EA \u05E7\u05E8\u05D1 \u05DB\u05D1\u05D3\u05D4. \u05D0\u05D9\u05D8\u05D9\u05EA \u05D1\u05E4\u05E0\u05D9\u05D5\u05EA \u05D0\u05D1\u05DC \u05E7\u05E9\u05D4 \u05DE\u05D0\u05D5\u05D3 \u05DC\u05D4\u05E9\u05DE\u05D9\u05D3 \u05D0\u05D5\u05EA\u05D4."
