      m_Items: []
  - m_Id: 835776562
    m_Localized: "\u05D0\u05E1\u05E4\u05D5 {0} \u05DB\u05D5\u05DB\u05D1\u05D9\u05DD \u05DB\u05D3\u05D9 \u05DC\u05D4\u05D9\u05DB\u05E0\u05E1 \u05DC\u05D2\u05D6\u05E8\u05D4 \u05D4\u05D6\u05D5 ({1} \u05E2\u05D3 \u05DB\u05D4)."
