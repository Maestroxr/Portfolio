    m_Localized: "\u05D6\u05D5\u05D2\u05D5\u05EA \u05D8\u05D9\u05DC\u05D9\u05DD \u05E0\u05D2\u05D3 \u05DB\u05DC\u05D9 \u05D8\u05D9\u05E1. \u05D0\u05D5\u05D5\u05D9\u05E8 \u05D1\u05DC\u05D1\u05D3."
