    m_Metadata:
      m_Items: []
  - m_Id: 839971129
    m_Localized: "\u05E1\u05E4\u05D9\u05E0\u05EA \u05D4\u05DE\u05E2\u05E8\u05DB\u05D4 \u05E9\u05DC \u05D4\u05E9\u05D5\u05D3\u05D3\u05D9\u05DD \u05E9\u05D5\u05DE\u05E8\u05EA \u05E2\u05DC \u05DC\u05D1 \u05D4\u05E8\u05D9\u05E7. \u05E9\u05D9\u05DE\u05D5 \u05DC\u05D6\u05D4 \u05E1\u05D5\u05E3."
    m_Metadata:
      m_Items: []
  - m_Id: 839971130
    m_Localized: "\u05D4\u05D1\u05D5\u05E1 \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF: \u05D4\u05D3\u05E8\u05D3\u05E0\u05D5\u05D8."
    m_Metadata:
      m_Items: []
  - m_Id: 839971131
    m_Localized: "\u05D4\u05D3\u05E8\u05D3\u05E0\u05D5\u05D8 \u05D9\u05D5\u05E8\u05D4 \u05D8\u05D9\u05DC\u05D9\u05DD \u05DE\u05D1\u05D9\u05D9\u05EA\u05D9\u05DD - \u05D4\u05DE\u05E9\u05D9\u05DB\u05D5 \u05DC\u05D6\u05D5\u05D6."
    m_Metadata:
      m_Items: []
  - m_Id: 839971132
    m_Localized: "\u05E9\u05DE\u05E8\u05D5 \u05E4\u05E6\u05E6\u05EA \u05E0\u05D5\u05D1\u05D4 \u05DC\u05E8\u05D2\u05E2 \u05E9\u05D1\u05D5 \u05D4\u05D5\u05D0 \u05DE\u05E9\u05EA\u05D5\u05DC\u05DC."
    m_Metadata:
      m_Items: []
  - m_Id: 839971133
    m_Localized: "\u05E9\u05D3 \u05D0\u05D1\u05E7"
    m_Metadata:
      m_Items: []
  - m_Id: 839971134
    m_Localized: "\u05D4\u05E9\u05D5\u05D3\u05D3\u05D9\u05DD \u05E9\u05DC \u05D4\u05E6\u05DC \u05D4\u05EA\u05D1\u05E6\u05E8\u05D5 \u05D1\u05DE\u05D9\u05E9\u05D5\u05E8\u05D9 \u05D0\u05E8\u05E1. \u05D8\u05D5\u05E1\u05D5 \u05E0\u05DE\u05D5\u05DA \u05DE\u05E2\u05DC \u05D4\u05DE\u05D3\u05D1\u05E8, \u05E9\u05D1\u05E8\u05D5 \u05D0\u05EA \u05D4\u05DE\u05D5\u05E6\u05D1\u05D9\u05DD \u05D5\u05D4\u05E9\u05D9\u05D9\u05E8\u05D5\u05EA \u05E9\u05DC\u05D4\u05DD \u05D5\u05E2\u05E6\u05E8\u05D5 \u05D0\u05EA \u05D6\u05D7\u05DC\u05DF \u05D4\u05D7\u05D5\u05DC \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D9\u05D2\u05D9\u05E2 \u05DC\u05DE\u05D5\u05E9\u05D1\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 839971135
    m_Localized: "\u05EA\u05E7\u05D9\u05E4\u05D4 \u05E4\u05DC\u05E0\u05D8\u05E8\u05D9\u05EA: \u05D4\u05E7\u05E8\u05E7\u05E2 \u05D2\u05D5\u05DC\u05DC\u05EA \u05DE\u05EA\u05D7\u05EA\u05D9\u05DB\u05DD. \u05DE\u05D8\u05E8\u05D5\u05EA \u05D0\u05D5\u05D5\u05D9\u05E8 \u05D5\u05E7\u05E8\u05E7\u05E2, \u05DB\u05E1\u05E3 \u05E2\u05DC \u05DB\u05DC \u05D4\u05E8\u05D9\u05D2\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 839971136
    m_Localized: "\u05D4\u05DE\u05E7\u05DC\u05E2 \u05E4\u05D5\u05D2\u05E2 \u05D2\u05DD \u05D1\u05D0\u05D5\u05D5\u05D9\u05E8 \u05D5\u05D2\u05DD \u05D1\u05E7\u05E8\u05E7\u05E2. \u05DE\u05E2\u05DC \u05D9\u05D7\u05D9\u05D3\u05D5\u05EA \u05E7\u05E8\u05E7\u05E2 \u05D8\u05E1\u05D9\u05DD, \u05D1\u05DB\u05DC\u05D9 \u05D8\u05D9\u05E1 \u05D0\u05E4\u05E9\u05E8 \u05DC\u05D4\u05EA\u05E0\u05D2\u05E9."
    m_Metadata:
      m_Items: []
  - m_Id: 839971137
    m_Localized: "\u05D9\u05E8\u05D5 \u05E7\u05D5\u05D3\u05DD \u05D1\u05E6\u05E8\u05D9\u05D7\u05D9\u05DD \u05E9\u05DC \u05D4\u05D6\u05D7\u05DC\u05DF: \u05D4\u05EA\u05D5\u05EA\u05D7 \u05E9\u05DC\u05D5 \u05DE\u05E9\u05D5\u05E8\u05D9\u05D9\u05DF \u05E2\u05D3 \u05E9\u05D4\u05DD \u05E0\u05D5\u05E4\u05DC\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 839971138
    m_Localized: "\u05E9\u05D3\u05E8\u05EA \u05D4\u05D6\u05D9\u05E7\u05D5\u05E7"
    m_Metadata:
      m_Items: []
  - m_Id: 839971139
    m_Localized: "\u05E9\u05D5\u05E8\u05EA \u05D1\u05EA\u05D9 \u05D6\u05D9\u05E7\u05D5\u05E7 \u05DE\u05D6\u05D9\u05E0\u05D4 \u05D0\u05EA \u05DE\u05DB\u05D5\u05E0\u05D5\u05EA \u05D4\u05DE\u05DC\u05D7\u05DE\u05D4 \u05E9\u05DC \u05D4\u05E6\u05DC. \u05E9\u05E8\u05E4\u05D5 \u05D0\u05EA \u05DE\u05D7\u05E1\u05E0\u05D9 \u05D4\u05D3\u05DC\u05E7, \u05D7\u05E1\u05DC\u05D5 \u05D0\u05EA \u05D4\u05E9\u05D9\u05D9\u05E8\u05D5\u05EA \u05D1\u05D3\u05E8\u05DA \u05D4\u05D0\u05E1\u05E4\u05E7\u05D4 \u05D5\u05D4\u05E4\u05D9\u05DC\u05D5 \u05D0\u05EA \u05E9\u05D5\u05DE\u05E8 \u05D1\u05D9\u05EA \u05D4\u05D6\u05D9\u05E7\u05D5\u05E7."
    m_Metadata:
      m_Items: []
  - m_Id: 839971140
    m_Localized: "\u05DE\u05DB\u05DC\u05D9 \u05D3\u05DC\u05E7 \u05D5\u05DE\u05D7\u05E1\u05E0\u05D9\u05DD \u05DE\u05EA\u05E4\u05D5\u05E6\u05E6\u05D9\u05DD \u05D5\u05DC\u05D5\u05E7\u05D7\u05D9\u05DD \u05D0\u05D9\u05EA\u05DD \u05D0\u05EA \u05D4\u05E9\u05DB\u05E0\u05D9\u05DD. \u05E1\u05E4\u05D9\u05E0\u05D5\u05EA \u05E7\u05E8\u05D1 \u05DE\u05E8\u05D7\u05E4\u05D5\u05EA \u05D5\u05E0\u05DC\u05D7\u05DE\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 839971141
    m_Localized: "\u05D9\u05E8\u05D5 \u05D1\u05DE\u05DB\u05DC \u05D3\u05DC\u05E7 \u05DC\u05D9\u05D3 \u05DE\u05D8\u05E8\u05D5\u05EA \u05E7\u05E8\u05E7\u05E2 \u05D0\u05D7\u05E8\u05D5\u05EA: \u05D4\u05E4\u05D9\u05E6\u05D5\u05E5 \u05DE\u05E9\u05DE\u05D9\u05D3 \u05D2\u05DD \u05D0\u05D5\u05EA\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 839971142
    m_Localized: "\u05D0\u05E1\u05E4\u05D5 \u05D0\u05EA \u05D4\u05DE\u05D2\u05D4-\u05E4\u05E6\u05E6\u05D4 \u05D5\u05E9\u05DE\u05E8\u05D5 \u05D0\u05D5\u05EA\u05D4 \u05DC\u05E9\u05DE\u05D9\u05D9\u05DD \u05E6\u05E4\u05D5\u05E4\u05D9\u05DD."
