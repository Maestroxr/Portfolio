      m_Items: []
  - m_Id: 584118377
    m_Localized: "\u05E0\u05E6\u05D7\u05D5 \u05D0\u05EA \u05D4\u05E9\u05E2\u05D5\u05DF \u05DC\u05E4\u05E0\u05D9 \u05D4\u05E6\u05DC\u05E6\u05D5\u05DC \u05DC\u05D4\u05D6\u05DE\u05E0\u05D4 \u05D0\u05D7\u05E8\u05D5\u05E0\u05D4! \u05DB\u05DC \u05D6\u05D5\u05D2 \u05E9\u05EA\u05DE\u05E6\u05D0\u05D5 \u05DE\u05D5\u05E1\u05D9\u05E3 \u05E9\u05EA\u05D9 \u05E9\u05E0\u05D9\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 584118378
    m_Localized: "\u05D0\u05D7\u05E8\u05D9 \u05D7\u05E6\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118379
    m_Localized: "\u05E7\u05DC\u05E4\u05D9 \u05E9\u05E2\u05D5\u05DF \u05DE\u05E1\u05EA\u05EA\u05E8\u05D9\u05DD \u05D1\u05D9\u05DF \u05D4\u05DE\u05D6\u05DB\u05E8\u05D5\u05EA. \u05D4\u05E4\u05DB\u05D5 \u05D0\u05D7\u05D3 \u05D5\u05E7\u05D1\u05DC\u05D5 \u05E9\u05E9 \u05E9\u05E0\u05D9\u05D5\u05EA \u05E0\u05D5\u05E1\u05E4\u05D5\u05EA!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118380
    m_Localized: "\u05E9\u05D5\u05D1\u05E8\u05D9 \u05DC\u05D1\u05D1\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118381
    m_Localized: "\u05E4\u05E8\u05D0\u05D9 \u05D1\u05DC\u05D1"
    m_Metadata:
      m_Items: []
  - m_Id: 584118382
    m_Localized: "\u05D4\u05D2\u05F3\u05D5\u05E7\u05E8 \u05D4\u05DE\u05D5\u05D6\u05D4\u05D1 \u05DE\u05EA\u05D0\u05D9\u05DD \u05DC\u05DB\u05DC \u05DE\u05D6\u05DB\u05E8\u05EA - \u05D5\u05DE\u05D5\u05E6\u05D0 \u05D1\u05E9\u05D1\u05D9\u05DC\u05DB\u05DD \u05D0\u05EA \u05D4\u05EA\u05D0\u05D5\u05DE\u05D4 \u05E9\u05DC\u05D4!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118383
    m_Localized: "\u05D4\u05E4\u05DB\u05D5 \u05D0\u05EA \u05D4\u05D2\u05F3\u05D5\u05E7\u05E8 \u05D9\u05D7\u05D3 \u05E2\u05DD \u05DE\u05D6\u05DB\u05E8\u05EA \u05DB\u05DC\u05E9\u05D4\u05D9 \u05DB\u05D3\u05D9 \u05DC\u05D4\u05EA\u05D0\u05D9\u05DD \u05D0\u05EA \u05DB\u05DC \u05D4\u05E7\u05DC\u05E4\u05D9\u05DD \u05E9\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 584118384
    m_Localized: "\u05D6\u05E8\u05D9\u05D6\u05D5\u05EA \u05D9\u05D3\u05D9\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 584118385
    m_Localized: "\u05D0\u05E6\u05D1\u05E2\u05D5\u05EA \u05D6\u05E8\u05D9\u05D6\u05D5\u05EA! \u05D0\u05D7\u05E8\u05D9 \u05DB\u05DC \u05D8\u05E2\u05D5\u05EA \u05E9\u05DC\u05D9\u05E9\u05D9\u05EA \u05D4\u05E7\u05DC\u05E4\u05D9\u05DD \u05D4\u05E1\u05D2\u05D5\u05E8\u05D9\u05DD \u05DE\u05D7\u05DC\u05D9\u05E4\u05D9\u05DD \u05DE\u05E7\u05D5\u05DE\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 584118386
    m_Localized: "\u05E9\u05DC\u05D5\u05E9 \u05D8\u05E2\u05D5\u05D9\u05D5\u05EA \u05D5\u05D4\u05D3\u05D9\u05DC\u05E8 \u05DE\u05E2\u05E8\u05D1\u05D1 \u05D0\u05EA \u05D4\u05E7\u05DC\u05E4\u05D9\u05DD \u05D4\u05E1\u05D2\u05D5\u05E8\u05D9\u05DD!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118387
    m_Localized: "\u05DE\u05E9\u05D9 \u05D5\u05E1\u05DB\u05E0\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 584118388
    m_Localized: "\u05E9\u05EA\u05D9 \u05E4\u05E6\u05E6\u05D5\u05EA \u05DE\u05E1\u05EA\u05EA\u05E8\u05D5\u05EA \u05DE\u05D0\u05D7\u05D5\u05E8\u05D9 \u05D4\u05DE\u05E9\u05D9. \u05DB\u05DC \u05D0\u05D7\u05EA \u05E2\u05D5\u05DC\u05D4 \u05DC\u05D1 - \u05D6\u05DB\u05E8\u05D5 \u05D0\u05D9\u05E4\u05D4 \u05D4\u05DF!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118389
    m_Localized: "\u05E1\u05D3\u05E8 \u05D4\u05D4\u05D5\u05E4\u05E2\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118390
    m_Localized: "\u05DC\u05DE\u05E6\u05E2\u05D3 \u05E9\u05DC \u05D4\u05DC\u05D9\u05DC\u05D4 \u05D9\u05E9 \u05E1\u05D3\u05E8 \u05D4\u05D5\u05E4\u05E2\u05D5\u05EA! \u05D4\u05EA\u05D0\u05D9\u05DE\u05D5 \u05D0\u05EA \u05D4\u05DE\u05D6\u05DB\u05E8\u05D5\u05EA \u05DC\u05E4\u05D9 \u05D4\u05E1\u05D3\u05E8 \u05E9\u05DE\u05D5\u05E4\u05D9\u05E2 \u05DC\u05DE\u05E2\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 584118391
    m_Localized: "\u05E8\u05E7 \u05D4\u05DE\u05D6\u05DB\u05E8\u05EA \u05E9\u05D4\u05DE\u05E6\u05E2\u05D3 \u05DE\u05D1\u05E7\u05E9 \u05E0\u05D7\u05E9\u05D1\u05EA. \u05D0\u05EA \u05D4\u05E9\u05D0\u05E8 \u05D6\u05DB\u05E8\u05D5 \u05DC\u05D4\u05DE\u05E9\u05DA!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118392
    m_Localized: "\u05E9\u05DC\u05D5\u05E9\u05D4 \u05D6\u05D4 \u05D7\u05D1\u05E8\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 584118393
    m_Localized: "\u05DE\u05D4\u05D5\u05DE\u05EA \u05D7\u05E6\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118394
    m_Localized: "\u05E4\u05E6\u05E6\u05D5\u05EA, \u05D2\u05F3\u05D5\u05E7\u05E8, \u05E9\u05E2\u05D5\u05DF \u05D5\u05E2\u05E8\u05D1\u05D5\u05D1\u05D9\u05DD, \u05D5\u05D4\u05DB\u05D5\u05DC \u05E0\u05D2\u05D3 \u05D4\u05E9\u05E2\u05D5\u05DF. \u05D4\u05D1\u05D5\u05D3\u05D5\u05D0\u05E8 \u05D0\u05D7\u05E8\u05D9 \u05D7\u05E6\u05D5\u05EA!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118395
    m_Localized: "\u05D4\u05E9\u05EA\u05DE\u05E9\u05D5 \u05D1\u05D2\u05F3\u05D5\u05E7\u05E8 \u05E2\u05DC \u05D4\u05DE\u05D6\u05DB\u05E8\u05EA \u05E9\u05D0\u05EA\u05DD \u05DC\u05D0 \u05DE\u05D5\u05E6\u05D0\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 584118396
    m_Localized: "\u05DB\u05EA\u05E3 \u05E7\u05E8\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 584118397
    m_Localized: "\u05E6\u05E2\u05D3\u05D9\u05DD \u05DE\u05D3\u05D5\u05D3\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 584118398
    m_Localized: "\u05E9\u05D9\u05DE\u05D5 \u05DC\u05D1 \u05DC\u05E6\u05E2\u05D3\u05D9\u05DD: \u05D9\u05E9 \u05DC\u05DB\u05DD \u05E8\u05E7 26 \u05DE\u05D4\u05DC\u05DB\u05D9\u05DD. \u05E7\u05DC\u05E4\u05D9 \u05D4\u05E6\u05E6\u05D4 \u05D7\u05D5\u05E9\u05E4\u05D9\u05DD \u05D0\u05EA \u05DB\u05DC \u05D4\u05DC\u05D5\u05D7 \u05DC\u05E8\u05D2\u05E2."
    m_Metadata:
      m_Items: []
  - m_Id: 584118399
    m_Localized: "\u05D4\u05EA\u05D6\u05DE\u05D5\u05E8\u05EA \u05DE\u05DE\u05E9\u05D9\u05DB\u05D4 \u05DC\u05E0\u05D2\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 584118400
    m_Localized: "\u05E9\u05DC\u05E9\u05D5\u05EA \u05E0\u05D2\u05D3 \u05D4\u05E9\u05E2\u05D5\u05DF. \u05E9\u05DE\u05E8\u05D5 \u05E2\u05DC \u05D4\u05E7\u05E6\u05D1 \u05E2\u05DD \u05D4\u05EA\u05D6\u05DE\u05D5\u05E8\u05EA \u05D5\u05DE\u05E6\u05D0\u05D5 \u05E9\u05DC\u05D5\u05E9\u05D4 \u05D6\u05D4\u05D9\u05DD!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118401
    m_Localized: "\u05D4\u05D7\u05DC\u05E4\u05EA \u05D1\u05E0\u05D9 \u05D6\u05D5\u05D2"
    m_Metadata:
      m_Items: []
  - m_Id: 584118402
    m_Localized: "\u05D4\u05E8\u05E7\u05D3\u05E0\u05D9\u05DD \u05DE\u05D7\u05DC\u05D9\u05E4\u05D9\u05DD \u05D1\u05E0\u05D9 \u05D6\u05D5\u05D2 \u05D0\u05D7\u05E8\u05D9 \u05DB\u05DC \u05D8\u05E2\u05D5\u05EA \u05E9\u05E0\u05D9\u05D9\u05D4 - \u05D5\u05D7\u05DC\u05E7 \u05DE\u05D4\u05E7\u05DC\u05E4\u05D9\u05DD \u05E7\u05E4\u05D5\u05D0\u05D9\u05DD \u05DC\u05D2\u05DE\u05E8\u05D9."
    m_Metadata:
      m_Items: []
  - m_Id: 584118403
    m_Localized: "\u05E9\u05EA\u05D9 \u05D8\u05E2\u05D5\u05D9\u05D5\u05EA \u05D5\u05D4\u05E8\u05E7\u05D3\u05E0\u05D9\u05DD \u05DE\u05D7\u05DC\u05D9\u05E4\u05D9\u05DD \u05D0\u05EA \u05D4\u05E7\u05DC\u05E4\u05D9\u05DD \u05D4\u05E1\u05D2\u05D5\u05E8\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 584118404
    m_Localized: "\u05D4\u05EA\u05D4\u05DC\u05D5\u05DB\u05D4 \u05D4\u05D2\u05D3\u05D5\u05DC\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 584118405
    m_Localized: "\u05EA\u05D4\u05DC\u05D5\u05DB\u05D4 \u05E2\u05DC \u05E7\u05E8\u05D7 \u05D3\u05E7: \u05D4\u05EA\u05D0\u05D9\u05DE\u05D5 \u05DC\u05E4\u05D9 \u05D4\u05E1\u05D3\u05E8 \u05D5\u05D4\u05EA\u05E8\u05D7\u05E7\u05D5 \u05DE\u05D4\u05E4\u05E6\u05E6\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 584118406
    m_Localized: "\u05D4\u05DE\u05E6\u05E2\u05D3 \u05DE\u05E8\u05D0\u05D4 \u05DC\u05DE\u05E2\u05DC\u05D4 \u05D0\u05EA \u05D4\u05DE\u05D6\u05DB\u05E8\u05D5\u05EA \u05D4\u05D1\u05D0\u05D5\u05EA."
    m_Metadata:
      m_Items: []
