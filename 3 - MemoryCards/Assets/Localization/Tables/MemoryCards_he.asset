    m_Localized: "\u05E7\u05DC\u05E4\u05D9\u05DD \u05DC\u05D4\u05EA\u05D0\u05DE\u05D4 ({0}) \u05D7\u05D9\u05D9\u05D1 \u05DC\u05D4\u05D9\u05D5\u05EA 2, 3 \u05D0\u05D5 4"
