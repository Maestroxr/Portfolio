  m_TableData:
  - m_Id: 517009408
    m_Localized: "\u05E7\u05DC\u05E4\u05D9 \u05D6\u05D9\u05DB\u05E8\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 579923968
    m_Localized: "\u05D4\u05EA\u05D0\u05D9\u05DE\u05D5 \u05D7\u05D9\u05D5\u05EA \u05D7\u05DE\u05D5\u05D3\u05D5\u05EA \u05D1\u05E9\u05DC\u05D5\u05E9\u05D4 \u05E2\u05D5\u05DC\u05DE\u05D5\u05EA \u05D5\u05BE18 \u05E9\u05DC\u05D1\u05D9\u05DD: \u05E9\u05E0\u05E0\u05D5, \u05E0\u05E6\u05D7\u05D5 \u05D0\u05EA \u05D4\u05E9\u05E2\u05D5\u05DF, \u05D4\u05EA\u05D7\u05DE\u05E7\u05D5 \u05DE\u05E4\u05E6\u05E6\u05D5\u05EA, \u05E9\u05D7\u05E7\u05D5 \u05E2\u05DD \u05D2\u05F3\u05D5\u05E7\u05E8\u05D9\u05DD, \u05E1\u05D3\u05E7\u05D5 \u05E7\u05E8\u05D7 \u05D5\u05E2\u05E7\u05D1\u05D5 \u05D0\u05D7\u05E8\u05D9 \u05D4\u05DE\u05E6\u05E2\u05D3."
    m_Metadata:
      m_Items: []
  - m_Id: 584118272
    m_Localized: "\u05E7\u05DC\u05D0\u05E1\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 584118273
    m_Localized: "\u05D4\u05DE\u05E8\u05D0\u05D4 \u05D4\u05DE\u05E7\u05D5\u05E8\u05D9: \u05E9\u05DC\u05D5\u05E9\u05D9\u05DD \u05D7\u05D9\u05D5\u05EA \u05D7\u05DE\u05D5\u05D3\u05D5\u05EA, \u05E2\u05D5\u05DC\u05DE\u05D5\u05EA \u05E9\u05D8\u05D5\u05E4\u05D9 \u05E9\u05DE\u05E9 \u05D5\u05D4\u05DE\u05DE\u05E9\u05E7 \u05D4\u05DE\u05E2\u05D5\u05D2\u05DC \u05E9\u05DC Kenney."
    m_Metadata:
      m_Items: []
  - m_Id: 584118274
    m_Localized: "\u05D0\u05D7\u05E8\u05D9 \u05D4\u05D7\u05E9\u05DB\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 584118275
    m_Localized: "\u05E2\u05E8\u05D1 \u05D1\u05D9\u05DC\u05D5\u05D9 \u05DC\u05DE\u05D1\u05D5\u05D2\u05E8\u05D9\u05DD: \u05E9\u05D7\u05D5\u05E8, \u05D6\u05D4\u05D1 \u05D5\u05D0\u05D3\u05D5\u05DD \u05E2\u05DE\u05D5\u05E7, \u05DE\u05E1\u05D2\u05E8\u05D5\u05EA \u05D0\u05E8\u05D8 \u05D3\u05E7\u05D5, \u05E7\u05D8\u05D9\u05E4\u05D4 \u05D5\u05EA\u05D7\u05E8\u05D4, \u05D5\u05D7\u05E4\u05D9\u05E1\u05D4 \u05E9\u05DC \u05E9\u05DC\u05D5\u05E9\u05D9\u05DD \u05DE\u05D6\u05DB\u05E8\u05D5\u05EA \u05D1\u05D5\u05D3\u05D5\u05D0\u05E8 \u05D5\u05D1\u05D5\u05E8\u05DC\u05E1\u05E7."
    m_Metadata:
      m_Items: []
  - m_Id: 584118276
    m_Localized: "\u05E7\u05DC\u05E4\u05D9 \u05D6\u05D9\u05DB\u05E8\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 584118277
    m_Localized: "\u05D4\u05E8\u05E4\u05EA\u05E7\u05EA \u05D6\u05D5\u05D2\u05D5\u05EA \u05E2\u05DD \u05D7\u05D9\u05D5\u05EA \u05D7\u05DE\u05D5\u05D3\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118278
    m_Localized: "\u05DE\u05E9\u05D7\u05E7 \u05D6\u05D5\u05D2\u05D5\u05EA \u05DC\u05E9\u05E2\u05D5\u05EA \u05D4\u05E7\u05D8\u05E0\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118279
    m_Localized: "\u05D7\u05D9\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 584118280
    m_Localized: "\u05D7\u05D9\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118281
    m_Localized: "\u05DE\u05D6\u05DB\u05E8\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118282
    m_Localized: "\u05DE\u05D6\u05DB\u05E8\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118283
    m_Localized: "\u05D4\u05D7\u05D9\u05D5\u05EA \u05D6\u05D6\u05D5\u05EA \u05DE\u05DE\u05E7\u05D5\u05DE\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 584118284
    m_Localized: "\u05D6\u05E8\u05D9\u05D6\u05D5\u05EA \u05D9\u05D3\u05D9\u05D9\u05DD - \u05D4\u05E7\u05DC\u05E4\u05D9\u05DD \u05D6\u05D6\u05D5"
    m_Metadata:
      m_Items: []
  - m_Id: 584118285
    m_Localized: "\u05D4\u05D7\u05D5\u05D5\u05D4 \u05D4\u05E9\u05DE\u05E9\u05D9\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118286
    m_Localized: "\u05D4\u05DB\u05D9\u05E8\u05D5 \u05D0\u05EA \u05D7\u05D1\u05D5\u05E8\u05EA \u05D4\u05D7\u05E6\u05E8!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118287
    m_Localized: "\u05DE\u05E1\u05D9\u05D1\u05EA \u05D2\u05F3\u05D5\u05E0\u05D2\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 584118288
    m_Localized: "\u05DE\u05EA\u05E0\u05D3\u05E0\u05D3\u05D9\u05DD \u05D0\u05DC \u05D4\u05E6\u05D3 \u05D4\u05E4\u05E8\u05D0\u05D9!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118289
    m_Localized: "\u05D7\u05D5\u05E4\u05D9 \u05D4\u05DB\u05E4\u05D5\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 584118290
    m_Localized: "\u05DE\u05EA\u05E7\u05E8\u05E8\u05D9\u05DD \u05E2\u05DD \u05D7\u05D1\u05E8\u05D9\u05DD \u05E7\u05E4\u05D5\u05D0\u05D9\u05DD!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118291
    m_Localized: "\u05E7\u05E8\u05E0\u05D1\u05DC \u05D4\u05D7\u05D9\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118292
    m_Localized: "\u05DB\u05DC \u05D4\u05D7\u05D9\u05D5\u05EA, \u05DB\u05DC \u05D4\u05D4\u05E4\u05EA\u05E2\u05D5\u05EA!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118293
    m_Localized: "\u05D1\u05E8 \u05D4\u05E9\u05DE\u05E4\u05E0\u05D9\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 584118294
    m_Localized: "\u05DB\u05DC \u05DB\u05D5\u05E1, \u05DB\u05DC \u05D4\u05E4\u05EA\u05E2\u05D4!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118295
    m_Localized: "\u05D4\u05D1\u05D5\u05D3\u05D5\u05D0\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 584118296
    m_Localized: "\u05DE\u05E9\u05D9, \u05EA\u05D7\u05E8\u05D4 \u05D5\u05D3\u05DC\u05EA \u05E0\u05E2\u05D5\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 584118297
    m_Localized: "\u05D8\u05E8\u05E7\u05DC\u05D9\u05DF \u05D4\u05E7\u05D8\u05D9\u05E4\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 584118298
    m_Localized: "\u05DE\u05E2\u05DE\u05E2\u05DE\u05D9\u05DD \u05D0\u05EA \u05D4\u05D0\u05D5\u05E8\u05D5\u05EA \u05D5\u05DE\u05EA\u05D9\u05D9\u05E9\u05D1\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 584118299
    m_Localized: "\u05E0\u05E9\u05E3 \u05D4\u05DE\u05E1\u05DB\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118300
    m_Localized: "\u05D4\u05DC\u05D9\u05DC\u05D4 \u05D0\u05E3 \u05D0\u05D7\u05D3 \u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2 \u05DE\u05D9 \u05D0\u05EA\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 584118301
    m_Localized: "\u05D4\u05E2\u05D5\u05DC\u05DD \u05D4\u05D6\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 584118302
    m_Localized: "\u05E9\u05DC\u05D5\u05DD, \u05D7\u05D5\u05D5\u05D4!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118303
    m_Localized: "\u05D4\u05E4\u05DB\u05D5 \u05E9\u05E0\u05D9 \u05E7\u05DC\u05E4\u05D9\u05DD \u05D1\u05DB\u05DC \u05E4\u05E2\u05DD \u05D5\u05DE\u05E6\u05D0\u05D5 \u05D0\u05EA \u05D4\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DC \u05D7\u05D9\u05D5\u05EA \u05D4\u05D7\u05D5\u05D5\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 584118304
    m_Localized: "\u05DC\u05D7\u05E6\u05D5 \u05E2\u05DC \u05E7\u05DC\u05E3 \u05DB\u05D3\u05D9 \u05DC\u05D4\u05E4\u05D5\u05DA \u05D0\u05D5\u05EA\u05D5, \u05D5\u05D0\u05D6 \u05DE\u05E6\u05D0\u05D5 \u05D0\u05EA \u05D4\u05EA\u05D0\u05D5\u05DD \u05E9\u05DC\u05D5!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118305
    m_Localized: "\u05D7\u05D1\u05E8\u05D9\u05DD \u05D1\u05D7\u05E6\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 584118306
    m_Localized: "\u05DE\u05E6\u05D0\u05D5 \u05D6\u05D5\u05D2\u05D5\u05EA \u05D1\u05E8\u05E6\u05E3 \u05D5\u05D1\u05E0\u05D5 \u05E7\u05D5\u05DE\u05D1\u05D5 \u05E9\u05E9\u05D5\u05D5\u05D4 \u05E2\u05D3 \u05E4\u05D9 5 \u05E0\u05E7\u05D5\u05D3\u05D5\u05EA!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118307
    m_Localized: "\u05E7\u05D5\u05DE\u05D1\u05D5"
    m_Metadata:
      m_Items: []
  - m_Id: 584118308
    m_Localized: "\u05D4\u05EA\u05D0\u05DE\u05D5\u05EA \u05D1\u05E8\u05E6\u05E3 \u05DE\u05DB\u05E4\u05D9\u05DC\u05D5\u05EA \u05D0\u05EA \u05D4\u05E0\u05E7\u05D5\u05D3\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 584118309
    m_Localized: "\u05E7\u05D5\u05E7\u05D5!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118310
    m_Localized: "\u05DB\u05DC \u05D4\u05E7\u05DC\u05E4\u05D9\u05DD \u05E0\u05D7\u05E9\u05E4\u05D9\u05DD \u05DC\u05E4\u05E0\u05D9 \u05EA\u05D7\u05D9\u05DC\u05EA \u05D4\u05E1\u05D9\u05D1\u05D5\u05D1. \u05D6\u05DB\u05E8\u05D5 \u05DB\u05DE\u05D4 \u05E9\u05D9\u05D5\u05EA\u05E8!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118311
    m_Localized: "\u05E9\u05D9\u05E0\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 584118312
    m_Localized: "\u05D4\u05E1\u05EA\u05DB\u05DC\u05D5 \u05D4\u05D9\u05D8\u05D1 \u05DB\u05E9\u05D4\u05E7\u05DC\u05E4\u05D9\u05DD \u05D2\u05DC\u05D5\u05D9\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 584118313
    m_Localized: "\u05DE\u05E8\u05D5\u05E5 \u05E0\u05D2\u05D3 \u05D4\u05EA\u05E8\u05E0\u05D2\u05D5\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 584118314
    m_Localized: "\u05E0\u05E6\u05D7\u05D5 \u05D0\u05EA \u05D4\u05E9\u05E2\u05D5\u05DF \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05EA\u05E8\u05E0\u05D2\u05D5\u05DC \u05E7\u05D5\u05E8\u05D0! \u05DB\u05DC \u05D6\u05D5\u05D2 \u05E9\u05EA\u05DE\u05E6\u05D0\u05D5 \u05DE\u05D5\u05E1\u05D9\u05E3 \u05E9\u05EA\u05D9 \u05E9\u05E0\u05D9\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 584118315
    m_Localized: "\u05E0\u05D2\u05D3 \u05D4\u05E9\u05E2\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 584118316
    m_Localized: "\u05D4\u05E9\u05E2\u05D5\u05DF \u05DE\u05EA\u05E7\u05EA\u05E7 - \u05DB\u05DC \u05D4\u05EA\u05D0\u05DE\u05D4 \u05E7\u05D5\u05E0\u05D4 \u05DC\u05DB\u05DD \u05D6\u05DE\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 584118317
    m_Localized: "\u05D4\u05E8\u05E4\u05EA \u05D4\u05DE\u05EA\u05E7\u05EA\u05E7\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118318
    m_Localized: "\u05E7\u05DC\u05E4\u05D9 \u05E9\u05E2\u05D5\u05DF \u05DE\u05E1\u05EA\u05EA\u05E8\u05D9\u05DD \u05D1\u05D9\u05DF \u05D4\u05D7\u05D9\u05D5\u05EA. \u05D4\u05E4\u05DB\u05D5 \u05D0\u05D7\u05D3 \u05D5\u05E7\u05D1\u05DC\u05D5 \u05E9\u05E9 \u05E9\u05E0\u05D9\u05D5\u05EA \u05E0\u05D5\u05E1\u05E4\u05D5\u05EA!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118319
    m_Localized: "\u05E7\u05DC\u05E4\u05D9 \u05E9\u05E2\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 584118320
    m_Localized: "\u05E7\u05DC\u05E4\u05D9 \u05E9\u05E2\u05D5\u05DF \u05E0\u05D5\u05EA\u05E0\u05D9\u05DD \u05DC\u05DB\u05DD \u05D6\u05DE\u05DF \u05E0\u05D5\u05E1\u05E3."
    m_Metadata:
      m_Items: []
  - m_Id: 584118321
    m_Localized: "\u05DE\u05E1\u05D9\u05D1\u05EA \u05EA\u05E8\u05E0\u05D2\u05D5\u05DC\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118322
    m_Localized: "\u05D7\u05DE\u05D9\u05E9\u05D4 \u05DC\u05D1\u05D1\u05D5\u05EA, \u05D5\u05DB\u05DC \u05D8\u05E2\u05D5\u05EA \u05E2\u05D5\u05DC\u05D4 \u05D0\u05D7\u05D3. \u05EA\u05E6\u05DC\u05D9\u05D7\u05D5 \u05DC\u05E9\u05DE\u05D5\u05E8 \u05E2\u05DC \u05DB\u05D5\u05DC\u05DD?"
    m_Metadata:
      m_Items: []
  - m_Id: 584118323
    m_Localized: "\u05D4\u05D9\u05E9\u05E8\u05D3\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118324
    m_Localized: "\u05DB\u05DC \u05D8\u05E2\u05D5\u05EA \u05E2\u05D5\u05DC\u05D4 \u05DC\u05D1 - \u05D7\u05E9\u05D1\u05D5 \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D0\u05EA\u05DD \u05D4\u05D5\u05E4\u05DB\u05D9\u05DD!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118325
    m_Localized: "\u05D1\u05E8\u05D5\u05DB\u05D9\u05DD \u05D4\u05D1\u05D0\u05D9\u05DD \u05DC\u05D2\u05F3\u05D5\u05E0\u05D2\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 584118326
    m_Localized: "\u05D4\u05D2\u05F3\u05D5\u05E7\u05E8 \u05D1\u05E6\u05D1\u05E2\u05D9 \u05D4\u05E7\u05E9\u05EA \u05DE\u05EA\u05D0\u05D9\u05DD \u05DC\u05DB\u05DC \u05D7\u05D9\u05D4 - \u05D5\u05DE\u05D5\u05E6\u05D0 \u05D1\u05E9\u05D1\u05D9\u05DC\u05DB\u05DD \u05D0\u05EA \u05D4\u05EA\u05D0\u05D5\u05DD \u05E9\u05DC\u05D4!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118327
    m_Localized: "\u05D2\u05F3\u05D5\u05E7\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 584118328
    m_Localized: "\u05D4\u05E4\u05DB\u05D5 \u05D0\u05EA \u05D4\u05D2\u05F3\u05D5\u05E7\u05E8 \u05D9\u05D7\u05D3 \u05E2\u05DD \u05D7\u05D9\u05D4 \u05DB\u05DC\u05E9\u05D4\u05D9 \u05DB\u05D3\u05D9 \u05DC\u05D4\u05EA\u05D0\u05D9\u05DD \u05D0\u05EA \u05DB\u05DC \u05D4\u05E7\u05DC\u05E4\u05D9\u05DD \u05E9\u05DC\u05D4."
    m_Metadata:
