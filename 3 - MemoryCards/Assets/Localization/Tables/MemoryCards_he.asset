      m_Items: []
  - m_Id: 588312631
    m_Localized: "\u05D6\u05DB\u05E8\u05D5 \u05D0\u05D9\u05E4\u05D4 \u05D4{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 588312632
    m_Localized: "\u05DC\u05D5\u05D7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 588312633
    m_Localized: "\u05D9\u05D0\u05DC\u05DC\u05D4!"
    m_Metadata:
      m_Items: []
  - m_Id: 588312634
    m_Localized: "\u05D7\u05D3\u05E9: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 588312635
    m_Localized: "\u05E1\u05D8 \u05DE\u05D6\u05DB\u05D4 \u05D1\u05E0\u05E7\u05D5\u05D3\u05D5\u05EA \u05D5\u05D1\u05EA\u05D5\u05E8 \u05E0\u05D5\u05E1\u05E3. \u05D8\u05E2\u05D5\u05EA \u05DE\u05E2\u05D1\u05D9\u05E8\u05D4 \u05D0\u05EA \u05D4\u05EA\u05D5\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 588312636
    m_Localized: "\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D1\u05EA\u05D5\u05E8\u05D5\u05EA: \u05E1\u05D8 \u05DE\u05D6\u05DB\u05D4 \u05D1\u05E0\u05E7\u05D5\u05D3\u05D5\u05EA \u05D5\u05D1\u05EA\u05D5\u05E8 \u05E0\u05D5\u05E1\u05E3, \u05D8\u05E2\u05D5\u05EA \u05DE\u05E2\u05D1\u05D9\u05E8\u05D4 \u05D0\u05EA \u05D4\u05EA\u05D5\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 588312637
    m_Localized: "\u05D4\u05EA\u05D0\u05D9\u05DE\u05D5 \u05D0\u05EA \u05D4{0} \u05DC\u05E4\u05D9 \u05D4\u05E1\u05D3\u05E8 \u05E9\u05D4\u05DE\u05E6\u05E2\u05D3 \u05DE\u05E8\u05D0\u05D4 \u05DC\u05DE\u05E2\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 588312638
    m_Localized: "\u05D2\u05F3\u05D5\u05E7\u05E8!"
    m_Metadata:
      m_Items: []
  - m_Id: 588312639
