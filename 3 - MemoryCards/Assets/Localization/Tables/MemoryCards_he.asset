    m_Metadata:
      m_Items: []
  - m_Id: 584118334
    m_Localized: "\u05E9\u05EA\u05D9 \u05E4\u05E6\u05E6\u05D5\u05EA \u05DE\u05E1\u05EA\u05EA\u05E8\u05D5\u05EA \u05D1\u05D1\u05D5\u05E8. \u05DB\u05DC \u05D0\u05D7\u05EA \u05E2\u05D5\u05DC\u05D4 \u05DC\u05D1 - \u05D6\u05DB\u05E8\u05D5 \u05D0\u05D9\u05E4\u05D4 \u05D4\u05DF!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118335
    m_Localized: "\u05E4\u05E6\u05E6\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118336
    m_Localized: "\u05E4\u05E6\u05E6\u05D4 \u05E2\u05D5\u05DC\u05D4 \u05DC\u05D1. \u05D0\u05D7\u05E8\u05D9 \u05E9\u05E8\u05D0\u05D9\u05EA\u05DD \u05D0\u05D7\u05EA, \u05D4\u05EA\u05E8\u05D7\u05E7\u05D5 \u05DE\u05DE\u05E0\u05D4!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118337
    m_Localized: "\u05DE\u05E6\u05E2\u05D3 \u05D4\u05EA\u05D5\u05DB\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 584118338
    m_Localized: "\u05D4\u05EA\u05D5\u05DB\u05D9\u05DD \u05E8\u05D5\u05E6\u05D9\u05DD \u05DE\u05E6\u05E2\u05D3! \u05D4\u05EA\u05D0\u05D9\u05DE\u05D5 \u05D0\u05EA \u05D4\u05D7\u05D9\u05D5\u05EA \u05DC\u05E4\u05D9 \u05D4\u05E1\u05D3\u05E8 \u05E9\u05DE\u05D5\u05E4\u05D9\u05E2 \u05DC\u05DE\u05E2\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 584118339
    m_Localized: "\u05DE\u05E6\u05E2\u05D3"
    m_Metadata:
      m_Items: []
  - m_Id: 584118340
    m_Localized: "\u05E8\u05E7 \u05D4\u05D7\u05D9\u05D4 \u05E9\u05D4\u05DE\u05E6\u05E2\u05D3 \u05DE\u05D1\u05E7\u05E9 \u05E0\u05D7\u05E9\u05D1\u05EA. \u05D0\u05EA \u05D4\u05E9\u05D0\u05E8 \u05D6\u05DB\u05E8\u05D5 \u05DC\u05D4\u05DE\u05E9\u05DA!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118341
    m_Localized: "\u05E6\u05E8\u05D4 \u05DE\u05E9\u05D5\u05DC\u05E9\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118342
    m_Localized: "\u05DB\u05D0\u05DF \u05D4\u05DB\u05D5\u05DC \u05D1\u05D0 \u05D1\u05E9\u05DC\u05E9\u05D5\u05EA. \u05DE\u05E6\u05D0\u05D5 \u05E9\u05DC\u05D5\u05E9\u05D4 \u05D6\u05D4\u05D9\u05DD \u05DB\u05D3\u05D9 \u05DC\u05D9\u05E6\u05D5\u05E8 \u05D4\u05EA\u05D0\u05DE\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 584118343
    m_Localized: "\u05E9\u05DC\u05E9\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118344
    m_Localized: "\u05D4\u05E4\u05DB\u05D5 \u05E9\u05DC\u05D5\u05E9\u05D4 \u05E7\u05DC\u05E4\u05D9\u05DD \u05EA\u05D5\u05D0\u05DE\u05D9\u05DD \u05DB\u05D3\u05D9 \u05DC\u05D4\u05E9\u05DC\u05D9\u05DD \u05E1\u05D8."
    m_Metadata:
      m_Items: []
  - m_Id: 584118345
    m_Localized: "\u05DE\u05D4\u05D5\u05DE\u05D4 \u05D1\u05D2\u05F3\u05D5\u05E0\u05D2\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 584118346
    m_Localized: "\u05E4\u05E6\u05E6\u05D5\u05EA, \u05D2\u05F3\u05D5\u05E7\u05E8, \u05E9\u05E2\u05D5\u05DF \u05D5\u05E2\u05E8\u05D1\u05D5\u05D1\u05D9\u05DD, \u05D5\u05D4\u05DB\u05D5\u05DC \u05E0\u05D2\u05D3 \u05D4\u05E9\u05E2\u05D5\u05DF. \u05DE\u05D4\u05D5\u05DE\u05D4 \u05D1\u05D2\u05F3\u05D5\u05E0\u05D2\u05DC!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118347
    m_Localized: "\u05D4\u05E9\u05EA\u05DE\u05E9\u05D5 \u05D1\u05D2\u05F3\u05D5\u05E7\u05E8 \u05E2\u05DC \u05D4\u05D7\u05D9\u05D4 \u05E9\u05D0\u05EA\u05DD \u05DC\u05D0 \u05DE\u05D5\u05E6\u05D0\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 584118348
    m_Localized: "\u05E7\u05E8\u05D7 \u05D3\u05E7"
    m_Metadata:
      m_Items: []
  - m_Id: 584118349
    m_Localized: "\u05E7\u05DC\u05E3 \u05E7\u05E4\u05D5\u05D0 \u05E6\u05E8\u05D9\u05DA \u05DC\u05D7\u05D9\u05E6\u05D4 \u05E9\u05EA\u05E1\u05D3\u05D5\u05E7 \u05D0\u05EA \u05D4\u05E7\u05E8\u05D7 \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D0\u05E4\u05E9\u05E8 \u05DC\u05D4\u05E4\u05D5\u05DA \u05D0\u05D5\u05EA\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 584118350
    m_Localized: "\u05E7\u05E8\u05D7"
    m_Metadata:
      m_Items: []
  - m_Id: 584118351
    m_Localized: "\u05DC\u05D7\u05E6\u05D5 \u05E4\u05E2\u05DD \u05D0\u05D7\u05EA \u05E2\u05DC \u05E7\u05DC\u05E3 \u05E7\u05E4\u05D5\u05D0 \u05DB\u05D3\u05D9 \u05DC\u05E1\u05D3\u05D5\u05E7 \u05D0\u05EA \u05D4\u05E7\u05E8\u05D7, \u05D5\u05E9\u05D5\u05D1 \u05DB\u05D3\u05D9 \u05DC\u05D4\u05E4\u05D5\u05DA \u05D0\u05D5\u05EA\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 584118352
    m_Localized: "\u05E6\u05E2\u05D3\u05EA \u05D4\u05E4\u05D9\u05E0\u05D2\u05D5\u05D5\u05D9\u05E0\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 584118353
    m_Localized: "\u05E6\u05E2\u05D3\u05D5 \u05D1\u05D7\u05D5\u05DB\u05DE\u05D4: \u05D9\u05E9 \u05DC\u05DB\u05DD \u05E8\u05E7 26 \u05DE\u05D4\u05DC\u05DB\u05D9\u05DD. \u05E7\u05DC\u05E4\u05D9 \u05D4\u05E6\u05E6\u05D4 \u05D7\u05D5\u05E9\u05E4\u05D9\u05DD \u05D0\u05EA \u05DB\u05DC \u05D4\u05DC\u05D5\u05D7 \u05DC\u05E8\u05D2\u05E2."
    m_Metadata:
      m_Items: []
  - m_Id: 584118354
    m_Localized: "\u05DE\u05D4\u05DC\u05DB\u05D9\u05DD \u05D5\u05D4\u05E6\u05E6\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118355
    m_Localized: "\u05E7\u05DC\u05E4\u05D9 \u05D4\u05E6\u05E6\u05D4 \u05D7\u05D5\u05E9\u05E4\u05D9\u05DD \u05DC\u05E8\u05D2\u05E2 \u05D0\u05EA \u05DB\u05DC \u05D4\u05E7\u05DC\u05E4\u05D9\u05DD \u05D4\u05E1\u05D2\u05D5\u05E8\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 584118356
    m_Localized: "\u05E9\u05D9\u05E8\u05EA \u05D4\u05DC\u05D5\u05D5\u05D9\u05D9\u05EA\u05E0\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 584118357
    m_Localized: "\u05E9\u05DC\u05E9\u05D5\u05EA \u05E0\u05D2\u05D3 \u05D4\u05E9\u05E2\u05D5\u05DF. \u05E9\u05D9\u05E8\u05D5 \u05D0\u05D9\u05EA\u05DD \u05D5\u05DE\u05E6\u05D0\u05D5 \u05E9\u05DC\u05D5\u05E9\u05D4 \u05D6\u05D4\u05D9\u05DD!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118358
    m_Localized: "\u05DB\u05DC \u05E9\u05DC\u05E9\u05D4 \u05DE\u05D5\u05E1\u05D9\u05E4\u05D4 \u05E9\u05DC\u05D5\u05E9 \u05E9\u05E0\u05D9\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 584118359
    m_Localized: "\u05E1\u05D5\u05E4\u05EA \u05E9\u05DC\u05D2\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 584118360
    m_Localized: "\u05E1\u05D5\u05E4\u05EA \u05E9\u05DC\u05D2\u05D9\u05DD \u05DE\u05E4\u05D6\u05E8\u05EA \u05D0\u05EA \u05D4\u05E7\u05DC\u05E4\u05D9\u05DD \u05D0\u05D7\u05E8\u05D9 \u05DB\u05DC \u05D8\u05E2\u05D5\u05EA \u05E9\u05E0\u05D9\u05D9\u05D4 - \u05D5\u05D7\u05DC\u05E7\u05DD \u05E7\u05E4\u05D5\u05D0\u05D9\u05DD \u05DC\u05D2\u05DE\u05E8\u05D9."
    m_Metadata:
      m_Items: []
  - m_Id: 584118361
    m_Localized: "\u05E9\u05EA\u05D9 \u05D8\u05E2\u05D5\u05D9\u05D5\u05EA \u05D5\u05D4\u05E1\u05D5\u05E4\u05D4 \u05DE\u05E2\u05E8\u05D1\u05D1\u05EA \u05D0\u05EA \u05D4\u05E7\u05DC\u05E4\u05D9\u05DD \u05D4\u05E1\u05D2\u05D5\u05E8\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 584118362
    m_Localized: "\u05DE\u05E6\u05E2\u05D3 \u05E7\u05D5\u05D8\u05D1\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 584118363
    m_Localized: "\u05DE\u05E6\u05E2\u05D3 \u05E2\u05DC \u05E7\u05E8\u05D7 \u05D3\u05E7: \u05D4\u05EA\u05D0\u05D9\u05DE\u05D5 \u05DC\u05E4\u05D9 \u05D4\u05E1\u05D3\u05E8 \u05D5\u05D4\u05EA\u05E8\u05D7\u05E7\u05D5 \u05DE\u05D4\u05E4\u05E6\u05E6\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 584118364
    m_Localized: "\u05D4\u05DE\u05E6\u05E2\u05D3 \u05DE\u05E8\u05D0\u05D4 \u05DC\u05DE\u05E2\u05DC\u05D4 \u05D0\u05EA \u05D4\u05D7\u05D9\u05D5\u05EA \u05D4\u05D1\u05D0\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 584118365
    m_Localized: "\u05D2\u05DE\u05E8 \u05D4\u05D6\u05D5\u05D4\u05E8 \u05D4\u05E6\u05E4\u05D5\u05E0\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 584118366
    m_Localized: "\u05D4\u05D2\u05DE\u05E8 \u05D4\u05D2\u05D3\u05D5\u05DC \u05EA\u05D7\u05EA \u05D4\u05D6\u05D5\u05D4\u05E8 \u05D4\u05E6\u05E4\u05D5\u05E0\u05D9. \u05DB\u05DC \u05D4\u05D4\u05E4\u05EA\u05E2\u05D5\u05EA \u05E9\u05DC\u05DE\u05D3\u05EA\u05DD, \u05D1\u05D1\u05EA \u05D0\u05D7\u05EA!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118367
    m_Localized: "\u05E9\u05DE\u05E8\u05D5 \u05D0\u05EA \u05E7\u05DC\u05E3 \u05D4\u05D4\u05E6\u05E6\u05D4 \u05DC\u05E8\u05D2\u05E2 \u05E9\u05D1\u05D5 \u05D4\u05DC\u05D5\u05D7 \u05DE\u05DC\u05D0 \u05D1\u05E1\u05D9\u05DE\u05E0\u05D9 \u05E9\u05D0\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 584118368
    m_Localized: "\u05E7\u05E8\u05E0\u05D1\u05DC \u05D0\u05D9\u05E0\u05E1\u05D5\u05E4\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 584118369
    m_Localized: "\u05E0\u05E7\u05D5 \u05DC\u05D5\u05D7 \u05D0\u05D7\u05E8\u05D9 \u05DC\u05D5\u05D7 \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05D6\u05DE\u05DF \u05E0\u05D2\u05DE\u05E8. \u05DB\u05DC \u05DC\u05D5\u05D7 \u05E9\u05DE\u05E0\u05E7\u05D9\u05DD \u05DE\u05D5\u05E1\u05D9\u05E3 \u05D6\u05DE\u05DF, \u05D5\u05D4\u05E4\u05EA\u05E2\u05D5\u05EA \u05D7\u05D3\u05E9\u05D5\u05EA \u05DE\u05E6\u05D8\u05E8\u05E4\u05D5\u05EA \u05DC\u05D7\u05D2\u05D9\u05D2\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 584118370
    m_Localized: "\u05DE\u05E9\u05D7\u05E7 \u05D7\u05D5\u05E4\u05E9\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 584118371
    m_Localized: "\u05D7\u05DC\u05E7\u05D5 \u05DC\u05D5\u05D7 \u05E2\u05DD \u05D7\u05D5\u05E7\u05D9\u05DD \u05DE\u05E9\u05DC\u05DB\u05DD: \u05E4\u05EA\u05D7\u05D5 \u05D0\u05EA \u05D4\u05D4\u05D2\u05D3\u05E8\u05D5\u05EA \u05D5\u05D1\u05D7\u05E8\u05D5 \u05D2\u05D5\u05D3\u05DC, \u05E9\u05E2\u05D5\u05DF, \u05DC\u05D1\u05D1\u05D5\u05EA, \u05DE\u05D4\u05DC\u05DB\u05D9\u05DD \u05D5\u05E7\u05DC\u05E4\u05D9\u05DD \u05DE\u05D9\u05D5\u05D7\u05D3\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 584118372
    m_Localized: "\u05D4\u05D3\u05DC\u05EA\u05D5\u05EA \u05E0\u05E4\u05EA\u05D7\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 584118373
    m_Localized: "\u05D4\u05E4\u05DB\u05D5 \u05E9\u05E0\u05D9 \u05E7\u05DC\u05E4\u05D9\u05DD \u05D1\u05DB\u05DC \u05E4\u05E2\u05DD \u05D5\u05DE\u05E6\u05D0\u05D5 \u05D0\u05EA \u05D4\u05D6\u05D5\u05D2\u05D5\u05EA. \u05D4\u05DC\u05D9\u05DC\u05D4 \u05E2\u05D5\u05D3 \u05E6\u05E2\u05D9\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 584118374
    m_Localized: "\u05D7\u05D1\u05E8\u05D4 \u05DE\u05D1\u05E2\u05D1\u05E2\u05EA"
    m_Metadata:
      m_Items: []
