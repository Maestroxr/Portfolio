      m_Items: []
  - m_Id: 588312616
    m_Localized: "\u05E1\u05D9\u05D9\u05DE\u05D5 {0} \u05E9\u05DC\u05D1\u05D9\u05DD \u05DB\u05D3\u05D9 \u05DC\u05E4\u05EA\u05D5\u05D7 \u05D0\u05EA \u05D4\u05DE\u05E9\u05D7\u05E7 \u05D4\u05D0\u05D9\u05E0\u05E1\u05D5\u05E4\u05D9."
    m_Metadata:
      m_Items: []
  - m_Id: 588312617
    m_Localized: "\u05D0\u05E1\u05E4\u05D5 {0} \u05DB\u05D5\u05DB\u05D1\u05D9\u05DD \u05DB\u05D3\u05D9 \u05DC\u05E4\u05EA\u05D5\u05D7 \u05D0\u05EA {1} (\u05E2\u05D3 \u05E2\u05DB\u05E9\u05D9\u05D5: {2})."
    m_Metadata:
      m_Items: []
  - m_Id: 588312618
    m_Localized: "\u05E1\u05D9\u05D9\u05DE\u05D5 \u05D0\u05EA \u05D4\u05E9\u05DC\u05D1 \u05D4\u05E7\u05D5\u05D3\u05DD \u05DB\u05D3\u05D9 \u05DC\u05E4\u05EA\u05D5\u05D7 \u05D0\u05EA \u05D4\u05E9\u05DC\u05D1 \u05D4\u05D6\u05D4."
