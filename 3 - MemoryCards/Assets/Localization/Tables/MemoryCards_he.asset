    m_Localized: "\u05E1\u05D9\u05D9\u05DE\u05D5 \u05D1\u05BE{0} \u05DE\u05D4\u05DC\u05DB\u05D9\u05DD \u05D0\u05D5 \u05E4\u05D7\u05D5\u05EA"
