    m_Localized: "\u05DE\u05E1\u05E4\u05E8 \u05D4\u05E7\u05DC\u05E4\u05D9\u05DD ({0}) \u05D7\u05D9\u05D9\u05D1 \u05DC\u05D4\u05D9\u05D5\u05EA \u05D1\u05D9\u05DF {1} \u05DC\u05BE{2}"
