    m_Metadata:
      m_Items: []
  - m_Id: 584118330
    m_Localized: "\u05E7\u05D5\u05E4\u05D9\u05DD \u05D7\u05E6\u05D5\u05E4\u05D9\u05DD! \u05D0\u05D7\u05E8\u05D9 \u05DB\u05DC \u05D8\u05E2\u05D5\u05EA \u05E9\u05DC\u05D9\u05E9\u05D9\u05EA \u05D4\u05E7\u05DC\u05E4\u05D9\u05DD \u05D4\u05E1\u05D2\u05D5\u05E8\u05D9\u05DD \u05DE\u05D7\u05DC\u05D9\u05E4\u05D9\u05DD \u05DE\u05E7\u05D5\u05DE\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 584118331
    m_Localized: "\u05E2\u05E8\u05D1\u05D5\u05D1"
    m_Metadata:
      m_Items: []
  - m_Id: 584118332
    m_Localized: "\u05E9\u05DC\u05D5\u05E9 \u05D8\u05E2\u05D5\u05D9\u05D5\u05EA \u05D5\u05D4\u05E7\u05D5\u05E4\u05D9\u05DD \u05DE\u05E2\u05E8\u05D1\u05D1\u05D9\u05DD \u05D0\u05EA \u05D4\u05E7\u05DC\u05E4\u05D9\u05DD \u05D4\u05E1\u05D2\u05D5\u05E8\u05D9\u05DD!"
    m_Metadata:
      m_Items: []
  - m_Id: 584118333
