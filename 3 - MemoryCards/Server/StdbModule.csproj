<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The server module of this game: the Gamebox base server plus the Lib.cs next to this file.
    BaseServer.props brings the settings, the SpacetimeDB runtime and the base server sources (shown under
    BaseServer/). The path leads to the BaseServer package of the BaseGame repository, which sits next to this
    repository. The TargetFramework stays here because the spacetime CLI reads it from this file.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <Import Project="../../../BaseGame/BaseServer/Server~/BaseServer.props" />

  <!--
    The rules of the game are the model of the Unity project (Assets/Scripts/Model: the dealer, the round, the versus
    rules, the board in the room options), compiled into the module as they are, with the little they use of
    UnityEngine (Model/Shim~) and the random helpers of BaseGame's Gamebox.Lockstep they shuffle with. One rule set for
    the client and the server.
  -->
  <ItemGroup>
    <Compile Include="../Assets/Scripts/Model/*.cs" Link="Model/%(Filename)%(Extension)" />
    <Compile Include="../Assets/Scripts/Model/Shim~/UnityEngine.cs" Link="Model/UnityEngine.cs" />
    <Compile Include="../../../BaseGame/Assets/Scripts/Lockstep/SeededRandom.cs" Link="Gamebox.Lockstep/SeededRandom.cs" />
  </ItemGroup>

</Project>
