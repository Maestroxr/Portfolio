<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests of the rules of Memory Cards outside Unity: `dotnet test` in this folder runs them in about a second.
    They are the same test files the editor runs (Assets/Tests/Editor), compiled together with the model
    (Assets/Scripts/Model) and the little it needs of UnityEngine (Model/Shim~), the way the server module compiles
    the model in; BaseGame's ModelTests.props brings the test packages and Gamebox.Lockstep. The tests that need the
    engine (the campaign, the settings) stay with the editor.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Portfolio.MemoryCards.Tests</RootNamespace>
    <AssemblyName>MemoryCards.Model.Tests</AssemblyName>
  </PropertyGroup>

  <Import Project="../../../BaseGame/Assets/Tests/ModelTests~/ModelTests.props" />

  <ItemGroup>
    <Compile Include="../Assets/Scripts/Model/*.cs" Link="Model/%(Filename)%(Extension)" />
    <Compile Include="../Assets/Scripts/Model/Shim~/UnityEngine.cs" Link="Model/UnityEngine.cs" />
    <Compile Include="../Assets/Tests/Editor/Boards.cs" Link="Tests/Boards.cs" />
    <Compile Include="../Assets/Tests/Editor/BoardOptionsTest.cs" Link="Tests/BoardOptionsTest.cs" />
    <Compile Include="../Assets/Tests/Editor/DealerTest.cs" Link="Tests/DealerTest.cs" />
    <Compile Include="../Assets/Tests/Editor/MemoryRoundTest.cs" Link="Tests/MemoryRoundTest.cs" />
    <Compile Include="../Assets/Tests/Editor/VersusMatchTest.cs" Link="Tests/VersusMatchTest.cs" />
  </ItemGroup>

</Project>
