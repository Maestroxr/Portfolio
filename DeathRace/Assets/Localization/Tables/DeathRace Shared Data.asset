    m_Key: Repairs cost nothing between races
    m_Metadata:
      m_Items: []
  - m_Id: 167266114117633
    m_Key: $5,000 Cash
    m_Metadata:
      m_Items: []
  - m_Id: 167266114117634
    m_Key: Five thousand dollars into your career's wallet
    m_Metadata:
      m_Items: []
