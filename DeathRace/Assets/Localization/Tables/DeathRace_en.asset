    m_Localized: '{0} mortar shells'
    m_Metadata:
      m_Items: []
  - m_Id: 167266114117805
    m_Localized: '{0}, with {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 167266114117806
    m_Localized: Beat {0} to take the title.
    m_Metadata:
      m_Items: []
  - m_Id: 167266114117807
    m_Localized: Win the {0} to open it.
    m_Metadata:
      m_Items: []
  - m_Id: 167266114117808
    m_Localized: '{0} is beaten. You are the champion of the {1}.'
    m_Metadata:
      m_Items: []
  - m_Id: 167266114117809
    m_Localized: Move Up to the {0}
    m_Metadata:
      m_Items: []
  - m_Id: 167266114117810
    m_Localized: Move Up
    m_Metadata:
      m_Items: []
  - m_Id: 167266114117811
    m_Localized: 'The {0} is open: {1} and the bottom of a new ladder, with {2} waiting at the top.'
    m_Metadata:
      m_Items: []
  - m_Id: 167266114117812
    m_Localized: There is no league left to win. The wasteland is yours.
    m_Metadata:
      m_Items: []
  - m_Id: 167266114117813
    m_Localized: 'You beat {0}: you are the champion!'
    m_Metadata:
      m_Items: []
  - m_Id: 167266114117814
    m_Localized: '{0} keeps the title. Climb back to the top and try again.'
