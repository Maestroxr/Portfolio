    m_Metadata:
      m_Items: []
  - m_Id: 974168090
    m_Localized: The other races of the day
    m_Metadata:
      m_Items: []
  - m_Id: 974168091
    m_Localized: '{0} wrecked'
    m_Metadata:
      m_Items: []
  - m_Id: 974168092
    m_Localized: 'You beat The Warden: you are the champion!'
    m_Metadata:
      m_Items: []
  - m_Id: 974168093
    m_Localized: The Warden keeps the title. Climb back to the top and try again.
    m_Metadata:
      m_Items: []
