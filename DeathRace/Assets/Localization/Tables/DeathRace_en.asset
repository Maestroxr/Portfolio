    m_Items: []
  m_TableData:
  - m_Id: 915447808
    m_Localized: Rustbucket
    m_Metadata:
      m_Items: []
  - m_Id: 965779456
    m_Localized: Hornet
    m_Metadata:
      m_Items: []
  - m_Id: 969973760
    m_Localized: Bulldog
    m_Metadata:
      m_Items: []
  - m_Id: 969973761
    m_Localized: Viper
    m_Metadata:
      m_Items: []
  - m_Id: 969973762
    m_Localized: Reaper
    m_Metadata:
      m_Items: []
  - m_Id: 969973763
    m_Localized: Tyrant
    m_Metadata:
      m_Items: []
  - m_Id: 969973764
    m_Localized: A hatchback held together by rust and hope. Free, and worth it.
    m_Metadata:
      m_Items: []
  - m_Id: 969973765
    m_Localized: A light coupe that darts through the pack. Quick off the line, quicker into the barrier.
    m_Metadata:
      m_Items: []
  - m_Id: 969973766
    m_Localized: A pickup with a bull bar and a grudge. Slow to turn, hard to stop, harder to kill.
    m_Metadata:
      m_Items: []
  - m_Id: 969973767
    m_Localized: Eight cylinders, a spoiler and no patience. The first car that can win a hard race.
    m_Metadata:
      m_Items: []
  - m_Id: 969973768
    m_Localized: A low black wedge that corners like it is on rails. Expensive, and it shows.
    m_Metadata:
      m_Items: []
  - m_Id: 969973769
    m_Localized: 'An armoured interceptor built for one thing: being the last car running.'
    m_Metadata:
      m_Items: []
  - m_Id: 969973770
    m_Localized: Scorched
    m_Metadata:
      m_Items: []
  - m_Id: 969973771
    m_Localized: Harsh desert daylight, rust and dust.
    m_Metadata:
      m_Items: []
  - m_Id: 969973772
    m_Localized: Nightfall
    m_Metadata:
      m_Items: []
  - m_Id: 969973773
    m_Localized: 'Night racing under neon: headlights, glowing barriers, wet asphalt.'
    m_Metadata:
      m_Items: []
  - m_Id: 969973774
    m_Localized: The saved career is incomplete.
    m_Metadata:
      m_Items: []
  - m_Id: 969973775
    m_Localized: This career was saved by a newer version of the game.
    m_Metadata:
      m_Items: []
  - m_Id: 969973776
    m_Localized: Rookie
    m_Metadata:
      m_Items: []
  - m_Id: 969973777
    m_Localized: You
    m_Metadata:
      m_Items: []
  - m_Id: 969973778
    m_Localized: There is no career to save.
    m_Metadata:
      m_Items: []
  - m_Id: 969973779
    m_Localized: A career cannot be saved during a race.
    m_Metadata:
      m_Items: []
  - m_Id: 969973780
    m_Localized: A career cannot be loaded during a race.
    m_Metadata:
      m_Items: []
  - m_Id: 969973781
    m_Localized: '{0}, day {1}: {2}, {3}'
    m_Metadata:
      m_Items: []
  - m_Id: 969973782
    m_Localized: (champion)
    m_Metadata:
      m_Items: []
  - m_Id: 969973783
    m_Localized: Engine
    m_Metadata:
      m_Items: []
  - m_Id: 969973784
    m_Localized: 'More power: a higher top speed and harder acceleration.'
    m_Metadata:
      m_Items: []
  - m_Id: 969973785
    m_Localized: Tires
    m_Metadata:
      m_Items: []
  - m_Id: 969973786
    m_Localized: 'More grip: tighter corners and less sliding.'
    m_Metadata:
      m_Items: []
  - m_Id: 969973787
    m_Localized: Armor
    m_Metadata:
      m_Items: []
  - m_Id: 969973788
    m_Localized: 'Thicker plating: every hit hurts less and the car takes more.'
    m_Metadata:
      m_Items: []
  - m_Id: 969973789
    m_Localized: Spiked Bumper
    m_Metadata:
      m_Items: []
  - m_Id: 969973790
    m_Localized: 'Steel spikes on the nose: rams hurt the other car more and yours less.'
    m_Metadata:
      m_Items: []
  - m_Id: 969973791
    m_Localized: Armor-Piercing Rounds
    m_Metadata:
      m_Items: []
  - m_Id: 969973792
    m_Localized: The machine gun hits half as hard again.
    m_Metadata:
      m_Items: []
  - m_Id: 969973793
    m_Localized: Repair
    m_Metadata:
      m_Items: []
  - m_Id: 969973794
    m_Localized: Panel beating and welding, paid by the point of health.
    m_Metadata:
      m_Items: []
  - m_Id: 969973795
    m_Localized: Mine
    m_Metadata:
      m_Items: []
  - m_Id: 969973796
    m_Localized: Dropped behind the car; it arms in a moment and blows up whoever drives over it.
    m_Metadata:
      m_Items: []
  - m_Id: 969973797
    m_Localized: Rocket
    m_Metadata:
      m_Items: []
  - m_Id: 969973798
    m_Localized: Fired ahead; it finds the nearest car in front and hits hard.
    m_Metadata:
      m_Items: []
  - m_Id: 969973799
    m_Localized: Nitro
    m_Metadata:
      m_Items: []
  - m_Id: 969973800
    m_Localized: 'A bottle of boost: a few seconds of much more speed.'
    m_Metadata:
      m_Items: []
  - m_Id: 969973801
    m_Localized: Sabotage
    m_Metadata:
      m_Items: []
  - m_Id: 969973802
    m_Localized: 'A word with a mechanic: the driver you pick starts their next race badly hurt.'
    m_Metadata:
      m_Items: []
  - m_Id: 969973803
    m_Localized: Pick a driver to sabotage
    m_Metadata:
      m_Items: []
  - m_Id: 969973804
    m_Localized: A car is sabotaged already
    m_Metadata:
      m_Items: []
  - m_Id: 969973805
    m_Localized: Your car is better
    m_Metadata:
      m_Items: []
  - m_Id: 969973806
    m_Localized: You drive it already
    m_Metadata:
      m_Items: []
  - m_Id: 969973807
    m_Localized: The car is in one piece
    m_Metadata:
      m_Items: []
  - m_Id: 969973808
    m_Localized: The Warden
    m_Metadata:
      m_Items: []
  - m_Id: 969973809
    m_Localized: Nobody has seen the face behind the visor. Nobody who raced The Warden has kept their car.
    m_Metadata:
      m_Items: []
  - m_Id: 969973810
    m_Localized: Two-Bit Terry
    m_Metadata:
      m_Items: []
  - m_Id: 969973811
    m_Localized: Races for gas money and usually loses it.
    m_Metadata:
      m_Items: []
  - m_Id: 969973812
    m_Localized: Rusty Nails
    m_Metadata:
      m_Items: []
  - m_Id: 969973813
    m_Localized: Welds his own armour. It shows.
    m_Metadata:
      m_Items: []
  - m_Id: 969973814
    m_Localized: Dirt Nap Danny
    m_Metadata:
      m_Items: []
  - m_Id: 969973815
    m_Localized: Has been wrecked more times than anyone alive.
    m_Metadata:
      m_Items: []
  - m_Id: 969973816
    m_Localized: Lugnut Lou
    m_Metadata:
      m_Items: []
  - m_Id: 969973817
    m_Localized: Fixes cars by day, crashes them by night.
    m_Metadata:
      m_Items: []
  - m_Id: 969973818
    m_Localized: Sally Shrapnel
    m_Metadata:
      m_Items: []
  - m_Id: 969973819
    m_Localized: Drops mines like breadcrumbs.
    m_Metadata:
      m_Items: []
  - m_Id: 969973820
    m_Localized: Crash Kowalski
    m_Metadata:
      m_Items: []
  - m_Id: 969973821
    m_Localized: Brakes are for other people.
    m_Metadata:
      m_Items: []
  - m_Id: 969973822
    m_Localized: Nitro Nell
    m_Metadata:
      m_Items: []
  - m_Id: 969973823
    m_Localized: Never seen a straight she could not set on fire.
    m_Metadata:
      m_Items: []
  - m_Id: 969973824
    m_Localized: Diesel Dan
    m_Metadata:
      m_Items: []
  - m_Id: 969973825
    m_Localized: Slow, heavy and impossible to push off the road.
    m_Metadata:
      m_Items: []
  - m_Id: 969973826
    m_Localized: Scorpion Sue
    m_Metadata:
      m_Items: []
  - m_Id: 969973827
    m_Localized: Smiles at you on the grid. Shoots you at the first corner.
    m_Metadata:
      m_Items: []
  - m_Id: 969973828
    m_Localized: The Butcher
    m_Metadata:
      m_Items: []
  - m_Id: 969973829
    m_Localized: Keeps a tally of wrecks painted on his door.
    m_Metadata:
      m_Items: []
  - m_Id: 969973830
    m_Localized: Lady Lockjaw
    m_Metadata:
      m_Items: []
  - m_Id: 969973831
    m_Localized: Once she is on your bumper she does not let go.
    m_Metadata:
      m_Items: []
  - m_Id: 969973832
    m_Localized: Johnny Napalm
    m_Metadata:
      m_Items: []
  - m_Id: 969973833
    m_Localized: Lit his first car on fire on purpose.
    m_Metadata:
      m_Items: []
  - m_Id: 969973834
    m_Localized: Vera Venom
    m_Metadata:
      m_Items: []
  - m_Id: 969973835
    m_Localized: Armour-piercing rounds and a short temper.
    m_Metadata:
      m_Items: []
  - m_Id: 969973836
    m_Localized: Iron Ivan
    m_Metadata:
      m_Items: []
  - m_Id: 969973837
    m_Localized: Drives a tank and calls it a car.
    m_Metadata:
      m_Items: []
  - m_Id: 969973838
    m_Localized: Blaze Monroe
    m_Metadata:
      m_Items: []
  - m_Id: 969973839
    m_Localized: Former stunt driver. Still does the stunts, now with rockets.
    m_Metadata:
      m_Items: []
  - m_Id: 969973840
    m_Localized: Hammerhead
    m_Metadata:
      m_Items: []
  - m_Id: 969973841
    m_Localized: Rams first, asks never.
    m_Metadata:
      m_Items: []
  - m_Id: 969973842
    m_Localized: Mad Maxine
    m_Metadata:
      m_Items: []
  - m_Id: 969973843
    m_Localized: The fastest pair of hands in the wasteland.
    m_Metadata:
      m_Items: []
  - m_Id: 969973844
    m_Localized: Viktor Vex
    m_Metadata:
      m_Items: []
  - m_Id: 969973845
    m_Localized: Cold, clean and three wins from the title.
    m_Metadata:
      m_Items: []
  - m_Id: 969973846
    m_Localized: The Undertaker
    m_Metadata:
      m_Items: []
  - m_Id: 969973847
    m_Localized: Measures his rivals for coffins before the green light.
    m_Metadata:
      m_Items: []
  - m_Id: 969973848
    m_Localized: Medium
    m_Metadata:
      m_Items: []
  - m_Id: 969973849
    m_Localized: Showdown
    m_Metadata:
