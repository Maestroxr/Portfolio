    m_Metadata:
      m_Items: []
  - m_Id: 969973875
    m_Localized: "\u05DE\u05E8\u05D5\u05E5 \u05DE\u05D4\u05D9\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 969973876
    m_Localized: "\u05D1\u05D7\u05E8\u05D5 \u05DE\u05E1\u05DC\u05D5\u05DC, \u05DE\u05DB\u05D5\u05E0\u05D9\u05EA \u05D5\u05E8\u05DE\u05EA \u05E7\u05D5\u05E9\u05D9. \u05D1\u05DC\u05D9 \u05DB\u05E1\u05E3 \u05D5\u05D1\u05DC\u05D9 \u05D3\u05D9\u05E8\u05D5\u05D2: \u05E8\u05E7 \u05D4\u05DE\u05E8\u05D5\u05E5."
    m_Metadata:
      m_Items: []
  - m_Id: 969973877
    m_Localized: "\u05DE\u05D7\u05E9\u05D1"
    m_Metadata:
      m_Items: []
