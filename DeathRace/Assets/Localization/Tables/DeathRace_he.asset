    m_Localized: "\u05D4\u05D9\u05D3\u05D9\u05D9\u05DD \u05D4\u05DE\u05D4\u05D9\u05E8\u05D5\u05EA \u05D1\u05D9\u05D5\u05EA\u05E8 \u05D1\u05E9\u05DE\u05DE\u05D4."
    m_Metadata:
      m_Items: []
