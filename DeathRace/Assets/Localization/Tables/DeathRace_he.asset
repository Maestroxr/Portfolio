    m_Metadata:
      m_Items: []
  - m_Id: 969973825
    m_Localized: "\u05D0\u05D9\u05D8\u05D9, \u05DB\u05D1\u05D3, \u05D5\u05D0\u05D9 \u05D0\u05E4\u05E9\u05E8 \u05DC\u05D3\u05D7\u05D5\u05E7 \u05D0\u05D5\u05EA\u05D5 \u05DE\u05D4\u05DB\u05D1\u05D9\u05E9."
    m_Metadata:
      m_Items: []
  - m_Id: 969973826
    m_Localized: "\u05E1\u05D5 \u05D4\u05E2\u05E7\u05E8\u05D1\u05D9\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 969973827
    m_Localized: "\u05DE\u05D7\u05D9\u05D9\u05DB\u05EA \u05D0\u05DC\u05D9\u05DA \u05D1\u05D6\u05D9\u05E0\u05D5\u05E7. \u05D9\u05D5\u05E8\u05D4 \u05D1\u05DA \u05D1\u05E4\u05E0\u05D9\u05D9\u05D4 \u05D4\u05E8\u05D0\u05E9\u05D5\u05E0\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 969973828
    m_Localized: "\u05D4\u05E7\u05E6\u05D1"
    m_Metadata:
      m_Items: []
  - m_Id: 969973829
    m_Localized: "\u05E1\u05D5\u05E4\u05E8 \u05D0\u05EA \u05D4\u05DE\u05DB\u05D5\u05E0\u05D9\u05D5\u05EA \u05E9\u05E8\u05D9\u05E1\u05E7 \u05D1\u05E1\u05D9\u05DE\u05E0\u05D9\u05DD \u05E6\u05D1\u05D5\u05E2\u05D9\u05DD \u05E2\u05DC \u05D4\u05D3\u05DC\u05EA."
    m_Metadata:
      m_Items: []
