    m_Localized: "\u05E0\u05D5\u05D4\u05D2 \u05D1\u05D8\u05E0\u05E7 \u05D5\u05E7\u05D5\u05E8\u05D0 \u05DC\u05D6\u05D4 \u05DE\u05DB\u05D5\u05E0\u05D9\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 969973838
    m_Localized: "\u05D1\u05DC\u05D9\u05D9\u05D6 \u05DE\u05D5\u05E0\u05E8\u05D5"
    m_Metadata:
      m_Items: []
  - m_Id: 969973839
    m_Localized: "\u05E0\u05D4\u05D2 \u05E4\u05E2\u05DC\u05D5\u05DC\u05D9\u05DD \u05DC\u05E9\u05E2\u05D1\u05E8. \u05E2\u05D3\u05D9\u05D9\u05DF \u05E2\u05D5\u05E9\u05D4 \u05E4\u05E2\u05DC\u05D5\u05DC\u05D9\u05DD, \u05E2\u05DB\u05E9\u05D9\u05D5 \u05E2\u05DD \u05D8\u05D9\u05DC\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 969973840
    m_Localized: "\u05E8\u05D0\u05E9-\u05E4\u05D8\u05D9\u05E9"
    m_Metadata:
      m_Items: []
  - m_Id: 969973841
    m_Localized: "\u05E7\u05D5\u05D3\u05DD \u05E0\u05D5\u05D2\u05D7, \u05D5\u05D0\u05E3 \u05E4\u05E2\u05DD \u05DC\u05D0 \u05E9\u05D5\u05D0\u05DC."
    m_Metadata:
      m_Items: []
