  - m_Id: 969973862
    m_Localized: "{0} \u05D4\u05E7\u05E4\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 969973863
    m_Localized: "\u05E7\u05E8\u05D9\u05D9\u05E8\u05D4 \u05D7\u05D3\u05E9\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 969973864
    m_Localized: "\u05E2\u05E9\u05E8\u05D9\u05DD \u05E0\u05D4\u05D2\u05D9\u05DD, \u05D0\u05DC\u05D5\u05E3 \u05D0\u05D7\u05D3. \u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD \u05D1\u05EA\u05D7\u05EA\u05D9\u05EA \u05E2\u05DD \u05D2\u05E8\u05D5\u05D8\u05D0\u05D4, \u05E7\u05E6\u05EA \u05DB\u05E1\u05E3 \u05D5\u05D4\u05E8\u05D1\u05D4 \u05DB\u05E2\u05E1."
    m_Metadata:
      m_Items: []
