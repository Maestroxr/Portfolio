      m_Items: []
  - m_Id: 969973882
    m_Localized: "\u05D4\u05D1\u05D9\u05E1\u05D5 \u05D0\u05EA \u05D4\u05E1\u05D5\u05D4\u05E8 \u05D1\u05E7\u05E8\u05D9\u05D9\u05E8\u05D4 \u05DB\u05D3\u05D9 \u05DC\u05D4\u05EA\u05D7\u05E8\u05D5\u05EA \u05DB\u05D0\u05DF."
    m_Metadata:
