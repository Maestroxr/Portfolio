      m_Items: []
  - m_Id: 969973831
    m_Localized: "\u05D1\u05E8\u05D2\u05E2 \u05E9\u05D4\u05D9\u05D0 \u05E2\u05DC \u05D4\u05E4\u05D2\u05D5\u05E9 \u05E9\u05DC\u05DA, \u05D4\u05D9\u05D0 \u05DC\u05D0 \u05DE\u05E8\u05E4\u05D4."
    m_Metadata:
      m_Items: []
