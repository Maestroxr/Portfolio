    m_Localized: "\u05DE\u05E1\u05DA \u05DE\u05E4\u05D5\u05E6\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 974168179
    m_Localized: "\u05E9\u05E0\u05D9\u05D9\u05DD \u05E2\u05D3 \u05D0\u05E8\u05D1\u05E2\u05D4 \u05E0\u05D4\u05D2\u05D9\u05DD \u05DE\u05D5\u05DC \u05DE\u05E1\u05DA \u05D0\u05D7\u05D3, \u05DB\u05DC \u05D0\u05D7\u05D3 \u05D1\u05D7\u05DC\u05D5\u05DF \u05DE\u05E9\u05DC\u05D5. \u05DE\u05DB\u05D5\u05E0\u05D9\u05D5\u05EA \u05D4\u05DE\u05D7\u05E9\u05D1 \u05D9\u05DB\u05D5\u05DC\u05D5\u05EA \u05DC\u05D4\u05E9\u05DC\u05D9\u05DD \u05D0\u05EA \u05D4\u05D2\u05E8\u05D9\u05D3."
