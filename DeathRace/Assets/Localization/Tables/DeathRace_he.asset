  - m_Id: 974168215
    m_Localized: "\u05DE\u05E8\u05D5\u05E5 \u05D4\u05E7\u05E0\u05D9\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 974168216
    m_Localized: "\u05D1\u05D9\u05EA \u05D4\u05D4\u05EA\u05DB\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 974168217
    m_Localized: "\u05D8\u05D1\u05E2\u05EA \u05D4\u05E7\u05E8\u05D7\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 974168218
    m_Localized: "\u05E7\u05D8\u05DC \u05D1\u05DE\u05E8\u05DB\u05D6 \u05D4\u05E2\u05D9\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 974168219
    m_Localized: "\u05DB\u05D5\u05E8 \u05D4\u05D4\u05D9\u05EA\u05D5\u05DA"
    m_Metadata:
      m_Items: []
  - m_Id: 974168220
    m_Localized: "\u05DC\u05D5\u05DC\u05D0\u05D4 \u05E8\u05D7\u05D1\u05D4 \u05D5\u05D6\u05D5\u05E8\u05DE\u05EA \u05D1\u05D9\u05DF \u05D4\u05D3\u05D9\u05D5\u05E0\u05D5\u05EA, \u05E2\u05DD \u05E4\u05E0\u05D9\u05D9\u05EA \u05E1\u05D9\u05DB\u05D4 \u05D4\u05D3\u05D5\u05E7\u05D4 \u05D0\u05D7\u05EA. \u05DB\u05D0\u05DF \u05DC\u05D5\u05DE\u05D3\u05D9\u05DD \u05DC\u05D4\u05DB\u05D9\u05E8 \u05D0\u05EA \u05D4\u05DE\u05DB\u05D5\u05E0\u05D9\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 974168221
    m_Localized: "\u05D0\u05E8\u05D1\u05E2 \u05E4\u05E0\u05D9\u05D5\u05EA \u05D7\u05D3\u05D5\u05EA \u05E1\u05D1\u05D9\u05D1 \u05DE\u05D2\u05E8\u05E9 \u05D4\u05D2\u05E8\u05D5\u05D8\u05D0\u05D5\u05EA \u05D5\u05E9\u05D9\u05E7\u05E0\u05D4 \u05D1\u05D9\u05DF \u05E2\u05E8\u05D9\u05DE\u05D5\u05EA \u05E9\u05DC \u05DE\u05DB\u05D5\u05DC\u05D5\u05EA \u05D7\u05DC\u05D5\u05D3\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 974168222
    m_Localized: "\u05D4\u05D9\u05E9\u05D5\u05E8\u05EA \u05D4\u05D0\u05E8\u05D5\u05DB\u05D4 \u05D1\u05D9\u05D5\u05EA\u05E8 \u05D1\u05D0\u05E8\u05E5, \u05D5\u05D0\u05D7\u05E8\u05D9\u05D4 \u05E2\u05D9\u05E7\u05D5\u05DC\u05D9 S \u05D1\u05DE\u05E2\u05D1\u05E8 \u05D4\u05E8\u05D9\u05DD \u05E7\u05E4\u05D5\u05D0."
    m_Metadata:
      m_Items: []
  - m_Id: 974168223
    m_Localized: "\u05E4\u05E0\u05D9\u05D5\u05EA \u05D1\u05D6\u05D5\u05D5\u05D9\u05EA \u05D9\u05E9\u05E8\u05D4 \u05D1\u05D9\u05DF \u05D1\u05DC\u05D5\u05E7\u05D9\u05DD \u05E9\u05DC \u05D1\u05E0\u05D9\u05D9\u05E0\u05D9\u05DD, \u05D5\u05D0\u05D6 \u05D3\u05D4\u05D9\u05E8\u05D4 \u05D1\u05D2\u05D6 \u05DE\u05DC\u05D0 \u05DC\u05D0\u05D5\u05E8\u05DA \u05D4\u05D9\u05E9\u05D5\u05E8\u05EA \u05D4\u05D0\u05D7\u05D5\u05E8\u05D9\u05EA \u05D4\u05DE\u05D5\u05D0\u05E8\u05EA \u05D1\u05E0\u05D9\u05D0\u05D5\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 974168224
    m_Localized: "\u05D3\u05E8\u05DA \u05D0\u05E8\u05D5\u05DB\u05D4 \u05D5\u05DE\u05EA\u05E4\u05EA\u05DC\u05EA \u05D1\u05D9\u05DF \u05D4\u05E7\u05E0\u05D9\u05D5\u05E0\u05D9\u05DD \u05D4\u05D0\u05D3\u05D5\u05DE\u05D9\u05DD, \u05E2\u05DD \u05E2\u05E8\u05D5\u05E5 \u05E6\u05E8 \u05E9\u05D1\u05D5 \u05DB\u05DC \u05E2\u05E7\u05D9\u05E4\u05D4 \u05D4\u05D9\u05D0 \u05D4\u05D9\u05DE\u05D5\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 974168225
    m_Localized: "\u05E6\u05E4\u05D5\u05E3 \u05D5\u05D8\u05DB\u05E0\u05D9: \u05E4\u05E0\u05D9\u05D9\u05D4 \u05D0\u05D7\u05E8\u05D9 \u05E4\u05E0\u05D9\u05D9\u05D4 \u05D1\u05D9\u05DF \u05DB\u05D1\u05E9\u05E0\u05D9 \u05D4\u05D4\u05EA\u05DB\u05D4. \u05D1\u05D5\u05DC\u05DE\u05D9\u05DD \u05DE\u05D5\u05E7\u05D3\u05DD, \u05D9\u05D5\u05E8\u05D9\u05DD \u05D4\u05E8\u05D1\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 974168226
    m_Localized: "\u05E2\u05D9\u05E7\u05D5\u05DC\u05D9\u05DD \u05DE\u05D4\u05D9\u05E8\u05D9\u05DD \u05D5\u05D0\u05E8\u05D5\u05DB\u05D9\u05DD \u05E2\u05DC \u05D3\u05E8\u05DA \u05E8\u05D7\u05D1\u05D4 \u05E9\u05DC \u05E9\u05DC\u05D2 \u05D3\u05D7\u05D5\u05E1. \u05DC\u05D0 \u05DE\u05E8\u05D9\u05DE\u05D9\u05DD \u05D0\u05EA \u05D4\u05E8\u05D2\u05DC \u05DE\u05D4\u05D2\u05D6."
    m_Metadata:
      m_Items: []
  - m_Id: 974168227
    m_Localized: "\u05DE\u05E1\u05DC\u05D5\u05DC \u05E2\u05D9\u05E8\u05D5\u05E0\u05D9 \u05D0\u05DB\u05D6\u05E8\u05D9 \u05E2\u05DD \u05E4\u05E0\u05D9\u05D9\u05EA \u05E1\u05D9\u05DB\u05D4 \u05DB\u05E4\u05D5\u05DC\u05D4 \u05E9\u05D4\u05D5\u05E4\u05DB\u05EA \u05D0\u05EA \u05D4\u05DE\u05E8\u05D5\u05E5 \u05DC\u05D3\u05E8\u05D1\u05D9 \u05D4\u05E8\u05D9\u05E1\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 974168228
    m_Localized: "\u05D4\u05D6\u05D9\u05E8\u05D4 \u05E9\u05DC \u05D4\u05E1\u05D5\u05D4\u05E8: \u05DC\u05D5\u05DC\u05D0\u05D4 \u05E7\u05E6\u05E8\u05D4 \u05D5\u05E8\u05D7\u05D1\u05D4 \u05DE\u05D5\u05E7\u05E4\u05EA \u05D1\u05D5\u05E8\u05D5\u05EA \u05D0\u05E9. \u05E8\u05E7 \u05E0\u05D4\u05D2 \u05D0\u05D7\u05D3 \u05D9\u05D5\u05E6\u05D0 \u05DE\u05DE\u05E0\u05D4 \u05D0\u05DC\u05D5\u05E3."
    m_Metadata:
      m_Items: []
  - m_Id: 974168229
    m_Localized: "\u05DE\u05E1\u05DA \u05DE\u05E4\u05D5\u05E6\u05DC  \xB7  {0}  \xB7  {1}"
    m_Metadata:
