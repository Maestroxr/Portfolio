  - m_Id: 974168188
    m_Localized: "\u05DE\u05E8\u05D5\u05E5 \u05D4\u05DE\u05D5\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 974168189
    m_Localized: "\u05DE\u05DB\u05D5\u05E0\u05D9\u05D5\u05EA \u05D7\u05DE\u05D5\u05E9\u05D5\u05EA, \u05EA\u05E9\u05E2\u05D4 \u05DE\u05E1\u05DC\u05D5\u05DC\u05D9\u05DD \u05E7\u05D8\u05DC\u05E0\u05D9\u05D9\u05DD \u05D5\u05E1\u05D5\u05DC\u05DD \u05E9\u05DC \u05E2\u05E9\u05E8\u05D9\u05DD \u05E0\u05D4\u05D2\u05D9\u05DD: \u05DE\u05EA\u05D7\u05E8\u05D9\u05DD, \u05D9\u05D5\u05E8\u05D9\u05DD \u05D5\u05DE\u05EA\u05E0\u05D2\u05E9\u05D9\u05DD \u05D1\u05D3\u05E8\u05DA \u05DC\u05E4\u05E1\u05D2\u05D4, \u05D5\u05DE\u05D5\u05E6\u05D9\u05D0\u05D9\u05DD \u05D0\u05EA \u05DB\u05E1\u05E4\u05D9 \u05D4\u05E4\u05E8\u05E1\u05D9\u05DD \u05E2\u05DC \u05DE\u05DB\u05D5\u05E0\u05D9\u05EA \u05D8\u05D5\u05D1\u05D4 \u05D9\u05D5\u05EA\u05E8."
    m_Metadata:
      m_Items: []
