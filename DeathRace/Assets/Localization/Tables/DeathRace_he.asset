  - m_Id: 965779456
    m_Localized: "\u05E6\u05E8\u05E2\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 969973760
    m_Localized: "\u05D1\u05D5\u05DC\u05D3\u05D5\u05D2"
    m_Metadata:
      m_Items: []
  - m_Id: 969973761
    m_Localized: "\u05E6\u05E4\u05E2"
    m_Metadata:
      m_Items: []
  - m_Id: 969973762
    m_Localized: "\u05E7\u05D5\u05E6\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 969973763
    m_Localized: "\u05E8\u05D5\u05D3\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 969973764
    m_Localized: "\u05D4\u05D0\u05E6'\u05D1\u05E7 \u05E9\u05DE\u05D7\u05D6\u05D9\u05E7\u05D9\u05DD \u05D0\u05D5\u05EA\u05D5 \u05D7\u05DC\u05D5\u05D3\u05D4 \u05D5\u05EA\u05E7\u05D5\u05D5\u05D4. \u05D1\u05D7\u05D9\u05E0\u05DD, \u05D5\u05E9\u05D5\u05D5\u05D4 \u05DB\u05DC \u05D0\u05D2\u05D5\u05E8\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 969973765
    m_Localized: "\u05E7\u05D5\u05E4\u05D4 \u05E7\u05DC\u05D4 \u05E9\u05D7\u05D5\u05DE\u05E7\u05EA \u05D1\u05D9\u05DF \u05D4\u05DE\u05DB\u05D5\u05E0\u05D9\u05D5\u05EA. \u05DE\u05D4\u05D9\u05E8\u05D4 \u05D1\u05D6\u05D9\u05E0\u05D5\u05E7, \u05D5\u05DE\u05D4\u05D9\u05E8\u05D4 \u05E2\u05D5\u05D3 \u05D9\u05D5\u05EA\u05E8 \u05D0\u05DC \u05D4\u05DE\u05E2\u05E7\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 969973766
    m_Localized: "\u05D8\u05E0\u05D3\u05E8 \u05E2\u05DD \u05DE\u05D2\u05DF \u05E7\u05D3\u05DE\u05D9 \u05D5\u05D7\u05E9\u05D1\u05D5\u05DF \u05E4\u05EA\u05D5\u05D7. \u05D0\u05D9\u05D8\u05D9 \u05D1\u05E4\u05E0\u05D9\u05D5\u05EA, \u05E7\u05E9\u05D4 \u05DC\u05E2\u05E6\u05D5\u05E8 \u05D0\u05D5\u05EA\u05D5 \u05D5\u05E7\u05E9\u05D4 \u05E2\u05D5\u05D3 \u05D9\u05D5\u05EA\u05E8 \u05DC\u05D7\u05E1\u05DC \u05D0\u05D5\u05EA\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 969973767
    m_Localized: "\u05E9\u05DE\u05D5\u05E0\u05D4 \u05E6\u05D9\u05DC\u05D9\u05E0\u05D3\u05E8\u05D9\u05DD, \u05E1\u05E4\u05D5\u05D9\u05DC\u05E8 \u05D5\u05D0\u05E4\u05E1 \u05E1\u05D1\u05DC\u05E0\u05D5\u05EA. \u05D4\u05DE\u05DB\u05D5\u05E0\u05D9\u05EA \u05D4\u05E8\u05D0\u05E9\u05D5\u05E0\u05D4 \u05E9\u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05E0\u05E6\u05D7 \u05D1\u05DE\u05E8\u05D5\u05E5 \u05E7\u05E9\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 969973768
    m_Localized: "\u05D8\u05E8\u05D9\u05D6 \u05E9\u05D7\u05D5\u05E8 \u05D5\u05E0\u05DE\u05D5\u05DA \u05E9\u05E0\u05DB\u05E0\u05E1 \u05DC\u05E4\u05E0\u05D9\u05D5\u05EA \u05DB\u05D0\u05D9\u05DC\u05D5 \u05D4\u05D5\u05D0 \u05E2\u05DC \u05DE\u05E1\u05D9\u05DC\u05D4. \u05D9\u05E7\u05E8\u05D4, \u05D5\u05D6\u05D4 \u05E0\u05D9\u05DB\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 969973769
    m_Localized: "\u05DE\u05D9\u05D9\u05E8\u05D8\u05EA \u05DE\u05E9\u05D5\u05E8\u05D9\u05D9\u05E0\u05EA \u05E9\u05E0\u05D1\u05E0\u05EA\u05D4 \u05DC\u05DE\u05D8\u05E8\u05D4 \u05D0\u05D7\u05EA: \u05DC\u05D4\u05D9\u05D5\u05EA \u05D4\u05DE\u05DB\u05D5\u05E0\u05D9\u05EA \u05D4\u05D0\u05D7\u05E8\u05D5\u05E0\u05D4 \u05E9\u05E2\u05D5\u05D3 \u05E0\u05D5\u05E1\u05E2\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 969973770
    m_Localized: "\u05D7\u05E8\u05D5\u05DA"
    m_Metadata:
      m_Items: []
  - m_Id: 969973771
    m_Localized: "\u05D0\u05D5\u05E8 \u05D9\u05D5\u05DD \u05DE\u05D3\u05D1\u05E8\u05D9 \u05E7\u05E9\u05D4, \u05D7\u05DC\u05D5\u05D3\u05D4 \u05D5\u05D0\u05D1\u05E7."
    m_Metadata:
      m_Items: []
  - m_Id: 969973772
    m_Localized: "\u05E8\u05D3\u05EA \u05D4\u05DC\u05D9\u05DC\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 969973773
    m_Localized: "\u05DE\u05E8\u05D5\u05E6\u05D9 \u05DC\u05D9\u05DC\u05D4 \u05D1\u05D0\u05D5\u05E8 \u05E0\u05D9\u05D0\u05D5\u05DF: \u05E4\u05E0\u05E1\u05D9\u05DD, \u05DE\u05D7\u05E1\u05D5\u05DE\u05D9\u05DD \u05D6\u05D5\u05D4\u05E8\u05D9\u05DD \u05D5\u05D0\u05E1\u05E4\u05DC\u05D8 \u05E8\u05D8\u05D5\u05D1."
    m_Metadata:
      m_Items: []
  - m_Id: 969973774
    m_Localized: "\u05D4\u05E7\u05E8\u05D9\u05D9\u05E8\u05D4 \u05D4\u05E9\u05DE\u05D5\u05E8\u05D4 \u05D0\u05D9\u05E0\u05D4 \u05E9\u05DC\u05DE\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 969973775
    m_Localized: "\u05D4\u05E7\u05E8\u05D9\u05D9\u05E8\u05D4 \u05D4\u05D6\u05D0\u05EA \u05E0\u05E9\u05DE\u05E8\u05D4 \u05D1\u05D2\u05E8\u05E1\u05D4 \u05D7\u05D3\u05E9\u05D4 \u05D9\u05D5\u05EA\u05E8 \u05E9\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7."
    m_Metadata:
      m_Items: []
  - m_Id: 969973776
    m_Localized: "\u05D8\u05D9\u05E8\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 969973777
    m_Localized: "\u05E9\u05D7\u05E7\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 969973778
    m_Localized: "\u05D0\u05D9\u05DF \u05E7\u05E8\u05D9\u05D9\u05E8\u05D4 \u05DC\u05E9\u05DE\u05D9\u05E8\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 969973779
    m_Localized: "\u05D0\u05D9 \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E9\u05DE\u05D5\u05E8 \u05E7\u05E8\u05D9\u05D9\u05E8\u05D4 \u05D1\u05D0\u05DE\u05E6\u05E2 \u05DE\u05E8\u05D5\u05E5."
    m_Metadata:
      m_Items: []
  - m_Id: 969973780
    m_Localized: "\u05D0\u05D9 \u05D0\u05E4\u05E9\u05E8 \u05DC\u05D8\u05E2\u05D5\u05DF \u05E7\u05E8\u05D9\u05D9\u05E8\u05D4 \u05D1\u05D0\u05DE\u05E6\u05E2 \u05DE\u05E8\u05D5\u05E5."
    m_Metadata:
      m_Items: []
  - m_Id: 969973781
    m_Localized: "{0}, \u05D9\u05D5\u05DD {1}: {2}, {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 969973782
    m_Localized: "(\u05D0\u05DC\u05D5\u05E3)"
    m_Metadata:
      m_Items: []
  - m_Id: 969973783
    m_Localized: "\u05DE\u05E0\u05D5\u05E2"
    m_Metadata:
      m_Items: []
  - m_Id: 969973784
    m_Localized: "\u05D9\u05D5\u05EA\u05E8 \u05DB\u05D5\u05D7: \u05DE\u05D4\u05D9\u05E8\u05D5\u05EA \u05DE\u05E8\u05D1\u05D9\u05EA \u05D2\u05D1\u05D5\u05D4\u05D4 \u05D9\u05D5\u05EA\u05E8 \u05D5\u05EA\u05D0\u05D5\u05E6\u05D4 \u05D7\u05D6\u05E7\u05D4 \u05D9\u05D5\u05EA\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 969973785
    m_Localized: "\u05E6\u05DE\u05D9\u05D2\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 969973786
    m_Localized: "\u05D9\u05D5\u05EA\u05E8 \u05D0\u05D7\u05D9\u05D6\u05D4: \u05E4\u05E0\u05D9\u05D5\u05EA \u05D4\u05D3\u05D5\u05E7\u05D5\u05EA \u05D9\u05D5\u05EA\u05E8 \u05D5\u05E4\u05D7\u05D5\u05EA \u05D4\u05D7\u05DC\u05E7\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 969973787
    m_Localized: "\u05E9\u05E8\u05D9\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 969973788
    m_Localized: "\u05E4\u05DC\u05D3\u05D4 \u05E2\u05D1\u05D4 \u05D9\u05D5\u05EA\u05E8: \u05DB\u05DC \u05E4\u05D2\u05D9\u05E2\u05D4 \u05DB\u05D5\u05D0\u05D1\u05EA \u05E4\u05D7\u05D5\u05EA, \u05D5\u05D4\u05DE\u05DB\u05D5\u05E0\u05D9\u05EA \u05E1\u05D5\u05E4\u05D2\u05EA \u05D9\u05D5\u05EA\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 969973789
    m_Localized: "\u05E4\u05D2\u05D5\u05E9 \u05E7\u05D5\u05E6\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 969973790
    m_Localized: "\u05E7\u05D5\u05E6\u05D9 \u05E4\u05DC\u05D3\u05D4 \u05D1\u05D7\u05D6\u05D9\u05EA: \u05E0\u05D2\u05D9\u05D7\u05D5\u05EA \u05E4\u05D5\u05D2\u05E2\u05D5\u05EA \u05D9\u05D5\u05EA\u05E8 \u05D1\u05DE\u05DB\u05D5\u05E0\u05D9\u05EA \u05D4\u05E9\u05E0\u05D9\u05D9\u05D4 \u05D5\u05E4\u05D7\u05D5\u05EA \u05D1\u05E9\u05DC\u05DA."
    m_Metadata:
      m_Items: []
  - m_Id: 969973791
    m_Localized: "\u05EA\u05D7\u05DE\u05D5\u05E9\u05EA \u05D7\u05D5\u05D3\u05E8\u05EA \u05E9\u05E8\u05D9\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 969973792
    m_Localized: "\u05D4\u05DE\u05E7\u05DC\u05E2 \u05E4\u05D5\u05D2\u05E2 \u05D7\u05D6\u05E7 \u05E4\u05D9 \u05D0\u05D7\u05D3 \u05D5\u05D7\u05E6\u05D9."
    m_Metadata:
      m_Items: []
  - m_Id: 969973793
    m_Localized: "\u05EA\u05D9\u05E7\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 969973794
    m_Localized: "\u05E4\u05D7\u05D7\u05D5\u05EA \u05D5\u05E8\u05D9\u05EA\u05D5\u05DA, \u05D1\u05EA\u05E9\u05DC\u05D5\u05DD \u05DC\u05E4\u05D9 \u05E0\u05E7\u05D5\u05D3\u05EA \u05D7\u05D5\u05D6\u05E7."
    m_Metadata:
      m_Items: []
  - m_Id: 969973795
    m_Localized: "\u05DE\u05D5\u05E7\u05E9"
    m_Metadata:
      m_Items: []
  - m_Id: 969973796
    m_Localized: "\u05DE\u05D5\u05D8\u05DC \u05DE\u05D0\u05D7\u05D5\u05E8\u05D9 \u05D4\u05DE\u05DB\u05D5\u05E0\u05D9\u05EA, \u05E0\u05D3\u05E8\u05DA \u05EA\u05D5\u05DA \u05E8\u05D2\u05E2 \u05D5\u05DE\u05E4\u05D5\u05E6\u05E5 \u05D0\u05EA \u05DE\u05D9 \u05E9\u05E2\u05D5\u05DC\u05D4 \u05E2\u05DC\u05D9\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 969973797
    m_Localized: "\u05D8\u05D9\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 969973798
    m_Localized: "\u05E0\u05D5\u05E8\u05D4 \u05E7\u05D3\u05D9\u05DE\u05D4, \u05DE\u05D0\u05EA\u05E8 \u05D0\u05EA \u05D4\u05DE\u05DB\u05D5\u05E0\u05D9\u05EA \u05D4\u05E7\u05E8\u05D5\u05D1\u05D4 \u05E9\u05DC\u05E4\u05E0\u05D9\u05DA \u05D5\u05E4\u05D5\u05D2\u05E2 \u05D7\u05D6\u05E7."
    m_Metadata:
      m_Items: []
  - m_Id: 969973799
    m_Localized: "\u05E0\u05D9\u05D8\u05E8\u05D5"
    m_Metadata:
      m_Items: []
  - m_Id: 969973800
    m_Localized: "\u05D1\u05E7\u05D1\u05D5\u05E7 \u05E9\u05DC \u05D3\u05D7\u05D9\u05E4\u05D4: \u05DB\u05DE\u05D4 \u05E9\u05E0\u05D9\u05D5\u05EA \u05E9\u05DC \u05D4\u05E8\u05D1\u05D4 \u05D9\u05D5\u05EA\u05E8 \u05DE\u05D4\u05D9\u05E8\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 969973801
    m_Localized: "\u05D7\u05D1\u05DC\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 969973802
    m_Localized: "\u05DE\u05D9\u05DC\u05D4 \u05E2\u05DD \u05D4\u05DE\u05DB\u05D5\u05E0\u05D0\u05D9: \u05D4\u05DE\u05DB\u05D5\u05E0\u05D9\u05EA \u05E9\u05DC \u05D4\u05E0\u05D4\u05D2 \u05E9\u05EA\u05D1\u05D7\u05E8\u05D5 \u05EA\u05E4\u05EA\u05D7 \u05D0\u05EA \u05D4\u05DE\u05E8\u05D5\u05E5 \u05D4\u05D1\u05D0 \u05E4\u05D2\u05D5\u05E2\u05D4 \u05E7\u05E9\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 969973803
    m_Localized: "\u05D1\u05D7\u05E8\u05D5 \u05E0\u05D4\u05D2 \u05DC\u05D7\u05D1\u05DC\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 969973804
    m_Localized: "\u05DB\u05D1\u05E8 \u05D7\u05D9\u05D1\u05DC\u05EA\u05DD \u05D1\u05DE\u05DB\u05D5\u05E0\u05D9\u05EA \u05D0\u05D7\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 969973805
    m_Localized: "\u05D4\u05DE\u05DB\u05D5\u05E0\u05D9\u05EA \u05E9\u05DC\u05DA \u05D8\u05D5\u05D1\u05D4 \u05D9\u05D5\u05EA\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 969973806
    m_Localized: "\u05D6\u05D5 \u05DB\u05D1\u05E8 \u05D4\u05DE\u05DB\u05D5\u05E0\u05D9\u05EA \u05E9\u05DC\u05DA"
    m_Metadata:
      m_Items: []
  - m_Id: 969973807
    m_Localized: "\u05D4\u05DE\u05DB\u05D5\u05E0\u05D9\u05EA \u05E9\u05DC\u05DE\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 969973808
    m_Localized: "\u05D4\u05E1\u05D5\u05D4\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 969973809
    m_Localized: "\u05D0\u05D9\u05E9 \u05DC\u05D0 \u05E8\u05D0\u05D4 \u05D0\u05EA \u05D4\u05E4\u05E0\u05D9\u05DD \u05DE\u05D0\u05D7\u05D5\u05E8\u05D9 \u05D4\u05DE\u05D2\u05DF. \u05D0\u05D9\u05E9 \u05E9\u05D4\u05EA\u05D7\u05E8\u05D4 \u05D1\u05E1\u05D5\u05D4\u05E8 \u05DC\u05D0 \u05E0\u05E9\u05D0\u05E8 \u05E2\u05DD \u05DE\u05DB\u05D5\u05E0\u05D9\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 969973810
    m_Localized: "\u05D8\u05E8\u05D9 \u05D1\u05D2\u05E8\u05D5\u05E9"
    m_Metadata:
      m_Items: []
  - m_Id: 969973811
    m_Localized: "\u05DE\u05EA\u05D7\u05E8\u05D4 \u05D1\u05E9\u05D1\u05D9\u05DC \u05DB\u05E1\u05E3 \u05DC\u05D3\u05DC\u05E7, \u05D5\u05D1\u05D3\u05E8\u05DA \u05DB\u05DC\u05DC \u05DE\u05E4\u05E1\u05D9\u05D3 \u05D0\u05D5\u05EA\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 969973812
