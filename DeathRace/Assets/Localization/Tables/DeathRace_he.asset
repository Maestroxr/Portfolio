    m_Localized: "\u05E0\u05E4\u05EA\u05D7 \u05E2\u05DD \u05DE\u05E7\u05D5\u05DD \u05E2\u05DC \u05D4\u05E4\u05D5\u05D3\u05D9\u05D5\u05DD \u05D1{0} \u05D0\u05D5 \u05DE\u05E7\u05D5\u05DD {1} \u05D1\u05E7\u05E8\u05D9\u05D9\u05E8\u05D4."
