    m_Localized: "\u05DE\u05E4\u05D6\u05E8\u05EA \u05DE\u05D5\u05E7\u05E9\u05D9\u05DD \u05DB\u05DE\u05D5 \u05E4\u05D9\u05E8\u05D5\u05E8\u05D9 \u05DC\u05D7\u05DD."
