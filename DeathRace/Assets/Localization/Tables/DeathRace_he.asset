    m_Localized: "\u05DE\u05E7\u05D5\u05DD {0} \u05DE\u05EA\u05D5\u05DA {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 969973870
    m_Localized: "\u05D4\u05E9\u05DE\u05D9\u05E8\u05D4 \u05D4\u05D0\u05D7\u05E8\u05D5\u05E0\u05D4: {0}"
    m_Metadata:
      m_Items: []
