    m_Localized: "\u05EA\u05D7\u05DE\u05D5\u05E9\u05EA \u05D7\u05D5\u05D3\u05E8\u05EA \u05E9\u05E8\u05D9\u05D5\u05DF \u05D5\u05E4\u05EA\u05D9\u05DC \u05E7\u05E6\u05E8."
