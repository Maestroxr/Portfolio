    m_Localized: "\u05D4\u05D9\u05E8\u05D9\u05D1\u05D9\u05DD \u05D9\u05E7\u05D1\u05DC\u05D5 \u05D0\u05EA \u05D4\u05E6\u05D1\u05E2\u05D9\u05DD \u05E9\u05E0\u05E9\u05D0\u05E8\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 969973868
    m_Localized: "{0}  \xB7  {1} \u05DE\u05D5\u05E7\u05E9\u05D9\u05DD  \xB7  {2} \u05E0\u05D9\u05D8\u05E8\u05D5"
    m_Metadata:
      m_Items: []
