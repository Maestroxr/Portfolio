<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The server module of this game: the Gamebox base server plus the Lib.cs next to this file.
    BaseServer.props brings the settings, the SpacetimeDB runtime and the base server sources (shown under
    BaseServer/). The path leads to the BaseServer package of the BaseGame repository, which sits next to this
    repository. The TargetFramework stays here because the spacetime CLI reads it from this file.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <Import Project="../../../BaseGame/BaseServer/Server~/BaseServer.props" />

  <!--
    What the devices of a race and the server agree on (the actions and their payloads, the claims, the options of a
    room, the score of a result and what a result can plausibly be) is one file of the Unity project, compiled into the
    module as it is.
  -->
  <ItemGroup>
    <Compile Include="../Assets/Scripts/Online/OnlineRaceRules.cs" Link="Shared/OnlineRaceRules.cs" />
  </ItemGroup>

</Project>
