<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests of the rules of Heroes outside Unity: `dotnet test` in this folder runs them in a few seconds. They are
    the test files the editor runs (Assets/Tests/Editor), compiled with the engine-free model (Assets/Scripts/Model)
    and Gamebox.Lockstep, which BaseGame's ModelTests.props brings along with the test packages.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Portfolio.Heroes.Tests</RootNamespace>
    <AssemblyName>Heroes.Model.Tests</AssemblyName>
  </PropertyGroup>

  <Import Project="../../../BaseGame/Assets/Tests/ModelTests~/ModelTests.props" />

  <ItemGroup>
    <Compile Include="../Assets/Scripts/Model/**/*.cs" Link="Model/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Assets/Tests/Editor/*.cs" Link="Tests/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
