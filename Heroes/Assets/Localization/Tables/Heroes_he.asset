    m_Localized: "\u05E1\u05D5\u05DB\u05E0\u05EA \u05D0\u05D7\u05D5\u05D6\u05D4 \u05E9\u05D4\u05E4\u05DB\u05D4 \u05DC\u05DE\u05E6\u05D1\u05D9\u05D0\u05D4, \u05D8\u05D5\u05D1\u05D4 \u05D1\u05E1\u05E4\u05E8\u05D9 \u05D7\u05E9\u05D1\u05D5\u05E0\u05D5\u05EA \u05DB\u05DE\u05D5 \u05D1\u05E8\u05DE\u05D7\u05D9\u05DD."
    m_Metadata:
      m_Items: []
