  m_TableData:
  - m_Id: 567341056
    m_Localized: "\u05D2\u05D9\u05D1\u05D5\u05E8\u05D9\u05DD, \u05E2\u05E8\u05D9\u05DD \u05D5\u05E6\u05D1\u05D0\u05D5\u05EA \u05D1\u05D0\u05E8\u05E5 \u05E9\u05DC \u05DE\u05E9\u05D5\u05E9\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 613478400
    m_Localized: "\u05D4\u05DE\u05E9\u05DA"
    m_Metadata:
      m_Items: []
  - m_Id: 617672704
    m_Localized: "\u05D4\u05EA\u05E8\u05D7\u05D9\u05E9 \u05E9\u05E2\u05D6\u05D1\u05EA, \u05D1\u05D3\u05D9\u05D5\u05E7 \u05D4\u05D9\u05DB\u05DF \u05E9\u05E2\u05D6\u05D1\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 617672705
    m_Localized: "\u05DE\u05E2\u05E8\u05DB\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 617672706
    m_Localized: "\u05E9\u05DE\u05D5\u05E0\u05D4 \u05E4\u05E8\u05E7\u05D9\u05DD, \u05D6\u05D4 \u05D0\u05D7\u05E8 \u05D6\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 617672707
    m_Localized: "\u05D4\u05EA\u05DB\u05EA\u05E9\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 617672708
    m_Localized: "\u05DE\u05E4\u05D4 \u05D0\u05D7\u05EA \u05DE\u05D5\u05DC \u05D4\u05DE\u05D7\u05E9\u05D1."
    m_Metadata:
      m_Items: []
  - m_Id: 617672709
    m_Localized: "\u05DE\u05E9\u05D7\u05E7 \u05DE\u05E7\u05D5\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 617672710
    m_Localized: "\u05D7\u05D3\u05E8 \u05D1\u05E9\u05E8\u05EA, \u05E2\u05DD \u05E9\u05D7\u05E7\u05E0\u05D9\u05DD \u05D1\u05DE\u05DB\u05E9\u05D9\u05E8\u05D9\u05DD \u05D0\u05D7\u05E8\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 617672711
    m_Localized: "\u05D4\u05D2\u05D3\u05E8\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 617672712
    m_Localized: "\u05D4\u05D9\u05DB\u05DF \u05E0\u05E2\u05E8\u05DB\u05D9\u05DD \u05D4\u05E7\u05E8\u05D1\u05D5\u05EA, \u05DE\u05D4\u05D9\u05E8\u05D5\u05D9\u05D5\u05EA, \u05E6\u05DC\u05D9\u05DC \u05D5\u05D7\u05D5\u05E7\u05D9 \u05D4\u05D4\u05EA\u05DB\u05EA\u05E9\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 617672713
    m_Localized: "\u05E7\u05E8\u05D3\u05D9\u05D8\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 617672714
    m_Localized: "\u05DE\u05D9 \u05D9\u05E6\u05E8 \u05D0\u05EA \u05DE\u05D4 \u05E9\u05D4\u05DE\u05E9\u05D7\u05E7 \u05DE\u05E6\u05D9\u05D2 \u05D5\u05DE\u05E9\u05DE\u05D9\u05E2."
    m_Metadata:
      m_Items: []
  - m_Id: 617672715
    m_Localized: "\u05D9\u05E6\u05D9\u05D0\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 617672716
    m_Localized: "\u05D9\u05E6\u05D9\u05D0\u05D4 \u05DE\u05D4\u05DE\u05E9\u05D7\u05E7."
    m_Metadata:
      m_Items: []
  - m_Id: 617672717
    m_Localized: "\u05D2\u05E8\u05E1\u05D4 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 617672718
    m_Localized: "\u05D4\u05DE\u05E9\u05DA: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 617672719
    m_Localized: "\u05E9\u05E4\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 617672720
    m_Localized: "\u05D4\u05DE\u05E2\u05E8\u05DB\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 617672721
    m_Localized: "\u05DE\u05E4\u05D5\u05EA \u05D4\u05EA\u05DB\u05EA\u05E9\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 617672722
    m_Localized: "\u05D4\u05DE\u05DE\u05DC\u05DB\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 617672723
    m_Localized: "\u05D7\u05D6\u05E8\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 617672724
    m_Localized: "\u05E7\u05E8\u05D1\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 617672725
    m_Localized: "\u05D1\u05E9\u05D3\u05D4 \u05E7\u05E8\u05D1: \u05DB\u05DC \u05E7\u05E8\u05D1 \u05E0\u05E2\u05E8\u05DA \u05D1\u05E9\u05D3\u05D4 \u05DE\u05E9\u05DC\u05D5, \u05D5\u05D4\u05E6\u05D1\u05D0\u05D5\u05EA \u05E2\u05E8\u05D5\u05DB\u05D9\u05DD \u05DE\u05E9\u05E0\u05D9 \u05E6\u05D3\u05D3\u05D9\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 617672726
    m_Localized: "\u05E2\u05DC \u05D4\u05DE\u05E4\u05D4: \u05D4\u05E7\u05E8\u05D1\u05D5\u05EA \u05E0\u05E2\u05E8\u05DB\u05D9\u05DD \u05D4\u05D9\u05DB\u05DF \u05E9\u05D4\u05E6\u05D1\u05D0\u05D5\u05EA \u05E0\u05E4\u05D2\u05E9\u05D9\u05DD, \u05E2\u05DC \u05DE\u05E9\u05D5\u05E9\u05D9 \u05D4\u05DE\u05E4\u05D4.\n\u05DE\u05E9\u05D7\u05E7 \u05E9\u05DE\u05D5\u05E8 \u05DE\u05DE\u05E9\u05D9\u05DA \u05DB\u05E4\u05D9 \u05E9\u05D4\u05EA\u05D7\u05D9\u05DC."
    m_Metadata:
      m_Items: []
  - m_Id: 617672727
    m_Localized: "\u05D4\u05EA\u05D7\u05DC\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 617672728
    m_Localized: "\u05E2\u05DC \u05D4\u05DE\u05E4\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 617672729
    m_Localized: "\u05D1\u05E9\u05D3\u05D4 \u05E7\u05E8\u05D1"
    m_Metadata:
      m_Items: []
  - m_Id: 617672730
    m_Localized: "\u05E0\u05E2\u05D5\u05DC: \u05D9\u05E9 \u05DC\u05E0\u05E6\u05D7 \u05D1\u05E4\u05E8\u05E7 \u05E9\u05DC\u05E4\u05E0\u05D9\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 617672731
    m_Localized: "\u05E0\u05E2\u05D5\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 617672732
    m_Localized: "\u05E0\u05D9\u05E6\u05D7\u05D5\u05DF \u05D1\u05E4\u05E8\u05E7 \u05D4\u05E7\u05D5\u05D3\u05DD \u05D9\u05E4\u05EA\u05D7 \u05D0\u05EA \u05D4\u05E4\u05E8\u05E7 \u05D4\u05D6\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 617672733
    m_Localized: "{0} \u05E9\u05D7\u05E7\u05E0\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 617672734
    m_Localized: "\u05D0\u05E8\u05E5 \u05DE\u05E9\u05DC\u05D4 \u05DC-{0} \u05DE\u05DE\u05DC\u05DB\u05D5\u05EA, \u05E2\u05DD \u05D0\u05D5\u05E6\u05E8\u05D5\u05EA {1} \u05D5{2}. \u05D1\u05E0\u05D5 \u05D0\u05EA \u05E2\u05E8\u05D9\u05DB\u05DD, \u05D0\u05E1\u05E4\u05D5 \u05E6\u05D1\u05D0\u05D5\u05EA \u05D5\u05DB\u05D1\u05E9\u05D5 \u05D0\u05EA \u05D4\u05D0\u05E8\u05E5."
    m_Metadata:
      m_Items: []
  - m_Id: 617672735
    m_Localized: "\u05D3\u05DC\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 617672736
    m_Localized: "\u05D4\u05D5\u05D2\u05E0\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 617672737
    m_Localized: "\u05E2\u05E9\u05D9\u05E8\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 617672738
    m_Localized: "\u05DE\u05E2\u05D8 \u05E6\u05D1\u05D0\u05D5\u05EA \u05E0\u05D5\u05D3\u05D3\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 617672739
    m_Localized: "\u05DB\u05DE\u05D4 \u05E6\u05D1\u05D0\u05D5\u05EA \u05E0\u05D5\u05D3\u05D3\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 617672740
    m_Localized: "\u05D4\u05E8\u05D1\u05D4 \u05E6\u05D1\u05D0\u05D5\u05EA \u05E0\u05D5\u05D3\u05D3\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 617672741
    m_Localized: "\u05D4\u05DE\u05D5\u05E0\u05D9 \u05E6\u05D1\u05D0\u05D5\u05EA \u05E0\u05D5\u05D3\u05D3\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 617672742
    m_Localized: "\u05DC\u05E0\u05D9\u05E6\u05D7\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 617672743
    m_Localized: "\u05D4\u05DE\u05E9\u05D9\u05DE\u05D4 \u05E9\u05DC\u05DA"
    m_Metadata:
      m_Items: []
  - m_Id: 617672744
    m_Localized: "{0} \u05DE\u05DE\u05DC\u05DB\u05D5\u05EA \u05E2\u05DC \u05DE\u05E4\u05D4 \u05E9\u05DC {1} \u05E2\u05DC {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 617672745
    m_Localized: "\u05D4\u05EA\u05DB\u05EA\u05E9\u05D5\u05EA \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05DC\u05E9\u05DD \u05D4\u05D4\u05E0\u05D0\u05D4: \u05D4\u05D9\u05D0 \u05D0\u05D9\u05E0\u05D4 \u05DE\u05E2\u05E0\u05D9\u05E7\u05D4 \u05DB\u05D5\u05DB\u05D1\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 617672746
    m_Localized: "\u05E9\u05D9\u05D0"
    m_Metadata:
      m_Items: []
  - m_Id: 617672747
    m_Localized: "\u05D8\u05E8\u05DD \u05E0\u05D5\u05E6\u05D7"
    m_Metadata:
      m_Items: []
  - m_Id: 617672748
    m_Localized: "{0} \u05EA\u05D5\u05DA {1} \u05D9\u05DE\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 617672749
    m_Localized: "\u05E7\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 617672750
    m_Localized: "\u05E8\u05D2\u05D9\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 617672751
    m_Localized: "\u05E7\u05E9\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 617672752
    m_Localized: "\u05D1\u05D7\u05D9\u05E8\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 617672753
    m_Localized: "\u05D4\u05DC\u05D0\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 617672754
    m_Localized: "\u05DC\u05D7\u05E6\u05D5 \u05E2\u05DC \u05E7\u05DC\u05E3 \u05DB\u05D3\u05D9 \u05DC\u05D1\u05D7\u05D5\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 617672755
    m_Localized: "{0} \u05DE\u05D2\u05D9\u05E2 \u05DC\u05D3\u05E8\u05D2\u05D4 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 617672756
    m_Localized: "\u05D3\u05E8\u05D2\u05D4 \u05D7\u05D3\u05E9\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 617672757
    m_Localized: "\u05D1\u05D7\u05E8\u05D5 \u05DE\u05D4 \u05E2\u05D5\u05D3 \u05D4\u05D2\u05D9\u05D1\u05D5\u05E8 \u05DC\u05DE\u05D3."
    m_Metadata:
      m_Items: []
  - m_Id: 617672758
    m_Localized: "\u05E8\u05DE\u05D4 \u05E0\u05D5\u05DB\u05D7\u05D9\u05EA: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 617672759
    m_Localized: "\u05DE\u05D9\u05D5\u05DE\u05E0\u05D5\u05EA \u05D7\u05D3\u05E9\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 617672760
    m_Localized: "{0} (\u05D1\u05E1\u05D9\u05E1\u05D9)"
    m_Metadata:
      m_Items: []
  - m_Id: 617672761
    m_Localized: "{0} (\u05DE\u05EA\u05E7\u05D3\u05DD)"
    m_Metadata:
      m_Items: []
  - m_Id: 617672762
    m_Localized: "{0} (\u05DE\u05D5\u05DE\u05D7\u05D4)"
    m_Metadata:
      m_Items: []
  - m_Id: 617672763
    m_Localized: "\u05EA\u05D9\u05D1\u05EA \u05D0\u05D5\u05E6\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 617672764
    m_Localized: "\u05D6\u05D4\u05D1 \u05DC\u05E7\u05D5\u05E4\u05D4, \u05D0\u05D5 \u05DC\u05E7\u05D7\u05D9 \u05D4\u05D3\u05E8\u05DA?"
    m_Metadata:
      m_Items: []
  - m_Id: 617672765
    m_Localized: "{0} \u05D6\u05D4\u05D1"
    m_Metadata:
      m_Items: []
  - m_Id: 617672766
    m_Localized: "\u05DC\u05D0\u05D5\u05E6\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 617672767
    m_Localized: "\u05DE\u05E9\u05DE\u05E9 \u05DC\u05D1\u05E0\u05D9\u05D9\u05E0\u05D9\u05DD, \u05DC\u05D9\u05E6\u05D5\u05E8\u05D9\u05DD \u05D5\u05DC\u05D2\u05D9\u05D1\u05D5\u05E8\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 617672768
    m_Localized: "{0} \u05E0\u05D9\u05E1\u05D9\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 617672769
    m_Localized: "\u05DC\u05D2\u05D9\u05D1\u05D5\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 617672770
    m_Localized: "\u05DE\u05E7\u05E8\u05D1 \u05D0\u05EA \u05D4\u05D3\u05E8\u05D2\u05D4 \u05D4\u05D1\u05D0\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 617672771
    m_Localized: "\u05D4\u05D6\u05D9\u05E8\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 617672772
    m_Localized: "\u05D0\u05D3\u05D5\u05E0\u05D9 \u05D4\u05D6\u05D9\u05E8\u05D4 \u05DE\u05E6\u05D9\u05E2\u05D9\u05DD \u05D0\u05EA \u05D0\u05D9\u05DE\u05D5\u05E0\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 617672773
    m_Localized: "\u05DC\u05D4\u05DB\u05D5\u05EA \u05D7\u05D6\u05E7 \u05D9\u05D5\u05EA\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 617672774
    m_Localized: "\u05DB\u05DC \u05D9\u05E6\u05D5\u05E8 \u05D1\u05E6\u05D1\u05D0 \u05D4\u05D2\u05D9\u05D1\u05D5\u05E8 \u05DE\u05DB\u05D4 \u05D7\u05D6\u05E7 \u05D9\u05D5\u05EA\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 617672775
    m_Localized: "\u05DC\u05E2\u05DE\u05D5\u05D3 \u05D0\u05D9\u05EA\u05DF \u05D9\u05D5\u05EA\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 617672776
    m_Localized: "\u05DB\u05DC \u05D9\u05E6\u05D5\u05E8 \u05D1\u05E6\u05D1\u05D0 \u05D4\u05D2\u05D9\u05D1\u05D5\u05E8 \u05E1\u05D5\u05E4\u05D2 \u05E4\u05D7\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 617672777
    m_Localized: "\u05E0\u05D9\u05E6\u05D7\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 617672778
    m_Localized: "\u05EA\u05D1\u05D5\u05E1\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 617672779
    m_Localized: "\u05DE\u05DE\u05DC\u05DB\u05EA\u05DA \u05D2\u05D5\u05D1\u05E8\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 617672780
    m_Localized: "\u05D4\u05D0\u05E8\u05E5 \u05E9\u05DC\u05DA."
    m_Metadata:
      m_Items: []
  - m_Id: 617672781
    m_Localized: "\u05D3\u05D2\u05DC\u05D9\u05DA \u05E0\u05E4\u05DC\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 617672782
    m_Localized: "\u05D9\u05DE\u05D9\u05DD \u05E9\u05D7\u05DC\u05E4\u05D5"
    m_Metadata:
