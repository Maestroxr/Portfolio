  - m_Id: 642838569
    m_Localized: "\u05D4\u05E6\u05D1\u05D0\u05D5\u05EA \u05D4\u05E0\u05D5\u05D3\u05D3\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 642838570
    m_Localized: "\u05D2\u05D9\u05D1\u05D5\u05E8\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 642838571
    m_Localized: "\u05D0\u05E1\u05D8\u05E8\u05D8\u05D2\u05D9\u05D4 \u05DE\u05D1\u05D5\u05E1\u05E1\u05EA \u05EA\u05D5\u05E8\u05D5\u05EA \u05E9\u05DC \u05D2\u05D9\u05D1\u05D5\u05E8\u05D9\u05DD, \u05E2\u05E8\u05D9\u05DD \u05D5\u05E6\u05D1\u05D0\u05D5\u05EA, \u05E2\u05DC \u05DE\u05E4\u05D4 \u05E9\u05DC \u05DE\u05E9\u05D5\u05E9\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 642838572
    m_Localized: "\u05E7\u05DC\u05D0\u05E1\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 642838573
    m_Localized: "\u05D6\u05D4\u05D1 \u05E2\u05EA\u05D9\u05E7 \u05E2\u05DC \u05E2\u05D5\u05E8 \u05DB\u05D4\u05D4, \u05E7\u05DC\u05E3 \u05D5\u05E9\u05DE\u05D9\u05D9\u05DD \u05D1\u05D4\u05D9\u05E8\u05D9\u05DD: \u05D4\u05DE\u05E9\u05D7\u05E7 \u05DB\u05E4\u05D9 \u05E9\u05E6\u05D5\u05D9\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 642838574
    m_Localized: "\u05DE\u05DE\u05DC\u05DB\u05D4 \u05E7\u05D5\u05D3\u05E8\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 642838575
    m_Localized: "\u05DE\u05DE\u05DC\u05DB\u05D4 \u05D0\u05E4\u05DC\u05D4 \u05D9\u05D5\u05EA\u05E8: \u05E9\u05DE\u05D9\u05D9\u05DD \u05DE\u05E2\u05D5\u05E0\u05E0\u05D9\u05DD, \u05E6\u05D1\u05D0\u05D5\u05EA \u05D1\u05DC\u05D5\u05D9\u05D9\u05DD, \u05D1\u05D5\u05E5 \u05D5\u05D0\u05E4\u05E8, \u05E2\u05D5\u05E8 \u05E9\u05D7\u05D5\u05E8 \u05D5\u05D1\u05E8\u05D6\u05DC \u05E7\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 642838576
    m_Localized: "\u05D4\u05DB\u05EA\u05E8 \u05D4\u05DE\u05E0\u05D5\u05EA\u05E5"
