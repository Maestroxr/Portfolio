  - m_Id: 642838566
    m_Localized: "{0} \u05E2\u05D6\u05D1. \u05D4\u05DE\u05D7\u05E9\u05D1 \u05DE\u05DE\u05E9\u05D9\u05DA \u05DC\u05E9\u05D7\u05E7."
