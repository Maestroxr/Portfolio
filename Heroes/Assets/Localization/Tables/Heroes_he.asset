      m_Items: []
  - m_Id: 304674738597898
    m_Localized: "{0} \u05E4\u05D5\u05D2\u05E9 \u05D0\u05EA {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 304674738597899
    m_Localized: "\u05DC\u05D7\u05E6\u05D5 \u05E2\u05DC \u05D9\u05D7\u05D9\u05D3\u05D4 \u05D5\u05D0\u05D6 \u05E2\u05DC \u05DE\u05E7\u05D5\u05DD \u05D1\u05D0\u05D7\u05D3 \u05D4\u05E6\u05D3\u05D3\u05D9\u05DD. Ctrl \u05D5\u05DC\u05D7\u05D9\u05E6\u05D4 \u05E2\u05DC \u05DE\u05E7\u05D5\u05DD \u05E8\u05D9\u05E7 \u05DE\u05E4\u05E6\u05DC\u05D9\u05DD \u05D9\u05D7\u05D9\u05D3\u05D4. \u05DC\u05D7\u05E6\u05D5 \u05E2\u05DC \u05D7\u05E4\u05E5 \u05E7\u05E1\u05D5\u05DD \u05DB\u05D3\u05D9 \u05DC\u05DE\u05E1\u05D5\u05E8 \u05D0\u05D5\u05EA\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 304674738597900
    m_Localized: "\u05DC\u05D7\u05E6\u05D5 \u05DB\u05D3\u05D9 \u05DC\u05EA\u05EA \u05D0\u05D5\u05EA\u05D5 \u05DC{0}."
    m_Metadata:
      m_Items: []
  - m_Id: 304674738597901
    m_Localized: "\u05E0\u05D1\u05E0\u05D5 \u05E7\u05D5\u05D3\u05DD: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 356674603905024
    m_Localized: "\u05DB\u05D9\u05E1\u05D0 \u05D7\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 356674654236672
    m_Localized: "\u05E9\u05E0\u05D9\u05D9\u05DD \u05E2\u05D3 \u05D0\u05E8\u05D1\u05E2\u05D4 \u05D0\u05E0\u05E9\u05D9\u05DD \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D1\u05EA\u05D5\u05E8\u05D5\u05EA \u05D1\u05D0\u05D5\u05EA\u05D5 \u05DE\u05DB\u05E9\u05D9\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 356674654236673
    m_Localized: "\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D1\u05EA\u05D5\u05E8\u05D5\u05EA \u05D1\u05D0\u05D5\u05EA\u05D5 \u05DE\u05DB\u05E9\u05D9\u05E8; \u05D4\u05DE\u05D7\u05E9\u05D1 \u05D9\u05DB\u05D5\u05DC \u05DC\u05E9\u05D7\u05E7 \u05DB\u05DC \u05DE\u05DE\u05DC\u05DB\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 356674654236674
