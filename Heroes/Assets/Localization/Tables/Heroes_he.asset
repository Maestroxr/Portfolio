      m_Items: []
  - m_Id: 400975224434692
    m_Localized: "\u05E9\u05DE\u05D9\u05E8\u05D4 \u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9\u05EA (\u05DB\u05D9\u05E1\u05D0 \u05D7\u05DD)"
    m_Metadata:
      m_Items: []
  - m_Id: 400975224434693
    m_Localized: "\u05DE\u05E9\u05D7\u05E7 \u05E9\u05E9\u05DE\u05E8\u05EA\u05DD, \u05DC\u05E4\u05D9 \u05E9\u05DE\u05D5; \u05D0\u05D5 \u05E7\u05D5\u05D1\u05E5 \u05E9\u05DE\u05D9\u05E8\u05D4 \u05DC\u05D9\u05D9\u05D1\u05D5\u05D0."
