  - m_Id: 647032837
    m_Localized: "\u05D9\u05D3\u05E2"
    m_Metadata:
      m_Items: []
  - m_Id: 647032838
    m_Localized: "\u05D0\u05D9\u05E9 \u05DE\u05D9\u05DC\u05D9\u05E6\u05D9\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 647032839
    m_Localized: "\u05D0\u05E0\u05E9\u05D9 \u05DE\u05D9\u05DC\u05D9\u05E6\u05D9\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 647032840
    m_Localized: "\u05D0\u05D9\u05DB\u05E8\u05D9\u05DD \u05DE\u05D2\u05D5\u05D9\u05E1\u05D9\u05DD \u05E2\u05DD \u05D7\u05E0\u05D9\u05EA \u05D5\u05DE\u05D2\u05DF \u05E7\u05D8\u05DF. \u05D6\u05D5\u05DC\u05D9\u05DD, \u05E2\u05E7\u05E9\u05E0\u05D9\u05DD \u05D5\u05E8\u05D1\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 647032841
    m_Localized: "\u05E7\u05E9\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 647032842
    m_Localized: "\u05E7\u05E9\u05EA\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 647032843
    m_Localized: "\u05E7\u05E9\u05EA\u05D9 \u05D4\u05E7\u05E9\u05EA \u05D4\u05D0\u05E8\u05D5\u05DB\u05D4 \u05DE\u05D9\u05E2\u05E8\u05D5\u05EA \u05D4\u05DE\u05DC\u05DA. \u05D7\u05DC\u05E9\u05D9\u05DD \u05DE\u05E7\u05E8\u05D5\u05D1, \u05E7\u05D8\u05DC\u05E0\u05D9\u05D9\u05DD \u05DE\u05D0\u05D7\u05D5\u05E8\u05D9 \u05D7\u05D5\u05DE\u05EA \u05E8\u05DE\u05D7\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 647032844
    m_Localized: "\u05E1\u05D9\u05D9\u05E3"
    m_Metadata:
      m_Items: []
  - m_Id: 647032845
    m_Localized: "\u05E1\u05D9\u05D9\u05E4\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 647032846
    m_Localized: "\u05D7\u05E8\u05D1 \u05D5\u05DE\u05D2\u05DF, \u05E2\u05DE\u05D5\u05D3 \u05D4\u05E9\u05D3\u05E8\u05D4 \u05E9\u05DC \u05DB\u05DC \u05E6\u05D1\u05D0 \u05DE\u05DC\u05DB\u05D5\u05EA\u05D9."
    m_Metadata:
      m_Items: []
  - m_Id: 647032847
    m_Localized: "\u05DB\u05D5\u05D4\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 647032848
    m_Localized: "\u05DB\u05D5\u05D4\u05E0\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 647032849
    m_Localized: "\u05DE\u05D8\u05D5\u05EA\u05D9\u05D4\u05DD \u05D4\u05DE\u05D1\u05D5\u05E8\u05DB\u05D9\u05DD \u05DE\u05DB\u05D9\u05DD \u05D1\u05D0\u05D5\u05E8 \u05E7\u05D3\u05D5\u05E9 \u05DE\u05DB\u05DC \u05D8\u05D5\u05D5\u05D7."
    m_Metadata:
      m_Items: []
  - m_Id: 647032850
    m_Localized: "\u05E6\u05DC\u05D1\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 647032851
    m_Localized: "\u05E6\u05DC\u05D1\u05E0\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 647032852
    m_Localized: "\u05E7\u05E0\u05D0\u05D9\u05DD \u05D1\u05E9\u05E8\u05D9\u05D5\u05DF \u05DB\u05D1\u05D3 \u05E9\u05DE\u05DB\u05D9\u05DD \u05E4\u05E2\u05DE\u05D9\u05D9\u05DD \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05D0\u05D5\u05D9\u05D1 \u05DE\u05E1\u05E4\u05D9\u05E7 \u05DC\u05D4\u05E9\u05D9\u05D1."
    m_Metadata:
      m_Items: []
