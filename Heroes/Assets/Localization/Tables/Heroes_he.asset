  - m_Id: 617672815
    m_Localized: "\u05D4\u05E9\u05DB\u05D9\u05D1\u05D5 \u05D0\u05EA \u05D4\u05D2\u05D9\u05D1\u05D5\u05E8 \u05D4\u05E0\u05D1\u05D7\u05E8 \u05DC\u05D9\u05E9\u05D5\u05DF: \"\u05D4\u05D2\u05D9\u05D1\u05D5\u05E8 \u05D4\u05D1\u05D0\" \u05D9\u05D3\u05DC\u05D2 \u05E2\u05DC\u05D9\u05D5."
