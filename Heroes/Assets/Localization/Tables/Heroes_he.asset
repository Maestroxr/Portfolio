      m_Items: []
  - m_Id: 621867053
    m_Localized: "\u05DE\u05D5\u05E8\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 621867054
    m_Localized: "\u05DE\u05D5\u05E8\u05DC \u05D8\u05D5\u05D1 \u05E2\u05E9\u05D5\u05D9 \u05DC\u05D4\u05E2\u05E0\u05D9\u05E7 \u05DC\u05D9\u05E6\u05D5\u05E8 \u05EA\u05D5\u05E8 \u05E0\u05D5\u05E1\u05E3; \u05DE\u05D5\u05E8\u05DC \u05E8\u05E2 \u05E2\u05E9\u05D5\u05D9 \u05DC\u05D2\u05E8\u05D5\u05DD \u05DC\u05D5 \u05DC\u05D0\u05D1\u05D3 \u05EA\u05D5\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 621867055
    m_Localized: "\u05DE\u05D6\u05DC \u05D8\u05D5\u05D1 \u05E2\u05E9\u05D5\u05D9 \u05DC\u05D4\u05DB\u05E4\u05D9\u05DC \u05D0\u05EA \u05E2\u05D5\u05E6\u05DE\u05EA \u05D4\u05DE\u05DB\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 621867056
    m_Localized: "\u05DE\u05D0\u05E0\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 621867057
    m_Localized: "\u05DE\u05D4 \u05E9\u05E2\u05D5\u05DC\u05D9\u05DD \u05DC\u05D7\u05E9\u05D9 \u05D4\u05D2\u05D9\u05D1\u05D5\u05E8. \u05D4\u05D9\u05D0 \u05DE\u05EA\u05D7\u05D3\u05E9\u05EA \u05DE\u05D9\u05D5\u05DD \u05DC\u05D9\u05D5\u05DD, \u05D5\u05D1\u05DE\u05DC\u05D5\u05D0\u05D4 \u05D1\u05E2\u05D9\u05E8 \u05E2\u05DD \u05D2\u05D9\u05DC\u05D3\u05EA \u05E7\u05D5\u05E1\u05DE\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 621867058
    m_Localized: "\u05EA\u05E0\u05D5\u05E2\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 621867059
    m_Localized: "\u05DB\u05DE\u05D4 \u05E8\u05D7\u05D5\u05E7 \u05D4\u05D2\u05D9\u05D1\u05D5\u05E8 \u05E2\u05D5\u05D3 \u05D9\u05DB\u05D5\u05DC \u05DC\u05DC\u05DB\u05EA \u05D4\u05D9\u05D5\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 621867060
    m_Localized: "\u05DB\u05DC \u05D9\u05E6\u05D5\u05E8 \u05D1\u05E6\u05D1\u05D0 \u05DE\u05DB\u05D4 \u05D7\u05D6\u05E7 \u05D9\u05D5\u05EA\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 621867061
    m_Localized: "\u05DB\u05DC \u05D9\u05E6\u05D5\u05E8 \u05D1\u05E6\u05D1\u05D0 \u05E1\u05D5\u05E4\u05D2 \u05E4\u05D7\u05D5\u05EA \u05DE\u05DE\u05DB\u05D4."
