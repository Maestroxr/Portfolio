  - m_Id: 304674738597893
    m_Localized: "\u05D0\u05D9\u05DF \u05DE\u05DE\u05EA\u05D9\u05E0\u05D9\u05DD \u05E2\u05D3 \u05D4\u05E9\u05D1\u05D5\u05E2 \u05D4\u05D1\u05D0."
