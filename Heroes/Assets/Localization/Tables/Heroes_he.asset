    m_Localized: "\u05E9\u05D3\u05D5\u05EA \u05D4\u05EA\u05DC\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 647033287
    m_Localized: "\u05E9\u05D5\u05DE\u05E8\u05D9 \u05D4\u05EA\u05DC\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 647033288
    m_Localized: "\u05D7\u05D5\u05E4\u05E8\u05D9 \u05D4\u05E7\u05D1\u05E8\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 647033289
    m_Localized: "\u05D4\u05DE\u05DC\u05DB\u05D9\u05DD \u05D4\u05E7\u05D3\u05D5\u05DE\u05D9\u05DD \u05E0\u05E7\u05D1\u05E8\u05D5 \u05E2\u05DD \u05DB\u05EA\u05E8\u05D9\u05D4\u05DD. \u05D0\u05D7\u05D3 \u05DE\u05D4\u05DD \u05E9\u05D5\u05D5\u05D4 \u05D9\u05D5\u05EA\u05E8 \u05DE\u05DB\u05DC \u05D4\u05E9\u05D0\u05E8, \u05D5\u05D0\u05D9\u05E0\u05DA \u05D4\u05D9\u05D7\u05D9\u05D3 \u05E9\u05D7\u05D5\u05E4\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 647033290
    m_Localized: "\u05DB\u05EA\u05E8 \u05D4\u05D3\u05E8\u05E7\u05D5\u05E0\u05D9\u05DD \u05E9\u05DC\u05DA. \u05D4\u05D5\u05D0 \u05DB\u05D1\u05D3 \u05D9\u05D5\u05EA\u05E8 \u05DE\u05DE\u05D4 \u05E9\u05E0\u05E8\u05D0\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 647033291
