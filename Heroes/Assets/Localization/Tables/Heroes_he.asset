    m_Metadata:
      m_Items: []
  - m_Id: 647033292
    m_Localized: "\u05D6\u05D4\u05D1 \u05D5\u05D0\u05E4\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 647033293
    m_Localized: "\u05E6\u05D1\u05D0 \u05E2\u05D5\u05DC\u05D4 \u05D6\u05D4\u05D1, \u05D5\u05DE\u05DB\u05E8\u05D5\u05EA \u05D4\u05DE\u05D6\u05E8\u05D7 \u05D1\u05D9\u05D3\u05D9 \u05D4\u05E9\u05D1\u05D8\u05D9\u05DD. \u05DB\u05D1\u05E9\u05D5 \u05D0\u05D5\u05EA\u05DD, \u05D4\u05E4\u05E2\u05D9\u05DC\u05D5 \u05D0\u05D5\u05EA\u05DD \u05D5\u05E9\u05DC\u05DE\u05D5 \u05DC\u05D0\u05E0\u05E9\u05D9\u05DB\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 647033294
    m_Localized: "\u05D4\u05EA\u05D9\u05D1\u05D5\u05EA \u05DE\u05DC\u05D0\u05D5\u05EA. \u05E9\u05DB\u05D9\u05E8\u05D9 \u05D4\u05D7\u05E8\u05D1 \u05D9\u05DC\u05DB\u05D5 \u05D0\u05D7\u05E8\u05D9\u05DA \u05D3\u05E8\u05D5\u05DE\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 647033295
    m_Localized: "\u05DC\u05D0\u05E1\u05D5\u05E3 60,000 \u05D6\u05D4\u05D1 \u05DB\u05D3\u05D9 \u05DC\u05E9\u05DC\u05DD \u05DC\u05E6\u05D1\u05D0."
    m_Metadata:
      m_Items: []
