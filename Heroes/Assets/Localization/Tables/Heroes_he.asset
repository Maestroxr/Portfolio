  - m_Id: 647033277
    m_Localized: "\u05E9\u05D1\u05D8 \u05DC\u05E1\u05EA \u05D4\u05D1\u05E8\u05D6\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 647033278
    m_Localized: "\u05D4\u05E4\u05D5\u05E9\u05D8\u05D9\u05DD \u05D1\u05D0\u05D5 \u05D1\u05D0\u05D1\u05D9\u05D1 \u05D5\u05DB\u05D1\u05E9\u05D5 \u05D0\u05EA \u05D4\u05E2\u05DE\u05E7 \u05D1\u05D6\u05DE\u05DF \u05E9\u05E6\u05D1\u05D0\u05D5\u05EA \u05D4\u05DE\u05DC\u05DA \u05D4\u05D9\u05D5 \u05E8\u05D7\u05D5\u05E7\u05D9\u05DD. \u05D9\u05E9 \u05DC\u05DA \u05E2\u05D9\u05E8, \u05E7\u05D5\u05DE\u05E5 \u05D0\u05E0\u05E9\u05D9 \u05DE\u05D9\u05DC\u05D9\u05E6\u05D9\u05D4 \u05D5\u05D3\u05E8\u05DA \u05E9\u05DE\u05D5\u05D1\u05D9\u05DC\u05D4 \u05D4\u05D1\u05D9\u05EA\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 647033279
    m_Localized: "\u05D4\u05E2\u05DE\u05E7 \u05E9\u05D5\u05D1 \u05E9\u05DC\u05DA. \u05DE\u05D4\u05D1\u05D9\u05E8\u05D4 \u05DE\u05D2\u05D9\u05E2\u05D4 \u05D1\u05E9\u05D5\u05E8\u05D4: \u05D4\u05DE\u05DC\u05DA \u05DE\u05EA, \u05D5\u05D4\u05DB\u05EA\u05E8 \u05E0\u05E9\u05D1\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 647033280
    m_Localized: "\u05DC\u05D2\u05E8\u05E9 \u05D0\u05EA \u05E4\u05D5\u05E9\u05D8\u05D9 \u05DC\u05E1\u05EA \u05D4\u05D1\u05E8\u05D6\u05DC \u05DE\u05DF \u05D4\u05E2\u05DE\u05E7."
    m_Metadata:
      m_Items: []
  - m_Id: 647033281
    m_Localized: "\u05D1\u05D9\u05E6\u05D5\u05EA \u05D4\u05DE\u05DC\u05D7"
    m_Metadata:
      m_Items: []
  - m_Id: 647033282
    m_Localized: "\u05DB\u05EA \u05D4\u05D7\u05D9\u05D5\u05D5\u05E8\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 647033283
    m_Localized: "\u05DE\u05E9\u05D4\u05D5 \u05D1\u05D1\u05D9\u05E6\u05D5\u05EA \u05DE\u05E7\u05D9\u05DD \u05D0\u05EA \u05D4\u05D8\u05D1\u05D5\u05E2\u05D9\u05DD. \u05DC\u05DB\u05D5 \u05D1\u05D3\u05E8\u05DA \u05DE\u05D6\u05E8\u05D7\u05D4 \u05D5\u05E9\u05D9\u05DE\u05D5 \u05E7\u05E5 \u05DC\u05DE\u05D9 \u05E9\u05E7\u05D5\u05E8\u05D0 \u05DC\u05D4\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 647033284
    m_Localized: "\u05DE\u05D2\u05D3\u05DC \u05D4\u05DB\u05EA \u05E0\u05D5\u05E4\u05DC. \u05D1\u05DE\u05E8\u05EA\u05E3 \u05E9\u05DC\u05D5 \u05DE\u05D5\u05E6\u05D0\u05D9\u05DD \u05DE\u05E4\u05D4 \u05E9\u05DC \u05EA\u05DC\u05D9 \u05D4\u05E7\u05D1\u05D5\u05E8\u05D4 \u05D4\u05E2\u05EA\u05D9\u05E7\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 647033285
    m_Localized: "\u05DC\u05DB\u05D1\u05D5\u05E9 \u05D0\u05EA \u05E2\u05D9\u05E8 \u05D4\u05DB\u05EA \u05E9\u05D1\u05D1\u05D9\u05E6\u05D5\u05EA."
    m_Metadata:
      m_Items: []
