  - m_Id: 304674738597894
    m_Localized: "\u05D4\u05D2\u05D9\u05D1\u05D5\u05E8 \u05E6\u05E8\u05D9\u05DA \u05DC\u05E2\u05DE\u05D5\u05D3 \u05DC\u05D9\u05D3 \u05D4\u05DE\u05E9\u05DB\u05DF."
