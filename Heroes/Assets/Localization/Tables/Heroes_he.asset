      m_Items: []
  - m_Id: 626061352
    m_Localized: "\u05E0\u05D6\u05E7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 626061353
    m_Localized: "\u05D4\u05E8\u05D5\u05D2\u05D9\u05DD {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 626061354
    m_Localized: "\u05DC\u05E1\u05D2\u05EA?"
    m_Metadata:
      m_Items: []
  - m_Id: 626061355
    m_Localized: "{0} \u05EA\u05E0\u05D5\u05E1 \u05DE\u05E9\u05D3\u05D4 \u05D4\u05E7\u05E8\u05D1, \u05D5\u05DB\u05DC \u05D9\u05E6\u05D5\u05E8 \u05D1\u05E6\u05D1\u05D0\u05D4 \u05D9\u05D0\u05D1\u05D3. \u05D4\u05D9\u05D0 \u05EA\u05E9\u05DE\u05D5\u05E8 \u05E2\u05DC \u05D7\u05E4\u05E6\u05D9\u05D4 \u05D4\u05E7\u05E1\u05D5\u05DE\u05D9\u05DD, \u05D5\u05D0\u05E4\u05E9\u05E8 \u05D9\u05D4\u05D9\u05D4 \u05DC\u05E9\u05DB\u05D5\u05E8 \u05D0\u05D5\u05EA\u05D4 \u05E9\u05D5\u05D1."
    m_Metadata:
      m_Items: []
  - m_Id: 626061356
    m_Localized: "{0} \u05D9\u05E0\u05D5\u05E1 \u05DE\u05E9\u05D3\u05D4 \u05D4\u05E7\u05E8\u05D1, \u05D5\u05DB\u05DC \u05D9\u05E6\u05D5\u05E8 \u05D1\u05E6\u05D1\u05D0\u05D5 \u05D9\u05D0\u05D1\u05D3. \u05D4\u05D5\u05D0 \u05D9\u05E9\u05DE\u05D5\u05E8 \u05E2\u05DC \u05D7\u05E4\u05E6\u05D9\u05D5 \u05D4\u05E7\u05E1\u05D5\u05DE\u05D9\u05DD, \u05D5\u05D0\u05E4\u05E9\u05E8 \u05D9\u05D4\u05D9\u05D4 \u05DC\u05E9\u05DB\u05D5\u05E8 \u05D0\u05D5\u05EA\u05D5 \u05E9\u05D5\u05D1."
    m_Metadata:
      m_Items: []
  - m_Id: 626061357
    m_Localized: "\u05E7\u05E8\u05D1 \u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9: \u05D4\u05DE\u05D7\u05E9\u05D1 \u05DE\u05D5\u05D1\u05D9\u05DC \u05D0\u05EA \u05D7\u05D9\u05D9\u05DC\u05D9\u05DA."
    m_Metadata:
      m_Items: []
  - m_Id: 626061358
    m_Localized: "\u05D4\u05E7\u05E8\u05D1 \u05D4\u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9 \u05DB\u05D1\u05D5\u05D9."
    m_Metadata:
      m_Items: []
  - m_Id: 626061359
    m_Localized: "{0}: \u05D1\u05D7\u05E8\u05D5 \u05DE\u05D8\u05E8\u05D4, \u05D0\u05D5 \u05DC\u05D7\u05E6\u05D5 \u05D1\u05DB\u05E4\u05EA\u05D5\u05E8 \u05D4\u05D9\u05DE\u05E0\u05D9 \u05DB\u05D3\u05D9 \u05DC\u05E1\u05D2\u05D5\u05E8 \u05D0\u05EA \u05D4\u05E1\u05E4\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 626061360
    m_Localized: "\u05D4\u05E7\u05E8\u05D1 \u05D4\u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9 \u05E0\u05E2\u05E6\u05E8: \u05D4\u05E7\u05E8\u05D1 \u05DE\u05EA\u05E0\u05D4\u05DC \u05E8\u05E2. \u05D4\u05DE\u05E9\u05D9\u05DB\u05D5 \u05DC\u05D4\u05D9\u05DC\u05D7\u05DD, \u05D0\u05D5 \u05E1\u05D2\u05D5 (R)."
    m_Metadata:
      m_Items: []
