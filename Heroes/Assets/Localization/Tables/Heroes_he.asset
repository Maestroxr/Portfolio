    m_Localized: "\u05D4\u05D8\u05D1\u05D5\u05E2\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 647033298
    m_Localized: "\u05E9\u05D5\u05D3\u05D3\u05D9 \u05D4\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 647033299
    m_Localized: "\u05E9\u05E0\u05D9 \u05E6\u05D9\u05D9\u05DD \u05D5\u05D9\u05DD \u05E6\u05E8 \u05D0\u05D7\u05D3. \u05DE\u05D9 \u05E9\u05DE\u05D7\u05D6\u05D9\u05E7 \u05D1\u05D0\u05D9\u05D9\u05DD \u05DE\u05D7\u05D6\u05D9\u05E7 \u05D1\u05D3\u05E8\u05DA \u05DC\u05D1\u05D9\u05E8\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 647033300
    m_Localized: "\u05D4\u05D0\u05D9\u05D9\u05DD \u05E9\u05E7\u05D8\u05D9\u05DD. \u05D4\u05D3\u05E8\u05DA \u05DC\u05D1\u05D9\u05E8\u05D4 \u05E4\u05EA\u05D5\u05D7\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 647033301
    m_Localized: "\u05DC\u05D8\u05D4\u05E8 \u05D0\u05EA \u05D4\u05D0\u05D9\u05D9\u05DD \u05DE\u05E9\u05E0\u05D9 \u05D4\u05D8\u05D5\u05E2\u05E0\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 647033302
    m_Localized: "\u05D7\u05D5\u05E8\u05E3 \u05D1\u05E9\u05E2\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 647033303
    m_Localized: "\u05E9\u05D0\u05E8\u05D9\u05EA \u05DC\u05E1\u05EA \u05D4\u05D1\u05E8\u05D6\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 647033304
    m_Localized: "\u05D4\u05E9\u05DC\u05D2 \u05D9\u05D7\u05E1\u05D5\u05DD \u05D0\u05EA \u05D4\u05DE\u05E2\u05D1\u05E8 \u05D1\u05E2\u05D5\u05D3 \u05D7\u05D5\u05D3\u05E9. \u05E2\u05D3 \u05D0\u05D6, \u05DB\u05DC \u05DE\u05D9 \u05E9\u05D7\u05D5\u05DE\u05D3 \u05D0\u05EA \u05D4\u05D1\u05D9\u05E8\u05D4 \u05E6\u05E8\u05D9\u05DA \u05DC\u05E2\u05D1\u05D5\u05E8 \u05D3\u05E8\u05DB\u05DB\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 647033305
    m_Localized: "\u05D4\u05E9\u05DC\u05D2 \u05D7\u05D5\u05E1\u05DD \u05D0\u05EA \u05D4\u05DE\u05E2\u05D1\u05E8 \u05DE\u05D0\u05D7\u05D5\u05E8\u05D9 \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF \u05E9\u05D1\u05D4\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 647033306
    m_Localized: "\u05DC\u05D4\u05D7\u05D6\u05D9\u05E7 \u05D0\u05EA \u05D4\u05DE\u05E2\u05D1\u05E8 \u05DE\u05D5\u05DC \u05E9\u05E0\u05D9 \u05D4\u05E6\u05D1\u05D0\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 647033307
    m_Localized: "\u05D7\u05D5\u05D1 \u05D4\u05D3\u05E8\u05E7\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 647033308
    m_Localized: "\u05D4\u05E9\u05D1\u05D8\u05D9\u05DD \u05DE\u05D7\u05D6\u05D9\u05E7\u05D9\u05DD \u05D3\u05E8\u05E7\u05D5\u05DF, \u05D5\u05D4\u05D3\u05E8\u05E7\u05D5\u05DF \u05DE\u05D7\u05D6\u05D9\u05E7 \u05D1\u05E6\u05D5\u05E7\u05D9\u05DD. \u05E9\u05E0\u05D9 \u05D4\u05D7\u05D5\u05D1\u05D5\u05EA \u05E0\u05E4\u05E8\u05E2\u05D9\u05DD \u05D4\u05D9\u05D5\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 647033309
    m_Localized: "\u05D4\u05D3\u05E8\u05E7\u05D5\u05DF \u05DE\u05EA. \u05D4\u05D0\u05D5\u05E6\u05E8 \u05E9\u05DC\u05D5 \u05DE\u05E9\u05DC\u05DD \u05E2\u05DC \u05D4\u05DE\u05E1\u05E2 \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 647033310
    m_Localized: "\u05DC\u05D4\u05E8\u05D5\u05D2 \u05D0\u05EA \u05D4\u05D3\u05E8\u05E7\u05D5\u05DF \u05D4\u05D0\u05D3\u05D5\u05DD \u05E9\u05DC \u05D4\u05E6\u05D5\u05E7\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 647033311
    m_Localized: "\u05D8\u05D5\u05E2\u05DF \u05D4\u05DB\u05EA\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 647033312
    m_Localized: "\u05E9\u05DC\u05D5\u05E9\u05D4 \u05D8\u05D5\u05E2\u05E0\u05D9\u05DD, \u05D1\u05D9\u05E8\u05D4 \u05D0\u05D7\u05EA \u05D5\u05DB\u05EA\u05E8 \u05DE\u05E0\u05D5\u05EA\u05E5. \u05DE\u05D9 \u05E9\u05D9\u05D9\u05E9\u05D0\u05E8 \u05E2\u05D5\u05DE\u05D3 \u05D1\u05E1\u05D5\u05E3 \u05D9\u05D7\u05D1\u05D5\u05E9 \u05D0\u05EA \u05DB\u05D5\u05DC\u05DD."
    m_Metadata:
