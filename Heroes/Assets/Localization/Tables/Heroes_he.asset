    m_Localized: "\u05DE\u05D5\u05E2\u05DA \u05D9\u05D7\u05D9\u05D3\u05EA \u05D0\u05D5\u05D9\u05D1 \u05D0\u05D7\u05EA \u05DE\u05D1\u05E4\u05E0\u05D9\u05DD."
