    m_Localized: "\u05DC\u05D7\u05E9\u05D9 \u05D4\u05D2\u05D9\u05D1\u05D5\u05E8 \u05D7\u05D6\u05E7\u05D9\u05DD \u05D9\u05D5\u05EA\u05E8 \u05D5\u05E0\u05DE\u05E9\u05DB\u05D9\u05DD \u05D6\u05DE\u05DF \u05E8\u05D1 \u05D9\u05D5\u05EA\u05E8."
