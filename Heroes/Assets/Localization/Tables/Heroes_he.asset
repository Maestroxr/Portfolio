    m_Localized: "\u05D4\u05E9\u05DE\u05D9\u05E8\u05D4 \u05D4\u05D6\u05D0\u05EA \u05D4\u05D9\u05D0 \u05DE\u05D2\u05E8\u05E1\u05D4 \u05D0\u05D7\u05E8\u05EA \u05E9\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7."
