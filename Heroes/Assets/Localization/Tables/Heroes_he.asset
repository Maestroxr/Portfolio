    m_Localized: "\u05DC\u05D4\u05D1\u05D9\u05E1 \u05D0\u05EA \u05DB\u05DC \u05D4\u05D8\u05D5\u05E2\u05E0\u05D9\u05DD \u05DC\u05DB\u05EA\u05E8."
