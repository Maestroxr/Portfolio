  - m_Id: 617672817
    m_Localized: "\u05EA\u05E4\u05E8\u05D9\u05D8 \u05D4\u05DE\u05E9\u05D7\u05E7: \u05D7\u05D6\u05E8\u05D4 \u05DC\u05DE\u05E9\u05D7\u05E7 \u05D0\u05D5 \u05E2\u05D6\u05D9\u05D1\u05EA\u05D5. \u05D4\u05DE\u05E9\u05D7\u05E7 \u05DE\u05DE\u05E9\u05D9\u05DA \u05D1\u05D9\u05E0\u05EA\u05D9\u05D9\u05DD."
