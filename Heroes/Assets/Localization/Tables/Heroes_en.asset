    m_Metadata:
      m_Items: []
  - m_Id: 647033269
    m_Localized: Meteor Shower
    m_Metadata:
      m_Items: []
  - m_Id: 647033270
    m_Localized: Rocks rain on the target hex and around it.
    m_Metadata:
      m_Items: []
  - m_Id: 647033271
    m_Localized: Resurrection
    m_Metadata:
      m_Items: []
  - m_Id: 647033272
