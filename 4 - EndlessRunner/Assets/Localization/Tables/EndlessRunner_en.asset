    m_Metadata:
      m_Items: []
  - m_Id: 533786714
    m_Localized: Jump high enough to land on wagons!
    m_Metadata:
      m_Items: []
  - m_Id: 533786715
    m_Localized: Jump high enough to land on trucks!
    m_Metadata:
      m_Items: []
  - m_Id: 533786716
    m_Localized: Swipe up to jump over hurdles
    m_Metadata:
      m_Items: []
  - m_Id: 533786717
    m_Localized: Swipe up to jump over road blocks
    m_Metadata:
      m_Items: []
  - m_Id: 533786718
    m_Localized: 'Jump over hurdles: UP, SPACE or swipe up'
    m_Metadata:
      m_Items: []
  - m_Id: 533786719
    m_Localized: 'Jump over road blocks: UP, SPACE or swipe up'
    m_Metadata:
      m_Items: []
  - m_Id: 533786720
    m_Localized: Swipe sideways to dodge the crates
    m_Metadata:
