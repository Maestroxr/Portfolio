  - m_Id: 533786721
    m_Localized: Swipe sideways to dodge the dumpsters
    m_Metadata:
      m_Items: []
  - m_Id: 533786722
    m_Localized: 'Dodge the crates: LEFT / RIGHT or swipe sideways'
    m_Metadata:
      m_Items: []
  - m_Id: 533786723
    m_Localized: 'Dodge the dumpsters: LEFT / RIGHT or swipe sideways'
    m_Metadata:
      m_Items: []
  - m_Id: 533786724
    m_Localized: Swipe down to slide under barriers
    m_Metadata:
