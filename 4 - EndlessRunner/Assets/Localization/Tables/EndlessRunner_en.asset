  - m_Id: 533786685
    m_Localized: 'Best run: <b>{0:0} m</b>  ({1} points)'
    m_Metadata:
      m_Items: []
  - m_Id: 533786686
    m_Localized: No record yet - set one!
    m_Metadata:
      m_Items: []
  - m_Id: 533786687
    m_Localized: 'Run as far as you can.

      The world changes as you go.

      {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 533786688
    m_Localized: 'Run as far as you can.

      The city changes as you go.

      {0}'
