    m_Localized: "{0} - \u05DE\u05E8\u05D5\u05E5 \u05E9\u05DC {1} \u05E8\u05E6\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 533786746
    m_Localized: "\u05E8\u05E6\u05EA <b>{0:0} \u05DE'</b> \u05D5\u05D0\u05E1\u05E4\u05EA <b>{1}</b> \u05DE\u05D8\u05D1\u05E2\u05D5\u05EA.\n\u05D4\u05DE\u05D0\u05E8\u05D7 \u05DE\u05EA\u05D7\u05D9\u05DC \u05D0\u05EA \u05D4\u05DE\u05E8\u05D5\u05E5 \u05D4\u05D1\u05D0 \u05DE\u05D4\u05D7\u05D3\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 533786747
    m_Localized: "\u05E8\u05E6\u05EA <b>{0:0} \u05DE'</b> \u05D5\u05D0\u05E1\u05E4\u05EA <b>{1}</b> \u05D0\u05E1\u05D9\u05DE\u05D5\u05E0\u05D9\u05DD.\n\u05D4\u05DE\u05D0\u05E8\u05D7 \u05DE\u05EA\u05D7\u05D9\u05DC \u05D0\u05EA \u05D4\u05DE\u05E8\u05D5\u05E5 \u05D4\u05D1\u05D0 \u05DE\u05D4\u05D7\u05D3\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 533786748
    m_Localized: "\u05DE\u05E8\u05D7\u05E7   <b>{0:0} \u05DE'</b>\n\u05DE\u05D8\u05D1\u05E2\u05D5\u05EA   <b>{1}</b>\n\u05E0\u05D9\u05E7\u05D5\u05D3   <b>{2}</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 533786749
    m_Localized: "\u05DE\u05E8\u05D7\u05E7   <b>{0:0} \u05DE'</b>\n\u05D0\u05E1\u05D9\u05DE\u05D5\u05E0\u05D9\u05DD   <b>{1}</b>\n\u05E0\u05D9\u05E7\u05D5\u05D3   <b>{2}</b>"
    m_Metadata:
      m_Items: []
