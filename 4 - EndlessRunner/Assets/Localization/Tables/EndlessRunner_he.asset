  m_TableData:
  - m_Id: 466677760
    m_Localized: "\u05E8\u05D9\u05E6\u05D4 \u05D0\u05D9\u05E0\u05E1\u05D5\u05E4\u05D9\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 529592320
    m_Localized: "\u05E8\u05E6\u05D9\u05DD \u05D3\u05E8\u05DA \u05D7\u05DE\u05D9\u05E9\u05D4 \u05E2\u05D5\u05DC\u05DE\u05D5\u05EA: \u05DE\u05EA\u05D7\u05DE\u05E7\u05D9\u05DD \u05DE\u05D0\u05E8\u05D2\u05D6\u05D9\u05DD, \u05E7\u05D5\u05E4\u05E6\u05D9\u05DD \u05DE\u05E2\u05DC \u05DE\u05E9\u05D5\u05DB\u05D5\u05EA, \u05D2\u05D5\u05DC\u05E9\u05D9\u05DD \u05DE\u05EA\u05D7\u05EA \u05DC\u05DE\u05D7\u05E1\u05D5\u05DE\u05D9\u05DD \u05D5\u05E2\u05D5\u05DC\u05D9\u05DD \u05D1\u05E8\u05DE\u05E4\u05D5\u05EA \u05D0\u05DC \u05D4\u05E7\u05E8\u05D5\u05E0\u05D5\u05EA \u05DB\u05D3\u05D9 \u05DC\u05D0\u05E1\u05D5\u05E3 \u05DE\u05D8\u05D1\u05E2\u05D5\u05EA. \u05E9\u05DE\u05D5\u05E0\u05D4 \u05E9\u05DC\u05D1\u05D9\u05DD \u05E2\u05DD \u05E9\u05DC\u05D5\u05E9\u05D4 \u05DB\u05D5\u05DB\u05D1\u05D9\u05DD \u05D1\u05DB\u05DC \u05D0\u05D7\u05D3, \u05D5\u05E2\u05D5\u05D3 \u05E8\u05D9\u05E6\u05D4 \u05D0\u05D9\u05E0\u05E1\u05D5\u05E4\u05D9\u05EA. \u05E9\u05E0\u05D9 \u05DE\u05E8\u05D0\u05D5\u05EA: \u05D4\u05E2\u05D5\u05DC\u05DE\u05D5\u05EA \u05D4\u05E7\u05DC\u05D0\u05E1\u05D9\u05D9\u05DD \u05D5\u05DE\u05E9\u05DE\u05E8\u05EA \u05DC\u05D9\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 533786624
    m_Localized: "\u05E7\u05DC\u05D0\u05E1\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 533786625
    m_Localized: "\u05D4\u05E8\u05E5 \u05D4\u05DE\u05E6\u05D5\u05D9\u05E8 \u05D5\u05D4\u05E6\u05D1\u05E2\u05D5\u05E0\u05D9: \u05D7\u05DE\u05D9\u05E9\u05D4 \u05E2\u05D5\u05DC\u05DE\u05D5\u05EA \u05E9\u05D8\u05D5\u05E4\u05D9 \u05E9\u05DE\u05E9, \u05DE\u05D5\u05E9\u05DC\u05D2\u05D9\u05DD, \u05DE\u05D5\u05D0\u05E8\u05D9 \u05D9\u05E8\u05D7 \u05D5\u05D1\u05D5\u05E2\u05E8\u05D9\u05DD, \u05D9\u05DC\u05D3 \u05D1\u05E7\u05E4\u05D5\u05E6'\u05D5\u05DF \u05D5\u05DE\u05D8\u05D1\u05E2\u05D5\u05EA \u05D6\u05D4\u05D1."
    m_Metadata:
      m_Items: []
  - m_Id: 533786626
    m_Localized: "\u05DE\u05E9\u05DE\u05E8\u05EA \u05DC\u05D9\u05DC\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 533786627
    m_Localized: "\u05E8\u05D9\u05E6\u05D4 \u05E9\u05DC \u05E9\u05DC\u05D9\u05D7 \u05D1\u05E2\u05D9\u05E8 \u05D4\u05DC\u05D9\u05DC\u05D9\u05EA: \u05E8\u05D7\u05D5\u05D1\u05D5\u05EA \u05E8\u05D8\u05D5\u05D1\u05D9\u05DD, \u05D4\u05E8\u05DB\u05D1\u05EA \u05D4\u05EA\u05D7\u05EA\u05D9\u05EA, \u05D4\u05E8\u05E6\u05D9\u05E4\u05D9\u05DD, \u05D4\u05DB\u05D1\u05D9\u05E9 \u05D4\u05DE\u05D4\u05D9\u05E8 \u05D5\u05D4\u05D2\u05D2\u05D5\u05EA \u05E2\u05DD \u05E9\u05D7\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 533786628
    m_Localized: "\u05D4\u05D0\u05D7\u05D5 \u05D4\u05E9\u05DE\u05E9\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 533786629
    m_Localized: "\u05E7\u05E0\u05D9\u05D5\u05DF \u05D4\u05E9\u05E7\u05D9\u05E2\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 533786630
    m_Localized: "\u05E4\u05E1\u05D2\u05D5\u05EA \u05E7\u05E4\u05D5\u05D0\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 533786631
    m_Localized: "\u05D9\u05E2\u05E8 \u05D4\u05D9\u05E8\u05D7"
    m_Metadata:
      m_Items: []
  - m_Id: 533786632
    m_Localized: "\u05D0\u05E8\u05E5 \u05D4\u05DC\u05D1\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 533786633
    m_Localized: "\u05DE\u05E8\u05DB\u05D6 \u05D4\u05E2\u05D9\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 533786634
    m_Localized: "\u05D4\u05E8\u05DB\u05D1\u05EA \u05D4\u05EA\u05D7\u05EA\u05D9\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 533786635
    m_Localized: "\u05D4\u05E8\u05E6\u05D9\u05E4\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 533786636
    m_Localized: "\u05D4\u05DB\u05D1\u05D9\u05E9 \u05D4\u05DE\u05D4\u05D9\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 533786637
    m_Localized: "\u05D4\u05D2\u05D2\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 533786638
    m_Localized: "\u05D6\u05D9\u05E0\u05D5\u05E7 \u05E9\u05DE\u05E9\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 533786639
    m_Localized: "\u05DC\u05D5\u05DE\u05D3\u05D9\u05DD \u05D0\u05EA \u05D4\u05D1\u05E1\u05D9\u05E1 \u05D1\u05D0\u05D7\u05D5: \u05DE\u05EA\u05D7\u05DE\u05E7\u05D9\u05DD \u05DE\u05D4\u05D0\u05E8\u05D2\u05D6\u05D9\u05DD, \u05E7\u05D5\u05E4\u05E6\u05D9\u05DD \u05DE\u05E2\u05DC \u05D4\u05DE\u05E9\u05D5\u05DB\u05D5\u05EA \u05D5\u05D0\u05D5\u05E1\u05E4\u05D9\u05DD \u05DB\u05DC \u05DE\u05D8\u05D1\u05E2 \u05D0\u05E4\u05E9\u05E8\u05D9."
    m_Metadata:
      m_Items: []
  - m_Id: 533786640
    m_Localized: "\u05E2\u05D5\u05DC\u05D9\u05DD \u05E2\u05DC \u05D4\u05E8\u05DE\u05E4\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 533786641
    m_Localized: "\u05E7\u05E8\u05D5\u05E0\u05D5\u05EA \u05E0\u05D5\u05E1\u05E2\u05D9\u05DD \u05D1\u05D9\u05DF \u05D4\u05E9\u05D3\u05D5\u05EA. \u05E2\u05DC\u05D5 \u05D1\u05E8\u05DE\u05E4\u05D5\u05EA \u05DB\u05D3\u05D9 \u05DC\u05D4\u05D2\u05D9\u05E2 \u05DC\u05DE\u05D8\u05D1\u05E2\u05D5\u05EA \u05E9\u05DE\u05D7\u05DB\u05D9\u05DD \u05DC\u05DE\u05E2\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 533786642
    m_Localized: "\u05DE\u05EA\u05DB\u05D5\u05E4\u05E4\u05D9\u05DD \u05D5\u05E8\u05E6\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 533786643
    m_Localized: "\u05E9\u05E7\u05D9\u05E2\u05D4 \u05D1\u05E7\u05E0\u05D9\u05D5\u05DF. \u05D2\u05DC\u05E9\u05D5 \u05DE\u05EA\u05D7\u05EA \u05DC\u05DE\u05D7\u05E1\u05D5\u05DE\u05D9\u05DD \u05D5\u05EA\u05E0\u05D5 \u05DC\u05DE\u05E9\u05D8\u05D7\u05D9 \u05D4\u05E7\u05E4\u05D9\u05E6\u05D4 \u05DC\u05D4\u05E2\u05D9\u05E3 \u05D0\u05EA\u05DB\u05DD \u05E2\u05D3 \u05D4\u05E9\u05DE\u05D9\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 533786644
    m_Localized: "\u05D6\u05D9\u05E0\u05D5\u05E7 \u05D1\u05E7\u05E0\u05D9\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 533786645
    m_Localized: "\u05E0\u05D4\u05E8\u05D5\u05EA \u05D7\u05D5\u05E6\u05D9\u05DD \u05D0\u05EA \u05D4\u05D3\u05E8\u05DA. \u05EA\u05D6\u05DE\u05E0\u05D5 \u05D0\u05EA \u05D4\u05E7\u05E4\u05D9\u05E6\u05D5\u05EA - \u05D0\u05D5 \u05DE\u05E6\u05D0\u05D5 \u05D0\u05EA \u05D4\u05D2\u05E9\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 533786646
    m_Localized: "\u05E2\u05D2\u05DC\u05D5\u05EA \u05D3\u05D5\u05D4\u05E8\u05D5\u05EA \u05DE\u05EA\u05D2\u05DC\u05D2\u05DC\u05D5\u05EA \u05D1\u05DE\u05D5\u05E8\u05D3 \u05D4\u05D4\u05E8. \u05E2\u05D9\u05E0\u05D9\u05D9\u05DD \u05E4\u05E7\u05D5\u05D7\u05D5\u05EA!"
    m_Metadata:
      m_Items: []
  - m_Id: 533786647
    m_Localized: "\u05E1\u05DE\u05D8\u05EA \u05D4\u05DE\u05E4\u05D5\u05DC\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 533786648
    m_Localized: "\u05D6\u05E0\u05E7\u05D5 \u05DE\u05E7\u05E8\u05D5\u05DF \u05DC\u05E7\u05E8\u05D5\u05DF \u05D2\u05D1\u05D5\u05D4 \u05DE\u05E2\u05DC \u05D4\u05E9\u05DC\u05D2."
    m_Metadata:
      m_Items: []
  - m_Id: 533786649
    m_Localized: "\u05E8\u05D9\u05E6\u05D4 \u05DC\u05D0\u05D5\u05E8 \u05D4\u05D9\u05E8\u05D7"
    m_Metadata:
      m_Items: []
  - m_Id: 533786650
    m_Localized: "\u05DB\u05DC \u05DE\u05D4 \u05E9\u05DC\u05DE\u05D3\u05EA\u05DD, \u05EA\u05D7\u05EA \u05DB\u05D9\u05E4\u05EA \u05D4\u05DB\u05D5\u05DB\u05D1\u05D9\u05DD. \u05E2\u05E7\u05D1\u05D5 \u05D0\u05D7\u05E8\u05D9 \u05D4\u05D3\u05E8\u05DA \u05D4\u05D6\u05D5\u05D4\u05E8\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 533786651
    m_Localized: "\u05DE\u05E8\u05D5\u05E5 \u05D4\u05DC\u05D1\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 533786652
    m_Localized: "\u05D4\u05E8\u05D9\u05E6\u05D4 \u05D4\u05D0\u05D7\u05E8\u05D5\u05E0\u05D4 \u05E2\u05DC \u05E4\u05E0\u05D9 \u05D4\u05D0\u05D3\u05DE\u05D4 \u05D4\u05D1\u05D5\u05E2\u05E8\u05EA. \u05E8\u05E7 \u05D4\u05D0\u05DE\u05D9\u05E6\u05D9\u05DD \u05D1\u05D9\u05D5\u05EA\u05E8 \u05D9\u05D2\u05D9\u05E2\u05D5 \u05E2\u05D3 \u05D4\u05E1\u05D5\u05E3!"
    m_Metadata:
      m_Items: []
  - m_Id: 533786653
    m_Localized: "\u05E8\u05D9\u05E6\u05D4 \u05D0\u05D9\u05E0\u05E1\u05D5\u05E4\u05D9\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 533786654
    m_Localized: "\u05D0\u05D9\u05DF \u05E7\u05D5 \u05E1\u05D9\u05D5\u05DD. \u05E8\u05E6\u05D9\u05DD \u05D3\u05E8\u05DA \u05DB\u05DC \u05D4\u05E2\u05D5\u05DC\u05DE\u05D5\u05EA \u05D5\u05D4\u05DE\u05D4\u05D9\u05E8\u05D5\u05EA \u05E8\u05E7 \u05E2\u05D5\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 533786655
    m_Localized: "\u05DE\u05E9\u05DE\u05E8\u05EA \u05E8\u05D0\u05E9\u05D5\u05E0\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 533786656
    m_Localized: "\u05D4\u05DC\u05D9\u05DC\u05D4 \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF \u05E9\u05DC\u05DA \u05D1\u05E2\u05D1\u05D5\u05D3\u05D4. \u05D4\u05EA\u05D7\u05DE\u05E7\u05D5 \u05DE\u05E4\u05D7\u05D9 \u05D4\u05D0\u05E9\u05E4\u05D4, \u05D3\u05DC\u05D2\u05D5 \u05DE\u05E2\u05DC \u05DE\u05D7\u05E1\u05D5\u05DE\u05D9 \u05D4\u05DB\u05D1\u05D9\u05E9 \u05D5\u05D0\u05E1\u05E4\u05D5 \u05DB\u05DC \u05D0\u05E1\u05D9\u05DE\u05D5\u05DF \u05D1\u05D3\u05E8\u05DA."
    m_Metadata:
      m_Items: []
  - m_Id: 533786657
    m_Localized: "\u05D0\u05D6\u05D5\u05E8 \u05E4\u05E8\u05D9\u05E7\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 533786658
    m_Localized: "\u05DE\u05E9\u05D0\u05D9\u05D5\u05EA \u05DE\u05E9\u05DC\u05D5\u05D7\u05D9\u05DD \u05E2\u05D5\u05DE\u05D3\u05D5\u05EA \u05DC\u05D0\u05D5\u05E8\u05DA \u05D4\u05E8\u05D7\u05D5\u05D1. \u05E2\u05DC\u05D5 \u05D1\u05E8\u05DE\u05E4\u05D5\u05EA \u05D4\u05D8\u05E2\u05D9\u05E0\u05D4 \u05DB\u05D3\u05D9 \u05DC\u05D4\u05D2\u05D9\u05E2 \u05DC\u05D0\u05E1\u05D9\u05DE\u05D5\u05E0\u05D9\u05DD \u05E9\u05E2\u05DC \u05D4\u05D2\u05D2\u05D5\u05EA \u05E9\u05DC\u05D4\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 533786659
    m_Localized: "\u05DE\u05EA\u05D7\u05EA \u05DC\u05E2\u05D9\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 533786660
    m_Localized: "\u05D4\u05E8\u05DB\u05D1\u05EA \u05D4\u05EA\u05D7\u05EA\u05D9\u05EA \u05D0\u05D7\u05E8\u05D9 \u05D7\u05E6\u05D5\u05EA. \u05D2\u05DC\u05E9\u05D5 \u05DE\u05EA\u05D7\u05EA \u05DC\u05E4\u05D9\u05D2\u05D5\u05DE\u05D9\u05DD \u05D5\u05EA\u05E0\u05D5 \u05DC\u05DE\u05E9\u05D8\u05D7\u05D9 \u05D4\u05D4\u05D6\u05E0\u05E7\u05D4 \u05DC\u05D4\u05E2\u05D9\u05E3 \u05D0\u05EA\u05DB\u05DD \u05E2\u05D3 \u05D4\u05D0\u05D5\u05E8\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 533786661
    m_Localized: "\u05D6\u05D4\u05D9\u05E8\u05D5\u05EA, \u05E4\u05E2\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 533786662
    m_Localized: "\u05D4\u05DE\u05E1\u05D9\u05DC\u05D5\u05EA \u05D7\u05D5\u05E6\u05D5\u05EA \u05D0\u05EA \u05D4\u05E8\u05E6\u05D9\u05E3. \u05EA\u05D6\u05DE\u05E0\u05D5 \u05D0\u05EA \u05D4\u05E7\u05E4\u05D9\u05E6\u05D5\u05EA - \u05D0\u05D5 \u05DE\u05E6\u05D0\u05D5 \u05D0\u05EA \u05D2\u05E9\u05E8 \u05D4\u05E4\u05DC\u05D3\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 533786663
    m_Localized: "\u05DE\u05E9\u05DC\u05D5\u05D7 \u05DC\u05D9\u05DC\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 533786664
    m_Localized: "\u05E2\u05D2\u05DC\u05D5\u05EA \u05D3\u05D5\u05D0\u05E8 \u05DE\u05E9\u05EA\u05D5\u05DC\u05DC\u05D5\u05EA \u05D1\u05D9\u05DF \u05D4\u05DE\u05DB\u05D5\u05DC\u05D5\u05EA. \u05E2\u05D9\u05E0\u05D9\u05D9\u05DD \u05E4\u05E7\u05D5\u05D7\u05D5\u05EA \u05D1\u05E2\u05E8\u05E4\u05DC."
    m_Metadata:
      m_Items: []
  - m_Id: 533786665
    m_Localized: "\u05E8\u05D9\u05E6\u05EA \u05DE\u05DB\u05D5\u05DC\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 533786666
