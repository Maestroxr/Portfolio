    m_Localized: "\u05E2\u05DC\u05D5 \u05D1\u05E8\u05DE\u05E4\u05D4 - \u05DE\u05D8\u05D1\u05E2\u05D5\u05EA \u05DE\u05D7\u05DB\u05D9\u05DD \u05E2\u05DC \u05D4\u05E7\u05E8\u05D5\u05DF!"
    m_Metadata:
      m_Items: []
  - m_Id: 533786729
    m_Localized: "\u05E2\u05DC\u05D5 \u05D1\u05E8\u05DE\u05E4\u05D4 - \u05D0\u05E1\u05D9\u05DE\u05D5\u05E0\u05D9\u05DD \u05DE\u05D7\u05DB\u05D9\u05DD \u05E2\u05DC \u05D4\u05DE\u05E9\u05D0\u05D9\u05EA!"
    m_Metadata:
      m_Items: []
  - m_Id: 533786730
    m_Localized: "\u05D6\u05D4\u05D9\u05E8\u05D5\u05EA, \u05E4\u05E2\u05E8! \u05E7\u05E4\u05E6\u05D5 \u05DC\u05E6\u05D3 \u05D4\u05E9\u05E0\u05D9"
