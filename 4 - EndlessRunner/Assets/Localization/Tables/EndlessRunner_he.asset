    m_Metadata:
      m_Items: []
  - m_Id: 533786755
    m_Localized: "\u05D4\u05D2\u05E2\u05D4 \u05DC\u05E1\u05D9\u05D5\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 533786756
    m_Localized: "\u05D0\u05D9\u05E1\u05D5\u05E3 {0} \u05DE\u05D8\u05D1\u05E2\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 533786757
    m_Localized: "\u05D0\u05D9\u05E1\u05D5\u05E3 {0} \u05D0\u05E1\u05D9\u05DE\u05D5\u05E0\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 533786758
    m_Localized: "\u05E1\u05D9\u05D5\u05DD \u05D1\u05DC\u05D9 \u05E9\u05E8\u05D9\u05D8\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 533786759
    m_Localized: "\u05D0\u05D0\u05D5\u05E5'!"
    m_Metadata:
      m_Items: []
  - m_Id: 533786760
    m_Localized: "\u05D4\u05D2\u05E2\u05EA \u05E2\u05D3 <b>{0:0} \u05DE'</b>\n\u05DE\u05D8\u05D1\u05E2\u05D5\u05EA   <b>{1}</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 533786761
    m_Localized: "\u05D4\u05D2\u05E2\u05EA \u05E2\u05D3 <b>{0:0} \u05DE'</b>\n\u05D0\u05E1\u05D9\u05DE\u05D5\u05E0\u05D9\u05DD   <b>{1}</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 533786762
    m_Localized: "\u05D8\u05D9\u05E4: \u05DE\u05D8\u05D1\u05E2\u05D5\u05EA \u05D1\u05E7\u05E9\u05EA \u05DE\u05E8\u05D0\u05D9\u05DD \u05DE\u05EA\u05D9 \u05DC\u05E7\u05E4\u05D5\u05E5."
    m_Metadata:
      m_Items: []
  - m_Id: 533786763
    m_Localized: "\u05D8\u05D9\u05E4: \u05D0\u05E1\u05D9\u05DE\u05D5\u05E0\u05D9\u05DD \u05D1\u05E7\u05E9\u05EA \u05DE\u05E8\u05D0\u05D9\u05DD \u05DE\u05EA\u05D9 \u05DC\u05E7\u05E4\u05D5\u05E5."
    m_Metadata:
      m_Items: []
  - m_Id: 533786764
    m_Localized: "\u05D8\u05D9\u05E4: \u05D7\u05E5 \u05DC\u05DE\u05D8\u05D4 \u05D1\u05D0\u05D5\u05D5\u05D9\u05E8 \u05E6\u05D5\u05DC\u05DC \u05DE\u05D8\u05D4 \u05D5\u05D2\u05D5\u05DC\u05E9 \u05DE\u05D9\u05D3 \u05D1\u05E0\u05D7\u05D9\u05EA\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 533786765
    m_Localized: "\u05D8\u05D9\u05E4: \u05D4\u05E8\u05DE\u05E4\u05D5\u05EA \u05DE\u05D5\u05D1\u05D9\u05DC\u05D5\u05EA \u05D0\u05DC \u05D4\u05E7\u05E8\u05D5\u05E0\u05D5\u05EA - \u05D4\u05E0\u05EA\u05D9\u05D1 \u05D4\u05D1\u05D8\u05D5\u05D7 \u05D1\u05D9\u05D5\u05EA\u05E8 \u05D4\u05D5\u05D0 \u05DC\u05E8\u05D5\u05D1 \u05DC\u05DE\u05E2\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 533786766
    m_Localized: "\u05D8\u05D9\u05E4: \u05D4\u05E8\u05DE\u05E4\u05D5\u05EA \u05DE\u05D5\u05D1\u05D9\u05DC\u05D5\u05EA \u05D0\u05DC \u05D4\u05DE\u05E9\u05D0\u05D9\u05D5\u05EA - \u05D4\u05E0\u05EA\u05D9\u05D1 \u05D4\u05D1\u05D8\u05D5\u05D7 \u05D1\u05D9\u05D5\u05EA\u05E8 \u05D4\u05D5\u05D0 \u05DC\u05E8\u05D5\u05D1 \u05DC\u05DE\u05E2\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 533786767
    m_Localized: "\u05D8\u05D9\u05E4: \u05DE\u05D2\u05DF \u05E1\u05D5\u05E4\u05D2 \u05D4\u05EA\u05E0\u05D2\u05E9\u05D5\u05EA \u05D0\u05D7\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 533786768
    m_Localized: "\u05D8\u05D9\u05E4: \u05DE\u05E2\u05D1\u05E8 \u05E0\u05EA\u05D9\u05D1 \u05D0\u05DC \u05D3\u05D5\u05E4\u05DF \u05E9\u05DC \u05DE\u05DB\u05E9\u05D5\u05DC \u05E8\u05E7 \u05D9\u05D4\u05D3\u05D5\u05E3 \u05D0\u05D5\u05EA\u05DA \u05D1\u05D7\u05D6\u05E8\u05D4."
    m_Metadata:
      m_Items: []
