    m_Localized: "\u05D8\u05D9\u05E4: \u05E7\u05E4\u05D9\u05E6\u05EA \u05E2\u05DC \u05DE\u05E2\u05DC\u05D4 \u05D0\u05D5\u05EA\u05DA \u05E2\u05DC \u05E7\u05E8\u05D5\u05E0\u05D5\u05EA \u05D2\u05DD \u05D1\u05DC\u05D9 \u05E8\u05DE\u05E4\u05D4."
