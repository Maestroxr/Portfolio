    m_Localized: "\u05D2\u05DC\u05D9\u05E9\u05D4 \u05DE\u05EA\u05D7\u05EA \u05DC\u05DE\u05D7\u05E1\u05D5\u05DE\u05D9\u05DD: \u05D7\u05E5 \u05DC\u05DE\u05D8\u05D4 \u05D0\u05D5 \u05D4\u05D7\u05DC\u05E7\u05D4 \u05DC\u05DE\u05D8\u05D4"
