  - m_Id: 533786753
    m_Localized: "\u05D0\u05E1\u05D9\u05DE\u05D5\u05E0\u05D9\u05DD   <b>{0}</b>\n\u05E0\u05D9\u05E7\u05D5\u05D3   <b>{1}</b>"
