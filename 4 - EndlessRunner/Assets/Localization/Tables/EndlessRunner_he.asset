  - m_Id: 533786725
    m_Localized: "\u05D4\u05D7\u05DC\u05D9\u05E7\u05D5 \u05DC\u05DE\u05D8\u05D4 \u05DB\u05D3\u05D9 \u05DC\u05D2\u05DC\u05D5\u05E9 \u05DE\u05EA\u05D7\u05EA \u05DC\u05E4\u05D9\u05D2\u05D5\u05DE\u05D9\u05DD"
