    m_Metadata:
      m_Items: []
  - m_Id: 525398334
    m_Localized: "\u05DB\u05D5\u05DC\u05DD \u05DC\u05D0\u05D5\u05D8\u05D5\u05D1\u05D5\u05E1!"
    m_Metadata:
      m_Items: []
  - m_Id: 525398335
    m_Localized: "\u05DE\u05EA\u05E7\u05D3\u05DE\u05D9\u05DD \u05DC\u05E4\u05D9 \u05D0\u05D7\u05EA \u05D4\u05E7\u05D5\u05D1\u05D9\u05D5\u05EA, \u05D0\u05D5 \u05DC\u05E4\u05D9 \u05E9\u05EA\u05D9\u05D4\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 525398336
    m_Localized: "\u05D8\u05E8\u05D9\u05E4\u05DC!"
    m_Metadata:
      m_Items: []
