    m_Localized: "\u05DC\u05D7\u05D9\u05E6\u05D4 \u05E2\u05DC \u05DE\u05E9\u05D1\u05E6\u05EA \u05DE\u05E2\u05D1\u05D9\u05E8\u05D4 \u05D0\u05DC\u05D9\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 525398338
    m_Localized: "\u05E0\u05D2\u05D9\u05E2\u05D4 \u05D1\u05DE\u05E9\u05D1\u05E6\u05EA \u05DE\u05E2\u05D1\u05D9\u05E8\u05D4 \u05D0\u05DC\u05D9\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 525398339
    m_Localized: "\u05D4\u05D1\u05D7\u05D9\u05E8\u05D4 \u05D4\u05D8\u05D5\u05D1\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 525398340
    m_Localized: "\u05DC\u05D8\u05D5\u05D1\u05EA {0}. \u05D9\u05E9 \u05DC\u05D2\u05D9\u05D9\u05E1 {1} \u05D1\u05DE\u05DB\u05D9\u05E8\u05EA \u05DE\u05D1\u05E0\u05D9\u05DD \u05D0\u05D5 \u05D1\u05DE\u05E9\u05DB\u05E0\u05EA\u05D0, \u05D0\u05D5 \u05DC\u05D5\u05D5\u05EA\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 525398341
    m_Localized: "\u05E4\u05E9\u05D9\u05D8\u05EA \u05E8\u05D2\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 525398342
    m_Localized: "\u05D1\u05DB\u05DC\u05D0! \u05D0\u05E4\u05E9\u05E8 \u05DC\u05D1\u05E0\u05D5\u05EA \u05D0\u05D5 \u05DC\u05E1\u05D7\u05D5\u05E8, \u05D5\u05D0\u05D6 \u05DC\u05E1\u05D9\u05D9\u05DD \u05D0\u05EA \u05D4\u05EA\u05D5\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 525398343
    m_Localized: "\u05D0\u05D9\u05DF \u05D3\u05D0\u05D1\u05DC. \u05E0\u05E9\u05D0\u05E8\u05D9\u05DD \u05D1\u05DB\u05DC\u05D0 \u05D1\u05D9\u05E0\u05EA\u05D9\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 525398344
    m_Localized: "\u05D0\u05E4\u05E9\u05E8 \u05DC\u05D1\u05E0\u05D5\u05EA, \u05DC\u05E1\u05D7\u05D5\u05E8 \u05D0\u05D5 \u05DC\u05E1\u05D9\u05D9\u05DD \u05D0\u05EA \u05D4\u05EA\u05D5\u05E8."
