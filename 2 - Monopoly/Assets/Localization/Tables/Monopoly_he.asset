  m_TableData:
  - m_Id: 466677760
    m_Localized: "\u05DE\u05D5\u05E0\u05D5\u05E4\u05D5\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 521203712
    m_Localized: "\u05DE\u05D8\u05D9\u05DC\u05D9\u05DD, \u05E7\u05D5\u05E0\u05D9\u05DD, \u05D1\u05D5\u05E0\u05D9\u05DD \u05D5\u05E1\u05D5\u05D7\u05E8\u05D9\u05DD \u05DE\u05E1\u05D1\u05D9\u05D1 \u05DC\u05E2\u05D5\u05DC\u05DD. \u05E2\u05D3 \u05D0\u05E8\u05D1\u05E2\u05D4 \u05E9\u05D7\u05E7\u05E0\u05D9\u05DD \u05E2\u05DC \u05DE\u05E1\u05DA \u05D0\u05D7\u05D3, \u05D9\u05E8\u05D9\u05D1\u05D9 \u05DE\u05D7\u05E9\u05D1 \u05D1\u05E9\u05DC\u05D5\u05E9 \u05E8\u05DE\u05D5\u05EA \u05D5\u05E9\u05E9 \u05D3\u05E8\u05DB\u05D9\u05DD \u05DC\u05E9\u05D7\u05E7."
    m_Metadata:
      m_Items: []
  - m_Id: 525398016
    m_Localized: "\u05E7\u05DC\u05D0\u05E1\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 525398017
    m_Localized: "\u05DE\u05D4\u05D3\u05D5\u05E8\u05EA \u05DE\u05E1\u05E2 \u05DE\u05E1\u05D1\u05D9\u05D1 \u05DC\u05E2\u05D5\u05DC\u05DD: \u05DC\u05D5\u05D7 \u05D1\u05E6\u05D1\u05E2 \u05DE\u05E0\u05D8\u05D4 \u05E2\u05DC \u05E9\u05D5\u05DC\u05D7\u05DF \u05E2\u05E5, \u05DB\u05DC\u05D9\u05DD \u05DE\u05D1\u05D3\u05D9\u05DC \u05D5\u05E9\u05D8\u05E8\u05D9 \u05D1\u05E2\u05DC\u05D5\u05EA \u05DC\u05D1\u05E0\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 525398018
    m_Localized: "\u05E1\u05D7\u05E8 \u05D2\u05DC\u05E7\u05D8\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 525398019
    m_Localized: "\u05E8\u05E6\u05E4\u05EA \u05DE\u05E1\u05D7\u05E8 \u05D1\u05EA\u05D7\u05E0\u05EA \u05D7\u05DC\u05DC: \u05DC\u05D5\u05D7 \u05DB\u05D4\u05D4 \u05E2\u05DD \u05E0\u05EA\u05D9\u05D1\u05D9\u05DD \u05D6\u05D5\u05D4\u05E8\u05D9\u05DD, \u05E7\u05DC\u05E4\u05D9\u05DD \u05D4\u05D5\u05DC\u05D5\u05D2\u05E8\u05E4\u05D9\u05D9\u05DD, \u05DB\u05DC\u05D9\u05DD \u05D1\u05E6\u05D5\u05E8\u05EA \u05D7\u05DC\u05DC\u05D9\u05D5\u05EA, \u05DB\u05D9\u05E4\u05D5\u05EA \u05D5\u05DE\u05D2\u05D3\u05DC\u05D9\u05DD \u05E2\u05DD \u05D7\u05DC\u05D5\u05E0\u05D5\u05EA \u05DE\u05D5\u05D0\u05E8\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 525398020
    m_Localized: "\u05DE\u05D4\u05D3\u05D5\u05E8\u05EA \u05DE\u05E1\u05E2 \u05DE\u05E1\u05D1\u05D9\u05D1 \u05DC\u05E2\u05D5\u05DC\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 525398021
    m_Localized: "\u05DE\u05D4\u05D3\u05D5\u05E8\u05EA \u05E1\u05D7\u05E8 \u05D2\u05DC\u05E7\u05D8\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 525398022
    m_Localized: "\u05E7\u05D5\u05D1\u05D9\u05D9\u05EA \u05DE\u05D4\u05D9\u05E8\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 525398023
    m_Localized: "\u05DE\u05E9\u05D7\u05E7 \u05DE\u05D4\u05D9\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 525398024
    m_Localized: "\u05D7\u05D5\u05E7\u05D9 \u05D4\u05D1\u05D9\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 525398025
    m_Localized: "\u05DE\u05E8\u05D5\u05E5 \u05D4\u05D8\u05D9\u05D9\u05E7\u05D5\u05E0\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 525398026
    m_Localized: "\u05D7\u05D5\u05E7\u05D9\u05DD \u05DE\u05E9\u05DC\u05DA"
    m_Metadata:
      m_Items: []
  - m_Id: 525398027
    m_Localized: "\u05D4\u05DE\u05E9\u05D7\u05E7 \u05D4\u05DE\u05DC\u05D0. \u05DC\u05E7\u05E0\u05D5\u05EA, \u05DC\u05D1\u05E0\u05D5\u05EA, \u05DC\u05E4\u05E9\u05D5\u05D8 \u05D0\u05EA \u05DB\u05D5\u05DC\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 525398028
    m_Localized: "\u05D4\u05E7\u05D5\u05D1\u05D9\u05D9\u05D4 \u05D4\u05D0\u05D3\u05D5\u05DE\u05D4 \u05E9\u05DC \u05DE\u05D4\u05D3\u05D5\u05E8\u05EA \u05D4\u05DE\u05D2\u05D4: \u05D0\u05D5\u05D8\u05D5\u05D1\u05D5\u05E1 \u05D5\u05DE\u05E8 \u05DE\u05D5\u05E0\u05D5\u05E4\u05D5\u05DC."
    m_Metadata:
      m_Items: []
  - m_Id: 525398029
    m_Localized: "\u05D4\u05DE\u05E9\u05D7\u05E7 \u05D4\u05E7\u05E6\u05E8: \u05E9\u05E0\u05D9 \u05E9\u05D8\u05E8\u05D5\u05EA \u05DC\u05DB\u05DC \u05D0\u05D7\u05D3, \u05DE\u05DC\u05D5\u05DF \u05D0\u05D7\u05E8\u05D9 \u05E9\u05DC\u05D5\u05E9\u05D4 \u05D1\u05EA\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 525398030
    m_Localized: "\u05E7\u05D5\u05E4\u05EA \u05D7\u05E0\u05D9\u05D4 \u05D7\u05D5\u05E4\u05E9\u05D9\u05EA, \u05D4\u05EA\u05D7\u05DC\u05D4 \u05DB\u05E4\u05D5\u05DC\u05D4, \u05E7\u05DC\u05E4\u05D9 \u05DE\u05E1\u05D9\u05D1\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 525398031
    m_Localized: "20 \u05E1\u05D9\u05D1\u05D5\u05D1\u05D9\u05DD, \u05E7\u05D5\u05D1\u05D9\u05D9\u05EA \u05DE\u05D4\u05D9\u05E8\u05D5\u05EA, $2,000 \u05D1\u05D4\u05EA\u05D7\u05DC\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 525398032
    m_Localized: "\u05D4\u05E9\u05D9\u05DC\u05D5\u05D1 \u05E9\u05DC\u05DA, \u05DE\u05D5\u05D2\u05D3\u05E8 \u05D1\u05D7\u05D5\u05E7\u05D9 \u05D4\u05D1\u05D9\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 525398033
    m_Localized: "\u05D4\u05D7\u05D5\u05E7\u05D9\u05DD \u05D4\u05E8\u05E9\u05DE\u05D9\u05D9\u05DD. \u05E7\u05D5\u05E0\u05D9\u05DD \u05D0\u05EA \u05DE\u05D4 \u05E9\u05E0\u05D5\u05D7\u05EA\u05D9\u05DD \u05E2\u05DC\u05D9\u05D5, \u05D0\u05D5 \u05E9\u05D4\u05D5\u05D0 \u05D9\u05D5\u05E6\u05D0 \u05DC\u05DE\u05DB\u05D9\u05E8\u05D4 \u05E4\u05D5\u05DE\u05D1\u05D9\u05EA. \u05D2\u05D5\u05D1\u05D9\u05DD \u05E9\u05DB\u05D9\u05E8\u05D5\u05EA, \u05DB\u05E4\u05D5\u05DC\u05D4 \u05E2\u05DC \u05E1\u05D3\u05E8\u05EA \u05E6\u05D1\u05E2 \u05DE\u05DC\u05D0\u05D4, \u05D5\u05D1\u05D5\u05E0\u05D9\u05DD \u05D1\u05D0\u05D5\u05E4\u05DF \u05E9\u05D5\u05D5\u05D4: \u05D1\u05D1\u05E0\u05E7 \u05D9\u05E9 32 \u05D1\u05EA\u05D9\u05DD \u05D5\u05BE12 \u05DE\u05DC\u05D5\u05E0\u05D5\u05EA. \u05DE\u05DE\u05E9\u05DB\u05E0\u05D9\u05DD \u05DB\u05D3\u05D9 \u05DC\u05D2\u05D9\u05D9\u05E1 \u05DB\u05E1\u05E3 \u05D5\u05E1\u05D5\u05D7\u05E8\u05D9\u05DD \u05DB\u05D3\u05D9 \u05DC\u05D4\u05E9\u05DC\u05D9\u05DD \u05E1\u05D3\u05E8\u05D5\u05EA. \u05D3\u05D0\u05D1\u05DC \u05DE\u05D6\u05DB\u05D4 \u05D1\u05D4\u05D8\u05DC\u05D4 \u05E0\u05D5\u05E1\u05E4\u05EA, \u05E9\u05DC\u05D5\u05E9\u05D4 \u05D3\u05D0\u05D1\u05DC\u05D9\u05DD \u05E9\u05D5\u05DC\u05D7\u05D9\u05DD \u05DC\u05DB\u05DC\u05D0. \u05DE\u05D9 \u05E9\u05E0\u05E9\u05D0\u05E8 \u05D0\u05D7\u05E8\u05D5\u05DF \u05DE\u05E0\u05E6\u05D7."
    m_Metadata:
      m_Items: []
  - m_Id: 525398034
    m_Localized: "\u05D0\u05D7\u05E8\u05D9 \u05D4\u05DE\u05E2\u05D1\u05E8 \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF \u05D1\u05D4\u05EA\u05D7\u05DC\u05D4, \u05D2\u05DD \u05E7\u05D5\u05D1\u05D9\u05D9\u05EA \u05D4\u05DE\u05D4\u05D9\u05E8\u05D5\u05EA \u05D4\u05D0\u05D3\u05D5\u05DE\u05D4 \u05DE\u05D5\u05D8\u05DC\u05EA. 1 \u05E2\u05D3 3 \u05DE\u05EA\u05D5\u05D5\u05E1\u05E4\u05D9\u05DD \u05DC\u05E6\u05E2\u05D3\u05D9\u05DD. \u05DE\u05E8 \u05DE\u05D5\u05E0\u05D5\u05E4\u05D5\u05DC \u05DE\u05E7\u05D3\u05DD \u05D0\u05DC \u05D4\u05E0\u05DB\u05E1 \u05D4\u05E4\u05E0\u05D5\u05D9 \u05D4\u05D1\u05D0 (\u05D0\u05D5 \u05D0\u05DC \u05D4\u05E9\u05DB\u05D9\u05E8\u05D5\u05EA \u05D4\u05D1\u05D0\u05D4 \u05DC\u05EA\u05E9\u05DC\u05D5\u05DD). \u05D4\u05D0\u05D5\u05D8\u05D5\u05D1\u05D5\u05E1 \u05DE\u05D0\u05E4\u05E9\u05E8 \u05DC\u05D6\u05D5\u05D6 \u05DC\u05E4\u05D9 \u05E7\u05D5\u05D1\u05D9\u05D9\u05D4 \u05D0\u05D7\u05EA \u05D0\u05D5 \u05DC\u05E4\u05D9 \u05E9\u05EA\u05D9\u05D4\u05DF. \u05D8\u05E8\u05D9\u05E4\u05DC \u05DE\u05E2\u05D1\u05D9\u05E8 \u05DC\u05DB\u05DC \u05DE\u05E9\u05D1\u05E6\u05EA \u05E9\u05E8\u05D5\u05E6\u05D9\u05DD!"
    m_Metadata:
      m_Items: []
  - m_Id: 525398035
    m_Localized: "\u05D4\u05DE\u05E9\u05D7\u05E7 \u05D4\u05E7\u05E6\u05E8 \u05D4\u05E8\u05E9\u05DE\u05D9. \u05DB\u05DC \u05D0\u05D7\u05D3 \u05DE\u05E7\u05D1\u05DC \u05E9\u05E0\u05D9 \u05E9\u05D8\u05E8\u05D9 \u05D1\u05E2\u05DC\u05D5\u05EA (\u05D5\u05DE\u05E9\u05DC\u05DD \u05E2\u05DC\u05D9\u05D4\u05DD), \u05DE\u05DC\u05D5\u05DF \u05D3\u05D5\u05E8\u05E9 \u05E8\u05E7 \u05E9\u05DC\u05D5\u05E9\u05D4 \u05D1\u05EA\u05D9\u05DD, \u05D5\u05D4\u05DE\u05E9\u05D7\u05E7 \u05E0\u05D2\u05DE\u05E8 \u05D1\u05E4\u05E9\u05D9\u05D8\u05EA \u05D4\u05E8\u05D2\u05DC \u05D4\u05E9\u05E0\u05D9\u05D9\u05D4. \u05D0\u05D6 \u05DE\u05E0\u05E6\u05D7 \u05D4\u05E2\u05E9\u05D9\u05E8 \u05D1\u05D9\u05D5\u05EA\u05E8, \u05DB\u05D5\u05DC\u05DC \u05DE\u05D6\u05D5\u05DE\u05E0\u05D9\u05DD, \u05E0\u05DB\u05E1\u05D9\u05DD \u05D5\u05DE\u05D1\u05E0\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 525398036
    m_Localized: "\u05D4\u05D0\u05D4\u05D5\u05D1\u05D9\u05DD \u05E9\u05DC \u05D4\u05E9\u05D5\u05DC\u05D7\u05DF. \u05DE\u05E1\u05D9\u05DD \u05D5\u05E7\u05E0\u05E1\u05D5\u05EA \u05E0\u05DB\u05E0\u05E1\u05D9\u05DD \u05DC\u05E7\u05D5\u05E4\u05EA \u05D4\u05D7\u05E0\u05D9\u05D4 \u05D4\u05D7\u05D5\u05E4\u05E9\u05D9\u05EA, \u05E0\u05D7\u05D9\u05EA\u05D4 \u05D1\u05D3\u05D9\u05D5\u05E7 \u05E2\u05DC \u05D4\u05EA\u05D7\u05DC\u05D4 \u05DE\u05E9\u05DC\u05DE\u05EA \u05DB\u05E4\u05D5\u05DC, \u05E7\u05DC\u05E4\u05D9 \u05DE\u05E1\u05D9\u05D1\u05D4 (\u05E8\u05D5\u05D1\u05D9\u05DF \u05D4\u05D5\u05D3, \u05D1\u05EA\u05D9\u05DD \u05D1\u05D7\u05D9\u05E0\u05DD, \u05E0\u05E9\u05E3 \u05E6\u05D3\u05E7\u05D4) \u05DE\u05E6\u05D8\u05E8\u05E4\u05D9\u05DD \u05DC\u05D7\u05E4\u05D9\u05E1\u05D5\u05EA, \u05D5\u05D0\u05D9\u05DF \u05DE\u05DB\u05D9\u05E8\u05D5\u05EA \u05E4\u05D5\u05DE\u05D1\u05D9\u05D5\u05EA: \u05DE\u05D4 \u05E9\u05D0\u05E3 \u05D0\u05D7\u05D3 \u05DC\u05D0 \u05E7\u05D5\u05E0\u05D4 \u05E0\u05E9\u05D0\u05E8 \u05D1\u05D1\u05E0\u05E7."
    m_Metadata:
      m_Items: []
  - m_Id: 525398037
    m_Localized: "\u05DE\u05E8\u05D5\u05E5 \u05E0\u05D2\u05D3 \u05D4\u05E9\u05E2\u05D5\u05DF: \u05E2\u05E9\u05E8\u05D9\u05DD \u05E1\u05D9\u05D1\u05D5\u05D1\u05D9\u05DD \u05E2\u05DD \u05E7\u05D5\u05D1\u05D9\u05D9\u05EA \u05D4\u05DE\u05D4\u05D9\u05E8\u05D5\u05EA \u05D5\u05BE$2,000 \u05DC\u05DB\u05DC \u05D0\u05D7\u05D3 \u05D1\u05D4\u05EA\u05D7\u05DC\u05D4. \u05DB\u05E9\u05D4\u05D6\u05DE\u05DF \u05E0\u05D2\u05DE\u05E8 \u05DE\u05E0\u05E6\u05D7 \u05D1\u05E2\u05DC \u05D4\u05E9\u05D5\u05D5\u05D9 \u05D4\u05D2\u05D1\u05D5\u05D4 \u05D1\u05D9\u05D5\u05EA\u05E8, \u05D0\u05D6 \u05DB\u05D3\u05D0\u05D9 \u05DC\u05E7\u05E0\u05D5\u05EA \u05DE\u05D5\u05E7\u05D3\u05DD \u05D5\u05DC\u05D1\u05E0\u05D5\u05EA \u05DE\u05D4\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 525398038
    m_Localized: "\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05DC\u05E4\u05D9 \u05D4\u05D7\u05D5\u05E7\u05D9\u05DD \u05E9\u05DC\u05DB\u05DD: \u05DE\u05E4\u05E2\u05D9\u05DC\u05D9\u05DD \u05D7\u05D5\u05E7\u05D9\u05DD \u05DE\u05E9\u05DC\u05DB\u05DD \u05D1\u05D7\u05D5\u05E7\u05D9 \u05D4\u05D1\u05D9\u05EA \u05E9\u05D1\u05EA\u05E4\u05E8\u05D9\u05D8 \u05D4\u05E8\u05D0\u05E9\u05D9 \u05D5\u05D1\u05D5\u05D7\u05E8\u05D9\u05DD \u05E1\u05DB\u05D5\u05DD \u05E4\u05EA\u05D9\u05D7\u05D4, \u05DE\u05D2\u05D1\u05DC\u05EA \u05E1\u05D9\u05D1\u05D5\u05D1\u05D9\u05DD, \u05E9\u05D8\u05E8\u05D5\u05EA \u05DE\u05D7\u05D5\u05DC\u05E7\u05D9\u05DD, \u05DE\u05DB\u05D9\u05E8\u05D5\u05EA \u05E4\u05D5\u05DE\u05D1\u05D9\u05D5\u05EA, \u05E7\u05D5\u05D1\u05D9\u05D9\u05EA \u05DE\u05D4\u05D9\u05E8\u05D5\u05EA, \u05E7\u05D5\u05E4\u05D4, \u05D4\u05EA\u05D7\u05DC\u05D4 \u05DB\u05E4\u05D5\u05DC\u05D4, \u05D1\u05DC\u05D9 \u05E9\u05DB\u05D9\u05E8\u05D5\u05EA \u05DE\u05D4\u05DB\u05DC\u05D0 \u05D5\u05E7\u05DC\u05E4\u05D9 \u05DE\u05E1\u05D9\u05D1\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 525398039
    m_Localized: "\u05DB\u05D5\u05DB\u05D1 1: \u05DC\u05E0\u05E6\u05D7 \u05D0\u05EA \u05D4\u05DE\u05D7\u05E9\u05D1.  2 \u05DB\u05D5\u05DB\u05D1\u05D9\u05DD: \u05DC\u05E0\u05E6\u05D7 \u05E9\u05DC\u05D5\u05E9\u05D4 \u05E9\u05D7\u05E7\u05E0\u05D9 \u05DE\u05D7\u05E9\u05D1.  3 \u05DB\u05D5\u05DB\u05D1\u05D9\u05DD: \u05DC\u05E0\u05E6\u05D7 \u05E9\u05DC\u05D5\u05E9\u05D4 \u05E7\u05E9\u05D9\u05DD."
