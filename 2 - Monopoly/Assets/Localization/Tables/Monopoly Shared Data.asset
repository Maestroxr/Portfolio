  - m_Id: 525398161
    m_Key: Tax refund. Collect $20.
    m_Metadata:
      m_Items: []
  - m_Id: 525398162
    m_Key: It is your birthday! Collect $10 from every player.
    m_Metadata:
      m_Items: []
  - m_Id: 525398163
    m_Key: Your life insurance matures. Collect $100.
    m_Metadata:
      m_Items: []
  - m_Id: 525398164
