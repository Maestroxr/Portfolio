      m_Items: []
  - m_Id: 3398496258
    m_Localized: "\u05D6\u05DE\u05DF \u05DC\u05DE\u05D4\u05DC\u05DA"
    m_Metadata:
      m_Items: []
  - m_Id: 3398496259
    m_Localized: "30 \u05E9\u05E0\u05D9\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 3398496260
    m_Localized: "2 \u05D3\u05E7\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 3398496261
    m_Localized: "5 \u05D3\u05E7\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 3398496262
    m_Localized: "\u05D9\u05E8\u05D9\u05D1 \u05DE\u05DE\u05D5\u05D7\u05E9\u05D1"
    m_Metadata:
      m_Items: []
  - m_Id: 3398496263
    m_Localized: "\u05E8\u05DE\u05EA \u05D4\u05DE\u05D7\u05E9\u05D1"
    m_Metadata:
      m_Items: []
  - m_Id: 3398496264
    m_Localized: "{0}, \u05D9\u05E8\u05D9\u05D1 \u05DE\u05DE\u05D5\u05D7\u05E9\u05D1"
    m_Metadata:
      m_Items: []
  - m_Id: 3398496265
    m_Localized: "{0} \u05E2\u05D6\u05D1 \u05D0\u05EA \u05D4\u05E9\u05D5\u05DC\u05D7\u05DF. \u05D4\u05DE\u05D7\u05E9\u05D1 \u05DE\u05DE\u05E9\u05D9\u05DA \u05DC\u05E9\u05D7\u05E7."
    m_Metadata:
      m_Items: []
  - m_Id: 3398496266
    m_Localized: "\u05D0\u05D9 \u05D0\u05E4\u05E9\u05E8 \u05DC\u05D4\u05EA\u05D7\u05D9\u05DC: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 3398496267
    m_Localized: "\u05D4\u05E9\u05D5\u05DC\u05D7\u05DF \u05E9\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7 \u05D1\u05E8\u05E9\u05EA \u05DC\u05D0 \u05D4\u05D2\u05D9\u05E2."
    m_Metadata:
      m_Items: []
  - m_Id: 3398496268
    m_Localized: "\u05D0\u05D9 \u05D0\u05E4\u05E9\u05E8 \u05DC\u05D8\u05E2\u05D5\u05DF \u05DE\u05E9\u05D7\u05E7 \u05E9\u05DE\u05D5\u05E8 \u05D1\u05DE\u05D4\u05DC\u05DA \u05DE\u05E9\u05D7\u05E7 \u05D1\u05E8\u05E9\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 3398496269
    m_Localized: "\u05D4\u05DE\u05E9\u05D7\u05E7 \u05E0\u05E9\u05DE\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 3398496270
    m_Localized: "\u05D1\u05E8\u05D5\u05DB\u05D9\u05DD \u05D4\u05E9\u05D1\u05D9\u05DD! \u05D4\u05DE\u05E9\u05D7\u05E7 \u05DE\u05DE\u05E9\u05D9\u05DA."
    m_Metadata:
      m_Items: []
  - m_Id: 3398496271
    m_Localized: "\u05D4\u05DE\u05E9\u05D7\u05E7 \u05D4\u05E9\u05DE\u05D5\u05E8 \u05D0\u05D9\u05E0\u05D5 \u05E9\u05DC\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 3398496272
    m_Localized: "\u05D4\u05DE\u05E9\u05D7\u05E7 \u05D4\u05E9\u05DE\u05D5\u05E8 \u05DB\u05D1\u05E8 \u05D4\u05E1\u05EA\u05D9\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 3398496273
    m_Localized: "\u05DC\u05D0 \u05E0\u05D9\u05EA\u05DF \u05D4\u05D9\u05D4 \u05DC\u05D4\u05EA\u05D7\u05D9\u05DC \u05D0\u05EA \u05D4\u05DE\u05E9\u05D7\u05E7 \u05D4\u05E9\u05DE\u05D5\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 3398496274
    m_Localized: "{0}, \u05DE\u05D4\u05DC\u05DA {1}: {2} \u05E0\u05D2\u05D3 {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 3398496275
    m_Localized: "\u05DE\u05D4\u05DC\u05DB\u05D9\u05DD \u05E8\u05D0\u05E9\u05D5\u05E0\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 3398496276
    m_Localized: "\u05DE\u05E9\u05D7\u05E7 \u05D0\u05E0\u05D2\u05DC\u05D9 \u05E7\u05DC \u05DC\u05DC\u05D9\u05DE\u05D5\u05D3 \u05D4\u05DE\u05D4\u05DC\u05DB\u05D9\u05DD. \u05D0\u05EA\u05DD \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D1\u05DB\u05D4\u05D4 \u05D5\u05E4\u05D5\u05EA\u05D7\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 3398496277
    m_Localized: "\u05EA\u05D4\u05D9\u05DC\u05EA \u05D4\u05DB\u05EA\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 3398496278
    m_Localized: "\u05D7\u05D5\u05E7\u05D9\u05DD \u05D0\u05E0\u05D2\u05DC\u05D9\u05D9\u05DD \u05E0\u05D2\u05D3 \u05D9\u05E8\u05D9\u05D1 \u05E9\u05E7\u05D5\u05DC. \u05D4\u05D2\u05D9\u05E2\u05D5 \u05DC\u05E9\u05D5\u05E8\u05D4 \u05D4\u05E8\u05D7\u05D5\u05E7\u05D4 \u05DB\u05D3\u05D9 \u05DC\u05D4\u05DB\u05EA\u05D9\u05E8 \u05DE\u05DC\u05DA."
    m_Metadata:
      m_Items: []
  - m_Id: 3398496279
    m_Localized: "\u05DE\u05DC\u05DB\u05D9\u05DD \u05DE\u05E2\u05D5\u05E4\u05E4\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 3398496280
    m_Localized: "\u05D7\u05D5\u05E7\u05D9\u05DD \u05E8\u05D5\u05E1\u05D9\u05D9\u05DD: \u05D7\u05D9\u05D9\u05DC\u05D9\u05DD \u05D0\u05D5\u05DB\u05DC\u05D9\u05DD \u05D0\u05D7\u05D5\u05E8\u05D4 \u05D5\u05DE\u05DC\u05DB\u05D9\u05DD \u05DE\u05E2\u05D5\u05E4\u05E4\u05D9\u05DD \u05E2\u05DC \u05E4\u05E0\u05D9 \u05D4\u05DC\u05D5\u05D7."
    m_Metadata:
      m_Items: []
  - m_Id: 3398496281
    m_Localized: "\u05D4\u05DC\u05D5\u05D7 \u05D4\u05E8\u05D7\u05D1"
    m_Metadata:
      m_Items: []
  - m_Id: 3398496282
    m_Localized: "\u05E2\u05E9\u05E8 \u05E2\u05DC \u05E2\u05E9\u05E8 \u05D5\u05E2\u05E9\u05E8\u05D9\u05DD \u05D7\u05D9\u05D9\u05DC\u05D9\u05DD \u05DC\u05DB\u05DC \u05E6\u05D3. \u05D7\u05D5\u05D1\u05D4 \u05DC\u05D1\u05D7\u05D5\u05E8 \u05D1\u05E8\u05E6\u05E3 \u05E9\u05D0\u05D5\u05DB\u05DC \u05D4\u05DB\u05D9 \u05D4\u05E8\u05D1\u05D4 \u05DB\u05DC\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 3398496283
    m_Localized: "\u05E9\u05D5\u05DC\u05D7\u05DF \u05D4\u05E8\u05D1-\u05D0\u05DE\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 3398496284
    m_Localized: "\u05D7\u05D5\u05E7\u05D9\u05DD \u05D0\u05E0\u05D2\u05DC\u05D9\u05D9\u05DD \u05E0\u05D2\u05D3 \u05D9\u05E8\u05D9\u05D1 \u05E7\u05E9\u05D4 \u05E9\u05E8\u05D5\u05D0\u05D4 \u05E8\u05D7\u05D5\u05E7 \u05E7\u05D3\u05D9\u05DE\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 3398496285
    m_Localized: "\u05D0\u05DC\u05D9\u05E4\u05D5\u05EA \u05D4\u05E2\u05D5\u05DC\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 3398496286
    m_Localized: "\u05D4\u05DC\u05D5\u05D7 \u05D4\u05E8\u05D7\u05D1 \u05E0\u05D2\u05D3 \u05D4\u05D9\u05E8\u05D9\u05D1 \u05D4\u05D7\u05D6\u05E7 \u05D1\u05D9\u05D5\u05EA\u05E8. \u05E9\u05DE\u05E8\u05D5 \u05E2\u05DC \u05D4\u05DB\u05DC\u05D9\u05DD \u05E9\u05DC\u05DB\u05DD \u05D5\u05E1\u05D9\u05D9\u05DE\u05D5 \u05DE\u05D4\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 3398496287
    m_Localized: "{0}, \u05DE\u05D7\u05E9\u05D1 {1}, \u05D0\u05EA\u05DD \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 3398496288
    m_Localized: "\u05E0\u05E2\u05D5\u05DC"
    m_Metadata:
