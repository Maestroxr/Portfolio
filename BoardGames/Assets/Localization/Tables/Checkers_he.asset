  m_TableData:
  - m_Id: 3322998784
    m_Localized: "\u05D3\u05DE\u05E7\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 3390107648
    m_Localized: "\u05D3\u05DE\u05E7\u05D4 \u05DC\u05E9\u05E0\u05D9\u05D9\u05DD: \u05D7\u05D5\u05E7\u05D9\u05DD \u05D0\u05E0\u05D2\u05DC\u05D9\u05D9\u05DD, \u05E8\u05D5\u05E1\u05D9\u05D9\u05DD \u05D0\u05D5 \u05D1\u05D9\u05E0\u05DC\u05D0\u05D5\u05DE\u05D9\u05D9\u05DD, \u05E0\u05D2\u05D3 \u05D4\u05DE\u05D7\u05E9\u05D1, \u05D1\u05DE\u05DB\u05E9\u05D9\u05E8 \u05D0\u05D7\u05D3 \u05D0\u05D5 \u05D1\u05E8\u05E9\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 3394301952
    m_Localized: "\u05E7\u05DC\u05D0\u05E1\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 3394301953
    m_Localized: "\u05DC\u05D5\u05D7 \u05E2\u05E5 \u05D7\u05DE\u05D9\u05DD \u05E2\u05DC \u05DC\u05D1\u05D3 \u05D9\u05E8\u05D5\u05E7, \u05E9\u05E0\u05D4\u05D1 \u05DE\u05D5\u05DC \u05D4\u05D5\u05D1\u05E0\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 3394301954
    m_Localized: "\u05D7\u05E6\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 3394301955
    m_Localized: "\u05DC\u05D5\u05D7 \u05D6\u05DB\u05D5\u05DB\u05D9\u05EA \u05E6\u05E4\u05D7\u05D4 \u05EA\u05D7\u05EA \u05DC\u05D9\u05DC \u05DB\u05D7\u05D5\u05DC \u05E2\u05DE\u05D5\u05E7, \u05E0\u05D9\u05D0\u05D5\u05DF \u05EA\u05DB\u05DC\u05EA \u05DE\u05D5\u05DC \u05DE\u05D2'\u05E0\u05D8\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 3394301956
    m_Localized: "\u05D3\u05DE\u05E7\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 3394301957
    m_Localized: "\u05D1\u05D4\u05D9\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 3394301958
    m_Localized: "\u05DB\u05D4\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 3394301959
    m_Localized: "\u05D0\u05E0\u05D2\u05DC\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 3394301960
    m_Localized: "\u05E8\u05D5\u05E1\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 3394301961
    m_Localized: "\u05D1\u05D9\u05E0\u05DC\u05D0\u05D5\u05DE\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 3394301962
    m_Localized: "\u05D7\u05D9\u05D9\u05DC\u05D9\u05DD \u05D0\u05D5\u05DB\u05DC\u05D9\u05DD \u05E7\u05D3\u05D9\u05DE\u05D4 \u05D1\u05DC\u05D1\u05D3, \u05DE\u05DC\u05DB\u05D9\u05DD \u05D6\u05D6\u05D9\u05DD \u05E6\u05E2\u05D3 \u05D0\u05D7\u05D3; \u05D7\u05D9\u05D9\u05DC \u05E9\u05D4\u05D5\u05DB\u05EA\u05E8 \u05E2\u05D5\u05E6\u05E8 \u05E9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 3394301963
    m_Localized: "\u05D7\u05D9\u05D9\u05DC\u05D9\u05DD \u05D0\u05D5\u05DB\u05DC\u05D9\u05DD \u05D2\u05DD \u05D0\u05D7\u05D5\u05E8\u05D4, \u05DE\u05DC\u05DB\u05D9\u05DD \u05DE\u05E2\u05D5\u05E4\u05E4\u05D9\u05DD; \u05D7\u05D9\u05D9\u05DC \u05E9\u05D4\u05D5\u05DB\u05EA\u05E8 \u05D1\u05D0\u05DE\u05E6\u05E2 \u05D0\u05DB\u05D9\u05DC\u05D4 \u05DE\u05DE\u05E9\u05D9\u05DA \u05DB\u05DE\u05DC\u05DA."
    m_Metadata:
      m_Items: []
  - m_Id: 3394301964
    m_Localized: "\u05E2\u05DC \u05DC\u05D5\u05D7 10x10: \u05DE\u05DC\u05DB\u05D9\u05DD \u05DE\u05E2\u05D5\u05E4\u05E4\u05D9\u05DD, \u05D5\u05D0\u05DB\u05D9\u05DC\u05D4 \u05D7\u05D9\u05D9\u05D1\u05EA \u05DC\u05E7\u05D7\u05EA \u05DB\u05DE\u05D4 \u05E9\u05D9\u05D5\u05EA\u05E8 \u05DB\u05DC\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 3394301965
    m_Localized: "\u05E7\u05DE\u05E4\u05D9\u05D9\u05DF"
    m_Metadata:
      m_Items: []
